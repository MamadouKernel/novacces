# Copier ce fichier en ".env" (jamais committé — déjà dans .gitignore) et
# renseigner les valeurs réelles avant de lancer :
#   docker compose up -d --build
#
# Rappel de sécurité : ce fichier ne doit JAMAIS être versionné ni partagé
# tel quel une fois rempli (voir docs/deploiement.md §4).

# ---- Domaine (sigasacces.com — acheté le 02/08/2026) ----
# Deux sous-domaines distincts pointant vers l'IP du VPS (enregistrements DNS
# de type A, à créer chez le registrar du domaine) : l'un pour le portail Web,
# l'autre pour l'API (terminaux agents).
DOMAIN=sigasacces.com
API_DOMAIN=api.sigasacces.com
# Doit être la version HTTPS de API_DOMAIN ci-dessus.
API_PUBLIC_BASE_URL=https://api.sigasacces.com

# ---- PostgreSQL ----
# Rôle applicatif unique (propriétaire + runtime) pour ce premier déploiement
# — fonctionnel et documenté comme tel (voir appsettings.json, section
# ConnectionStrings). Le cloisonnement renforcé à deux rôles
# (tools/provisionner-roles-postgres.sql + `dotnet NovAcces.Api.dll grant-app-role`)
# reste une amélioration possible ultérieure, pas un prérequis.
POSTGRES_USER=novacces
POSTGRES_PASSWORD=CHANGE_ME_génère_un_mot_de_passe_fort

# ---- Jeton de session (JWT) ----
# Chaîne aléatoire d'AU MOINS 32 caractères. Générer avec :
#   openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_32_caracteres_minimum

# ---- Signature des QR (ES256 / ECDSA P-256) ----
# Générer LA PAIRE UNE SEULE FOIS, avant le tout premier déploiement :
#   openssl ecparam -name prime256v1 -genkey -noout -out sigasacces-ec-private.pem
#   openssl ec -in sigasacces-ec-private.pem -pubout -out sigasacces-ec-public.pem
# Coller le CONTENU des fichiers .pem tel quel (guillemets doubles, valeur
# multi-lignes — pris en charge par le format .env de Docker Compose) :
QR_SIGNING_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----
COLLER_ICI_LE_CONTENU_DE_sigasacces-ec-private.pem
-----END EC PRIVATE KEY-----"
QR_SIGNING_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
COLLER_ICI_LE_CONTENU_DE_sigasacces-ec-public.pem
-----END PUBLIC KEY-----"
# Important : la clé PRIVÉE ne quitte jamais ce fichier .env sur le serveur.
# Seule la clé PUBLIQUE est distribuée aux terminaux agents (enrôlement).

# ---- Notifications push navigateur (PWA) ----
# Alerte de depassement (§7) meme onglet ferme. Generer UNE SEULE FOIS,
# jamais regenerer apres mise en service (invaliderait tous les abonnements
# deja enregistres) :
#   dotnet run --project src/NovAcces.Api -- generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@sigasacces.com

# ---- Email (Brevo — voir échange précédent) ----
# Paramètres SMTP & API → SMTP dans le tableau de bord Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_identifiant_smtp_brevo
SMTP_PASSWORD=CHANGE_ME_cle_smtp_brevo
SMTP_FROM_ADDRESS=notifications@sigasacces.com
SMTP_FROM_DISPLAY_NAME=SigasAcces — Contrôle des accès

# ---- Compte Admin initial ----
# Amorcé la première fois que `dotnet NovAcces.Api.dll migrate` est exécuté
# dans le conteneur api (voir commande ci-dessous). À changer dès la première
# connexion (mot de passe + activation du 2FA).
SEED_ADMIN_EMAIL=mamadou.konate@sigasacces.com
SEED_ADMIN_PASSWORD=CHANGE_ME_mot_de_passe_fort_temporaire
SEED_ADMIN_DISPLAY_NAME=KONATE Mamadou

# ---- Doc Swagger en production (désactivée par défaut) ----
# À mettre à "true" ponctuellement pour consulter/tester l'API depuis
# https://api.sigasacces.com/swagger, puis remettre à "false" ensuite
# (expose la liste de tous les endpoints tant que c'est actif).
API_ENABLE_SWAGGER=false

# ---- Mot de passe oublié (self-service, désactivée par défaut) ----
# À mettre à "true" une fois les identifiants SMTP (SMTP_USERNAME/PASSWORD
# ci-dessus) réellement renseignés — sinon la demande de réinitialisation
# répond normalement (anti-énumération) mais aucun email ne part.
PASSWORD_RESET_ENABLED=false
