<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovAcces.Mobile.Pages.EnrollmentPage"
             Title="Enrôlement du terminal"
             BackgroundColor="#0E2A3A">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="NovAccès — Enrôlement" TextColor="White"
                   FontSize="24" FontAttributes="Bold" />
            <Label Text="Renseignez les paramètres fournis pour ce terminal. Ils sont stockés de façon sécurisée sur l'appareil (jamais la clé privée)."
                   TextColor="#B8C7D2" FontSize="13" />

            <Label Text="URL de l'API" TextColor="White" FontSize="14" Margin="0,8,0,0" />
            <Entry x:Name="UrlEntry" Placeholder="ex. http://10.0.2.2:5099"
                   Keyboard="Url" BackgroundColor="White" TextColor="Black" />

            <Label Text="Clé API du terminal" TextColor="White" FontSize="14" />
            <Entry x:Name="ApiKeyEntry" Placeholder="X-Api-Key du terminal enrôlé"
                   BackgroundColor="White" TextColor="Black" />

            <Label Text="Clé publique ES256 (PEM)" TextColor="White" FontSize="14" />
            <Editor x:Name="PublicKeyEditor" AutoSize="TextChanges" HeightRequest="140"
                    Placeholder="-----BEGIN PUBLIC KEY-----&#10;...&#10;-----END PUBLIC KEY-----"
                    BackgroundColor="White" TextColor="Black" />

            <Button x:Name="EnrollButton" Text="Enrôler ce terminal"
                    Clicked="OnEnroll" BackgroundColor="#F5A300" TextColor="#0E2A3A"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="52" Margin="0,8,0,0" />

            <Label x:Name="StatusLabel" Text="" TextColor="#F5A300" FontSize="13"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
