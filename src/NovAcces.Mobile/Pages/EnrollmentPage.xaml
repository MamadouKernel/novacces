<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="NovAcces.Mobile.Pages.EnrollmentPage"
             Title="Enrôlement du terminal"
             BackgroundColor="{StaticResource BrandNavyDeep}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="SigasAcces — Enrôlement" TextColor="White"
                   FontSize="24" FontAttributes="Bold" />
            <Label Text="Scannez le QR temporaire fourni par l'administration. Aucune clé API n'est saisie sur le téléphone."
                   TextColor="{StaticResource BrandMuted}" FontSize="13" />

            <Border Stroke="{StaticResource BrandAmber}" StrokeThickness="2"
                    StrokeShape="RoundRectangle 16" Padding="0" Margin="0,8,0,0">
                <zxing:CameraBarcodeReaderView x:Name="Camera"
                                               HeightRequest="280"
                                               BarcodesDetected="OnBarcodesDetected" />
            </Border>

            <Label x:Name="ScanStatusLabel" Text="Présentez le QR d'enrôlement devant la caméra."
                   TextColor="{StaticResource BrandAmber}" FontSize="14"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="ToggleManualModeButton" Text="Pas de caméra ? Saisir le code manuellement"
                    Clicked="OnToggleManualMode" BackgroundColor="Transparent"
                    TextColor="{StaticResource BrandMuted}" FontSize="12"
                    FontAttributes="Italic" Margin="0,-4,0,0" />

            <Border x:Name="ManualEntrySection" IsVisible="False"
                    BackgroundColor="#183B4D" Stroke="#34586A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mode manuel (sans caméra)" TextColor="White" FontAttributes="Bold" FontSize="15" />
                    <Label Text="URL de l'API" TextColor="{StaticResource BrandMuted}" FontSize="12" />
                    <Entry x:Name="ApiUrlEntry" TextColor="White" Keyboard="Url" />
                    <Label Text="Code fourni par l'administration" TextColor="{StaticResource BrandMuted}" FontSize="12" />
                    <Entry x:Name="ManualCodeEntry" TextColor="White" Placeholder="XXXX-XXXX" />
                    <Button Text="Valider le code" Clicked="OnManualCodeSubmit"
                            BackgroundColor="{StaticResource BrandAmber}" TextColor="{StaticResource BrandNavy}"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="46" />
                    <Label x:Name="ManualStatusLabel" Text="" TextColor="{StaticResource BrandAmber}" FontSize="12"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="TicketSummary" IsVisible="False"
                    BackgroundColor="#183B4D" Stroke="#34586A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="14">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Terminal détecté" TextColor="White" FontAttributes="Bold" FontSize="17" />
                    <Label x:Name="TerminalLabel" TextColor="White" FontSize="14" />
                    <Label x:Name="ExpirationLabel" TextColor="{StaticResource BrandMuted}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="EnrollButton" Text="Activer ce terminal"
                    IsEnabled="False" Clicked="OnEnroll"
                    BackgroundColor="{StaticResource BrandAmber}" TextColor="{StaticResource BrandNavy}"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="52" Margin="0,6,0,0" />

            <Label x:Name="StatusLabel" Text="" TextColor="{StaticResource BrandAmber}" FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>