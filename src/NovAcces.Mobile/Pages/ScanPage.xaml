<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="NovAcces.Mobile.Pages.ScanPage"
             Title="SigasAcces — Poste de contrôle"
             BackgroundColor="{StaticResource BrandNavyDeep}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Attendus" Clicked="OnOpenExpected" />
        <ToolbarItem Text="Fin de poste" Clicked="OnEndShift" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Caméra plein écran -->
        <zxing:CameraBarcodeReaderView x:Name="Camera"
                                       BarcodesDetected="OnBarcodesDetected" />

        <!-- Viseur de scan (centré, purement visuel) -->
        <Border InputTransparent="True" WidthRequest="240" HeightRequest="240"
                HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="Transparent" Stroke="{StaticResource BrandAmber}" StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>
        </Border>

        <!-- Bandeau supérieur : connectivité + code de secours + son + sens du poste -->
        <Grid VerticalOptions="Start" Padding="16,40,16,16" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Label x:Name="ConnectivityLabel" Text="● en ligne"
                   TextColor="White" FontSize="14" VerticalOptions="Center" />
            <Button x:Name="ManualCodeButton" Grid.Column="1" Text="🔑 Code"
                    Clicked="OnToggleManualCode" BackgroundColor="{StaticResource BrandSlate}"
                    TextColor="White" CornerRadius="8" Padding="10,0" />
            <Button x:Name="SoundButton" Grid.Column="2" Text="🔊"
                    Clicked="OnToggleSound" BackgroundColor="{StaticResource BrandSlate}"
                    TextColor="White" CornerRadius="8" Padding="10,0" WidthRequest="46" />
            <Button x:Name="DirectionButton" Grid.Column="3"
                    Text="Poste : entrée" Clicked="OnToggleDirection"
                    BackgroundColor="{StaticResource Tertiary}" TextColor="White" CornerRadius="8" />
        </Grid>

        <!-- Panneau de saisie du code de secours (alternative au QR) : masque
             la caméra pendant la saisie, comme le repli manuel de l'écran
             d'enrôlement (EnrollmentPage). Toujours en ligne (voir
             ScanViewModel.EvaluateManualCodeAsync). -->
        <Grid x:Name="ManualCodePanel" IsVisible="False" BackgroundColor="#CC101820">
            <Border BackgroundColor="{StaticResource BrandSlate}" Padding="24" WidthRequest="320"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Code de secours" TextColor="White" FontSize="20" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Le visiteur n'a pas pu présenter son QR : demandez-lui le code reçu par email."
                           TextColor="{StaticResource BrandMuted}" FontSize="13" HorizontalTextAlignment="Center" />
                    <Entry x:Name="ManualCodeEntryField" Placeholder="XXXX-XXXX" TextColor="White"
                           PlaceholderColor="{StaticResource BrandMuted}" HorizontalTextAlignment="Center"
                           FontSize="22" Keyboard="Chat" />
                    <Label x:Name="ManualCodePanelStatus" Text="" TextColor="{StaticResource BrandAmber}"
                           FontSize="13" HorizontalTextAlignment="Center" />
                    <Button x:Name="ManualCodeSubmitButton" Text="Valider" Clicked="OnManualCodeSubmit"
                            BackgroundColor="{StaticResource BrandAmber}" TextColor="{StaticResource BrandNavyDeep}"
                            FontAttributes="Bold" CornerRadius="8" />
                    <Button Text="Annuler" Clicked="OnToggleManualCode"
                            BackgroundColor="Transparent" TextColor="{StaticResource BrandMuted}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Pied : poste + compteur de scans du jour -->
        <Grid VerticalOptions="End" Padding="16,12,16,20" ColumnDefinitions="*,Auto"
              BackgroundColor="#B3101820">
            <Label x:Name="AgentLabel" Text="Poste de contrôle" TextColor="{StaticResource BrandMuted}"
                   FontSize="12" VerticalOptions="Center" />
            <Label x:Name="CountLabel" Grid.Column="1" Text="0 scan aujourd'hui"
                   TextColor="{StaticResource BrandMuted}" FontSize="12" VerticalOptions="Center" />
        </Grid>

        <!-- Overlay de verdict plein écran (masqué au repos) -->
        <Grid x:Name="VerdictOverlay" IsVisible="False" BackgroundColor="{StaticResource VerdictGreen}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="24">
                <Label x:Name="VerdictTitle" Text="" TextColor="White"
                       FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label x:Name="VerdictSubtitle" Text="" TextColor="White"
                       FontSize="18" HorizontalTextAlignment="Center" />
                <Label Text="Toucher pour continuer" TextColor="White" Opacity="0.8"
                       FontSize="14" HorizontalTextAlignment="Center" Margin="0,20,0,0" />
            </VerticalStackLayout>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissVerdict" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentPage>
