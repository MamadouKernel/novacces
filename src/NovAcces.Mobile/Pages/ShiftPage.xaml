<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NovAcces.Mobile.Pages.ShiftPage"
             Title="Prise de poste"
             BackgroundColor="{StaticResource BrandNavyDeep}">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" VerticalOptions="Center">

            <Label Text="Prise de poste" TextColor="White" FontSize="26" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Identifiez-vous pour ouvrir votre poste. Chaque scan sera tracé à votre matricule."
                   TextColor="{StaticResource BrandMuted}" FontSize="13" HorizontalTextAlignment="Center" />

            <Label Text="Matricule" TextColor="White" FontSize="14" Margin="0,10,0,0" />
            <Entry x:Name="MatriculeEntry" Placeholder="ex. SG-0417"
                   BackgroundColor="White" TextColor="Black" />

            <Label Text="Code PIN" TextColor="White" FontSize="14" />
            <Entry x:Name="PinEntry" Placeholder="••••" IsPassword="True" Keyboard="Numeric"
                   MaxLength="8" BackgroundColor="White" TextColor="Black" />

            <Button x:Name="StartButton" Text="Prendre le poste" Clicked="OnStartShift"
                    BackgroundColor="{StaticResource BrandAmber}" TextColor="{StaticResource BrandNavy}"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="52" Margin="0,10,0,0" />

            <Label x:Name="StatusLabel" Text="" TextColor="{StaticResource BrandAmber}" FontSize="13"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
