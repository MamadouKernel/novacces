@* Modale « Gérer ce compte » : nom/rôle/site, réinitialisation de mot de
   passe, désactivation/réactivation — ouverte depuis la console Admin sur un
   AUTRE compte que le sien (l'auto-édition reste ProfileEditor). *@
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject ToastService Toasts

<div class="overlay" @onclick="Close">
    <div class="modal" style="max-width:34rem" @onclick:stopPropagation="true">
        <div class="modal-h">
            <div>
                <h2>Gérer « @User.Email »</h2>
                <div class="sub">@(User.IsDeactivated ? "Compte désactivé" : "Compte actif")</div>
            </div>
            <button type="button" @onclick="Close" aria-label="Fermer">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>

        <div class="modal-b">
            <div class="eyebrow">Identité</div>
            <div class="field"><label>Email (identifiant de connexion)</label>
                <input type="email" @bind="_email" placeholder="prenom@site.local" /></div>
            <p class="hint" style="margin-top:-.6rem">Sert aussi d'identifiant de connexion pour ce compte — vérifiez avant d'enregistrer.</p>
            <div class="field"><label>Nom affiché</label>
                <input @bind="_displayName" placeholder="ex. K. N'Guessan" /></div>
            <div class="row">
                <div class="field"><label>Rôle</label>
                    <select @bind="_role">
                        <option value="Hote">Hôte</option>
                        <option value="Surete">Sûreté</option>
                        @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                        {
                            <option value="Admin">Admin</option>
                            <option value="SuperAdmin">SuperAdmin</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Site @(IsGlobalRole(_role) ? "(non requis)" : "(requis)")</label>
                    <select @bind="_siteId" disabled="@IsGlobalRole(_role)">
                        <option value="">— choisir un site —</option>
                        @foreach (var s in Sites)
                        {
                            <option value="@s.SiteId">@s.SiteId</option>
                        }
                    </select>
                </div>
            </div>
            <button class="btn-primary" style="max-width:260px" @onclick="SaveAsync" disabled="@_busy">
                Enregistrer les modifications
            </button>
            @if (_saveMsg is not null) { <p class="error">@_saveMsg</p> }

            <hr class="sep" />

            <div class="eyebrow">Sécurité</div>
            <PasswordBox @bind-Value="_newPassword" Label="Nouveau mot de passe" Autocomplete="new-password" />
            <p class="hint" style="margin-top:-.6rem">12 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial. La personne devra se reconnecter.</p>
            <button class="btn-primary" style="max-width:260px" @onclick="ResetPasswordAsync" disabled="@_busy">
                Réinitialiser le mot de passe
            </button>
            @if (_pwdMsg is not null) { <p class="error">@_pwdMsg</p> }

            <hr class="sep" />

            <div class="eyebrow">Statut du compte</div>
            @if (User.IsDeactivated)
            {
                <button class="btn-primary" style="max-width:220px" @onclick="ReactivateAsync" disabled="@_busy">Réactiver</button>
            }
            else if (!_confirmingDeactivate)
            {
                <button class="btn-danger" @onclick="() => _confirmingDeactivate = true" disabled="@_busy">Désactiver ce compte</button>
            }
            else
            {
                <div class="field"><label>Motif (5 à 500 caractères)</label>
                    <input @bind="_deactivateReason" placeholder="ex. Départ de l'entreprise" /></div>
                <div style="display:flex;gap:.5rem">
                    <button class="btn-danger" @onclick="DeactivateAsync" disabled="@_busy">Confirmer la désactivation</button>
                    <button class="btn-ghost" @onclick="() => _confirmingDeactivate = false">Annuler</button>
                </div>
            }
            @if (_statusMsg is not null) { <p class="error">@_statusMsg</p> }
        </div>

        <div class="modal-f">
            <button class="btn-ghost" @onclick="Close">Fermer</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public AdminUserDto User { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<AdminSiteOverviewDto> Sites { get; set; } = Array.Empty<AdminSiteOverviewDto>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _email = "";
    private string _displayName = "";
    private string _role = "Hote";
    private string _siteId = "";
    private bool _busy;
    private string? _saveMsg;

    private string _newPassword = "";
    private string? _pwdMsg;

    private bool _confirmingDeactivate;
    private string _deactivateReason = "";
    private string? _statusMsg;

    protected override void OnInitialized()
    {
        _email = User.Email;
        _displayName = User.DisplayName;
        _role = User.Roles.Contains(NovAccesRoles.SuperAdmin) ? NovAccesRoles.SuperAdmin
            : User.Roles.Contains(NovAccesRoles.Admin) ? NovAccesRoles.Admin
            : User.Roles.Contains(NovAccesRoles.Surete) ? NovAccesRoles.Surete
            : NovAccesRoles.Hote;
        _siteId = User.SiteId ?? "";
    }

    private static bool IsGlobalRole(string role) => role is NovAccesRoles.Admin or NovAccesRoles.SuperAdmin;

    private async Task SaveAsync()
    {
        _saveMsg = null;
        var email = _email.Trim();
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        { _saveMsg = "Email invalide."; return; }
        var name = _displayName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        { _saveMsg = "Nom affiché requis."; return; }
        if (!IsGlobalRole(_role) && string.IsNullOrEmpty(_siteId))
        { _saveMsg = "Choisissez un site."; return; }

        _busy = true;
        try
        {
            var (ok, error) = await Api.UpdateUserAsync(User.Id, email, name, _role, IsGlobalRole(_role) ? null : _siteId);
            if (ok)
            {
                Toasts.Success("Compte modifié.");
                await OnSaved.InvokeAsync();
            }
            else { _saveMsg = error ?? "Modification refusée."; }
        }
        catch { _saveMsg = "Service indisponible, réessayez."; }
        finally { _busy = false; }
    }

    private async Task ResetPasswordAsync()
    {
        _pwdMsg = null;
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 12)
        { _pwdMsg = "12 caractères minimum."; return; }

        _busy = true;
        try
        {
            var (ok, error) = await Api.ResetUserPasswordAsync(User.Id, _newPassword);
            if (ok)
            {
                Toasts.Success("Mot de passe réinitialisé.");
                _newPassword = "";
            }
            else { _pwdMsg = error ?? "Réinitialisation refusée."; }
        }
        catch { _pwdMsg = "Service indisponible, réessayez."; }
        finally { _busy = false; }
    }

    private async Task DeactivateAsync()
    {
        _statusMsg = null;
        var reason = _deactivateReason.Trim();
        if (reason.Length is < 5 or > 500)
        { _statusMsg = "Le motif doit faire entre 5 et 500 caractères."; return; }

        _busy = true;
        try
        {
            var (ok, error) = await Api.DeactivateUserAsync(User.Id, reason);
            if (ok)
            {
                Toasts.Success("Compte désactivé.");
                await OnSaved.InvokeAsync();
            }
            else { _statusMsg = error ?? "Désactivation refusée."; }
        }
        catch { _statusMsg = "Service indisponible, réessayez."; }
        finally { _busy = false; }
    }

    private async Task ReactivateAsync()
    {
        _statusMsg = null;
        _busy = true;
        try
        {
            var (ok, error) = await Api.ReactivateUserAsync(User.Id);
            if (ok)
            {
                Toasts.Success("Compte réactivé.");
                await OnSaved.InvokeAsync();
            }
            else { _statusMsg = error ?? "Réactivation refusée."; }
        }
        catch { _statusMsg = "Service indisponible, réessayez."; }
        finally { _busy = false; }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
