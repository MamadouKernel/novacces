@* Invitation groupée : composer un lot de visiteurs (champs communs + collage
   intelligent d'une liste) et générer un QR par visiteur en une opération. *@
@inject NovAccesApiClient Api

<div class="overlay" @onclick="CloseIfBackdrop">
    <div class="modal" @onclick:stopPropagation="true">

        <div class="modal-h">
            <div>
                <h2>@(_result is null ? "Inviter un groupe de visiteurs" : "Invitations générées")</h2>
                <div class="sub">
                    @if (_result is null)
                    {
                        <span>Composez la liste — un QR signé sera généré et envoyé à chaque visiteur.</span>
                    }
                    else
                    {
                        <span>@_result.Created invitation(s) créée(s)@(_result.Failed > 0 ? $" · {_result.Failed} en échec" : "")</span>
                    }
                </div>
            </div>
            <button type="button" @onclick="Close" aria-label="Fermer">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>

        @if (_result is null)
        {
            @* ---------- Étape 1 : composition ---------- *@
            <div class="modal-b">
                <div class="shared-box">
                    <div class="eyebrow">Paramètres communs — appliqués à tout le groupe</div>
                    <div class="row">
                        <div class="field"><label>Société</label>
                            <input @bind="_company" placeholder="ex. SIPRA" /></div>
                        <div class="field"><label>Motif</label>
                            <input @bind="_motif" placeholder="ex. Réunion trimestrielle" /></div>
                    </div>
                    <div class="row">
                        <div class="field"><label>Mode</label>
                            <select @bind="_mode">
                                <option value="Unique">Passage unique (rendez-vous)</option>
                                <option value="ThirtyDays">Accès 30 jours ouvrés</option>
                            </select>
                        </div>
                        <div class="field"><label>Durée prévue (min)</label>
                            <input type="number" min="15" step="15" @bind="_duration" /></div>
                    </div>
                    @if (_mode == "Unique")
                    {
                        <div class="field" style="margin-bottom:0"><label>Rendez-vous (commun)</label>
                            <input type="datetime-local" @bind="_scheduled" /></div>
                    }
                </div>

                <div style="margin-top:1.1rem">
                    <div class="eyebrow">Ajouter des visiteurs</div>
                    <textarea rows="3" class="w-full rounded-md border-line bg-white text-sm"
                              placeholder="Collez une liste — un visiteur par ligne.&#10;Formats : « Nom », « Nom, Téléphone », « Nom, Société, +225…, email@ex.ci »"
                              @bind="_paste" @bind:event="oninput"></textarea>
                    <div class="toolbar" style="margin-top:.5rem;margin-bottom:0">
                        <button class="btn-ghost" @onclick="ParsePaste" disabled="@string.IsNullOrWhiteSpace(_paste)">
                            ＋ Ajouter les visiteurs collés
                        </button>
                        <button class="btn-ghost" @onclick="AddEmptyRow">＋ Ligne vide</button>
                        <span class="paste-hint">Astuce : depuis Excel, copiez la colonne des noms et collez ici.</span>
                    </div>
                </div>

                <div style="margin-top:1rem">
                    @if (_rows.Count == 0)
                    {
                        <div class="roster-empty">
                            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.9M16 3.1a4 4 0 010 7.8"/></svg>
                            <p>Aucun visiteur pour l'instant.</p>
                            <p class="hint">Collez une liste ci-dessus, ou ajoutez une ligne.</p>
                        </div>
                    }
                    else
                    {
                        <table class="roster">
                            <thead>
                                <tr><th style="width:2rem">#</th><th>Nom</th><th>Société</th><th>Téléphone / Email</th><th style="width:2rem"></th></tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _rows.Count; i++)
                                {
                                    var row = _rows[i];
                                    var idx = i;
                                    <tr class="@(IsDuplicate(row) ? "dup" : "")">
                                        <td class="muted mono">@(idx + 1)</td>
                                        <td>
                                            <input @bind="row.Name" @bind:event="oninput" placeholder="Nom du visiteur" />
                                            @if (IsDuplicate(row))
                                            {
                                                <span class="badge badge-pending" style="margin-top:.2rem">doublon</span>
                                            }
                                        </td>
                                        <td><input @bind="row.Company" placeholder="@(_company is { Length: > 0 } ? _company : "Société")" /></td>
                                        <td><input @bind="row.Contact" placeholder="+225… ou email@ex.ci" /></td>
                                        <td>
                                            <button class="rm" @onclick="() => RemoveRow(idx)" aria-label="Retirer">
                                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                @if (_error is not null) { <p class="error">@_error</p> }
            </div>

            <div class="modal-f">
                <div class="text-sm text-muted">
                    <strong class="text-ink">@ReadyCount</strong> visiteur(s) prêt(s)
                    @if (DuplicateCount > 0) { <span class="text-amber-700"> · @DuplicateCount doublon(s)</span> }
                </div>
                <div class="flex gap-2">
                    <button class="btn-ghost" @onclick="Close">Annuler</button>
                    <button class="btn-accent" @onclick="SubmitAsync" disabled="@(_busy || ReadyCount == 0)">
                        @if (_busy) { <span>Génération…</span> } else { <span>Générer @ReadyCount QR</span> }
                    </button>
                </div>
            </div>
        }
        else
        {
            @* ---------- Étape 2 : résultats ---------- *@
            <div class="modal-b">
                <div class="synthese" style="display:flex;align-items:center;gap:.6rem">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-ok"><path d="M20 6L9 17l-5-5"/></svg>
                    <span><strong>@_result.Created</strong> invitation(s) générée(s) et envoyée(s) (WhatsApp, repli email).@(_result.Failed > 0 ? $" {_result.Failed} n'ont pas pu être créées." : "")</span>
                </div>

                <div class="space-y-1.5">
                    @foreach (var it in _result.Items)
                    {
                        <div class="result-line @(it.Success ? "ok" : "ko")">
                            <span class="feed-name">@it.VisitorName</span>
                            @if (it.Success)
                            {
                                <span class="badge badge-valid">QR généré</span>
                            }
                            else
                            {
                                <span class="text-sm text-no">@it.Error</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="modal-f">
                <button class="btn-ghost" @onclick="Reset">Inviter un autre groupe</button>
                <button class="btn-primary" style="max-width:180px" @onclick="Close">Terminer</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public string? DefaultCompany { get; set; }

    private sealed class Row
    {
        public string Name { get; set; } = "";
        public string Company { get; set; } = "";
        public string Contact { get; set; } = ""; // téléphone OU email (auto-détecté)
    }

    private readonly List<Row> _rows = new();
    private string _company = "";
    private string _motif = "";
    private string _mode = "Unique";
    private int _duration = 60;
    private DateTime _scheduled = DateTime.Now.Date.AddHours(9);
    private string _paste = "";
    private bool _busy;
    private string? _error;
    private BulkCreateVisitsResponseDto? _result;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(DefaultCompany)) _company = DefaultCompany!;
    }

    private int ReadyCount => _rows.Count(r => !string.IsNullOrWhiteSpace(r.Name));

    private int DuplicateCount =>
        _rows.Where(r => !string.IsNullOrWhiteSpace(r.Name))
             .GroupBy(r => r.Name.Trim().ToLowerInvariant())
             .Where(g => g.Count() > 1)
             .Sum(g => g.Count() - 1);

    private bool IsDuplicate(Row row)
    {
        if (string.IsNullOrWhiteSpace(row.Name)) return false;
        var key = row.Name.Trim().ToLowerInvariant();
        return _rows.Count(r => r.Name.Trim().ToLowerInvariant() == key) > 1;
    }

    private void AddEmptyRow() => _rows.Add(new Row { Company = _company });

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < _rows.Count) _rows.RemoveAt(index);
    }

    // Collage intelligent : une ligne par visiteur ; colonnes séparées par
    // virgule / point-virgule / tabulation. Détection auto téléphone vs email
    // vs société selon le contenu.
    private void ParsePaste()
    {
        if (string.IsNullOrWhiteSpace(_paste)) return;

        var lines = _paste.Replace("\r\n", "\n").Split('\n');
        foreach (var raw in lines)
        {
            var line = raw.Trim();
            if (line.Length == 0) continue;

            var parts = line.Split(new[] { ',', ';', '\t' }, StringSplitOptions.TrimEntries);
            var row = new Row { Name = parts[0], Company = _company };

            for (var k = 1; k < parts.Length; k++)
            {
                var p = parts[k];
                if (p.Length == 0) continue;
                if (p.Contains('@')) row.Contact = p;
                else if (LooksLikePhone(p)) row.Contact = p;
                else row.Company = p;
            }

            if (!string.IsNullOrWhiteSpace(row.Name)) _rows.Add(row);
        }

        _paste = "";
    }

    private static bool LooksLikePhone(string s)
    {
        var digits = s.Count(char.IsDigit);
        return digits >= 6 && s.All(c => char.IsDigit(c) || " +().-".Contains(c));
    }

    private async Task SubmitAsync()
    {
        if (_busy || ReadyCount == 0) return;
        _error = null;

        if (_mode == "Unique" && _scheduled == default)
        {
            _error = "Renseignez la date de rendez-vous commune.";
            return;
        }

        _busy = true;
        try
        {
            DateTimeOffset? scheduled = _mode == "Unique"
                ? new DateTimeOffset(_scheduled.ToUniversalTime(), TimeSpan.Zero)
                : null;

            var visits = _rows
                .Where(r => !string.IsNullOrWhiteSpace(r.Name))
                .Select(r =>
                {
                    var contact = r.Contact?.Trim() ?? "";
                    var isEmail = contact.Contains('@');
                    return new CreateVisitRequestDto(
                        r.Name.Trim(),
                        string.IsNullOrWhiteSpace(r.Company) ? _company.Trim() : r.Company.Trim(),
                        _motif.Trim(),
                        _mode, scheduled, _duration,
                        !isEmail && contact.Length > 0 ? contact : null,
                        isEmail ? contact : null);
                })
                .ToList();

            _result = await Api.CreateVisitsBulkAsync(new BulkCreateVisitsRequestDto(visits));
            if (OnCompleted.HasDelegate) await OnCompleted.InvokeAsync();
        }
        catch
        {
            _error = "La génération groupée a échoué (session expirée ou service indisponible).";
        }
        finally { _busy = false; }
    }

    private void Reset()
    {
        _rows.Clear();
        _paste = "";
        _result = null;
        _error = null;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task CloseIfBackdrop()
    {
        // Fermer seulement si on clique le fond, pas le contenu (géré par stopPropagation).
        if (!_busy) await OnClose.InvokeAsync();
    }
}
