@* Champ mot de passe réutilisable avec bouton « œil » afficher/masquer. *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label>@Label</label>
    }
    <div class="relative">
        <input type="@(_visible ? "text" : "password")"
               class="!pr-11"
               value="@Value"
               @oninput="OnInput"
               autocomplete="@Autocomplete"
               placeholder="@Placeholder"
               @onkeydown="OnKeyDown" />
        <button type="button" class="pwd-eye" @onclick="Toggle"
                aria-label="@(_visible ? "Masquer le mot de passe" : "Afficher le mot de passe")"
                tabindex="-1">
            @if (_visible)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20">
                    <path d="M3 3l18 18" stroke-linecap="round" />
                    <path d="M10.6 10.6a2 2 0 002.8 2.8" />
                    <path d="M9.4 5.1A9.9 9.9 0 0112 5c5 0 9 4 10 7-.5 1.4-1.5 2.9-2.9 4.1M6.1 6.1C4 7.4 2.6 9.3 2 12c1 3 5 7 10 7 1.2 0 2.3-.2 3.3-.6" stroke-linecap="round" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20">
                    <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z" stroke-linejoin="round" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            }
        </button>
    </div>
</div>

@code {
    private bool _visible;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public EventCallback OnEnter { get; set; }

    private async Task OnInput(ChangeEventArgs e)
        => await ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private void Toggle() => _visible = !_visible;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && OnEnter.HasDelegate)
            await OnEnter.InvokeAsync();
    }
}
