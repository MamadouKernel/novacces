@* Badge visiteur (QR + identité). Utilisé à la fois à la création d'une
   demande et à la réémission du QR d'une demande existante (« Voir QR ») —
   c'est le MÊME rendu visuel dans les deux cas, seule la donnée change.
   L'id "visitor-badge" est ciblé par la feuille @media print de app.css :
   un seul badge est monté à la fois (les deux surcouches sont exclusives),
   donc l'identifiant reste sans ambiguïté. *@
@inject IJSRuntime JS

<div class="badge-doc" id="visitor-badge">
    <div class="badge-head">NOV<span>ACCÈS</span></div>
    <div class="badge-site">@(SiteId?.ToUpperInvariant())</div>
    <img class="qr" src="@QrImage.ToDataUri(SignedQrPayload)" alt="QR visiteur" />
    <div class="badge-name">@VisitorName</div>
    <div class="badge-company">@VisitorCompany</div>
    <div class="badge-valid">Valide jusqu'au @ExpiresAt.LocalDateTime.ToString("dd/MM/yyyy 'à' HH:mm")</div>
    <div class="badge-foot">Présentez ce badge au poste de contrôle · Sigasécurité</div>
</div>

<p class="muted" style="margin-top:.6rem">Visite <code>@VisitId</code></p>
<button class="btn-primary" style="max-width:220px" @onclick="PrintAsync">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>
    Imprimer le badge
</button>
<p class="hint">Le QR est aussi envoyé automatiquement au visiteur (WhatsApp, repli email).</p>

@code {
    [Parameter, EditorRequired] public string? SiteId { get; set; }
    [Parameter, EditorRequired] public string VisitorName { get; set; } = "";
    [Parameter, EditorRequired] public string VisitorCompany { get; set; } = "";
    [Parameter, EditorRequired] public string SignedQrPayload { get; set; } = "";
    [Parameter, EditorRequired] public DateTimeOffset ExpiresAt { get; set; }
    [Parameter, EditorRequired] public Guid VisitId { get; set; }

    private async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("print"); } catch { /* best-effort */ }
    }
}
