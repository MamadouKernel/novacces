@* Mise en page de la console Administration : navbar/footer partagés + sidebar
   de navigation entre les sections. Le contrôle d'accès (rôle Admin) vit ici,
   une seule fois, plutôt que dupliqué dans chacune des 5 pages routées. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav

<AuthPersistence />
<IdleTimeout />
<AppNavbar />

<main class="app-shell">
    @if (!Auth.Initialized)
    {
        <p class="muted" style="padding:2rem">Chargement…</p>
    }
    else if (Auth.IsInRole(NovAccesRoles.Admin))
    {
        <div class="admin-shell">
            <nav class="admin-nav">
                <span class="admin-nav-label">Administration</span>
                <NavLink class="admin-navlink" href="/admin" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5L12 4l8 7.5" /><path d="M6 10v9a1 1 0 0 0 1 1h3v-6h4v6h3a1 1 0 0 0 1-1v-9" /></svg>
                    <span>Dashboard</span>
                </NavLink>
                <NavLink class="admin-navlink" href="/admin/comptes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2" /><path d="M3 20a6 6 0 0 1 12 0" /><path d="M16 4.5a3 3 0 0 1 0 6" /><path d="M21 20a5.5 5.5 0 0 0-5-5.9" /></svg>
                    <span>Comptes</span>
                </NavLink>
                <NavLink class="admin-navlink" href="/admin/sites">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11.5a7 7 0 0 1 14 0C19 14.5 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    <span>Sites</span>
                </NavLink>
                <NavLink class="admin-navlink" href="/admin/agents">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="3.5" width="15" height="17" rx="2" /><circle cx="12" cy="10" r="2.3" /><path d="M8.2 17c.5-1.9 2-3 3.8-3s3.3 1.1 3.8 3" /></svg>
                    <span>Agents</span>
                </NavLink>
                <NavLink class="admin-navlink" href="/admin/terminaux">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="12" rx="2" /><path d="M8 20.5h8M12 16.5v4" /></svg>
                    <span>Terminaux</span>
                </NavLink>
                <NavLink class="admin-navlink" href="/admin/visiteurs">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2" /><path d="M5.5 20a6.5 6.5 0 0 1 13 0" /></svg>
                    <span>Visiteurs</span>
                </NavLink>
                @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                {
                    <NavLink class="admin-navlink" href="/admin/audit">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3.5h6a1 1 0 0 1 1 1v1H8v-1a1 1 0 0 1 1-1z" /><rect x="5.5" y="5.5" width="13" height="15" rx="2" /><path d="M9 11h6M9 14.5h6M9 18h3.5" /></svg>
                        <span>Audit</span>
                    </NavLink>
                }
                <NavLink class="admin-navlink" href="/admin/retention">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5l3.2 2" /></svg>
                    <span>Rétention</span>
                </NavLink>
                @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                {
                    @* Sauvegarde complète = données de TOUS les clients en un fichier :
                       lien visible au seul SuperAdmin, comme la policy serveur. *@
                    <NavLink class="admin-navlink" href="/admin/base-de-donnees">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7.5" ry="3" /><path d="M4.5 6v12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6" /><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3" /></svg>
                        <span>Base de données</span>
                    </NavLink>
                }
            </nav>
            <div class="admin-content">
                @Body
            </div>
        </div>
    }
</main>

<AppFooter />
<ToastHost />

<div id="blazor-error-ui">
    Une erreur inattendue s'est produite.
    <a href="" class="reload">Recharger</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Auth.Initialized && !Auth.IsInRole(NovAccesRoles.Admin))
            Nav.NavigateTo("/login");
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
