@page "/admin/comptes"
@layout AdminLayout
@implements IDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject ToastService Toasts
@inject AdminLiveUpdates Live

<PageTitle>SigasAcces — Administration · Comptes</PageTitle>

<header class="portal-header">
    <div>
        <h1>Comptes</h1>
        <p class="muted">Hôtes, Sûreté, Admin — création et vue d'ensemble.</p>
    </div>
</header>

<section class="card">
    <h2>Créer un compte</h2>
    <div class="field"><label>Email</label>
        <input type="email" @bind="_newUser.Email" placeholder="prenom@site.local" /></div>
    <div class="field"><label>Nom affiché</label>
        <input @bind="_newUser.DisplayName" placeholder="ex. K. N'Guessan" /></div>
    <PasswordBox @bind-Value="_newUser.Password" Label="Mot de passe" Autocomplete="new-password" />
    <p class="hint" style="margin-top:-.6rem">12 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</p>
    <div class="row">
        <div class="field"><label>Rôle</label>
            <select @bind="_newUser.Role">
                <option value="Hote">Hôte — crée les demandes de visite</option>
                <option value="Surete">Sûreté — supervise les accès</option>
                @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                {
                    <option value="Admin">Admin — global (tous les sites)</option>
                    <option value="SuperAdmin">SuperAdmin — prestataire (réservé)</option>
                }
            </select>
        </div>
        <div class="field"><label>Site @(IsGlobalRole(_newUser.Role) ? "(non requis)" : "(requis)")</label>
            <select @bind="_newUser.SiteId" disabled="@IsGlobalRole(_newUser.Role)">
                <option value="">— choisir un site —</option>
                @foreach (var s in _overview)
                {
                    <option value="@s.SiteId">@s.SiteId</option>
                }
            </select>
            @if (!IsGlobalRole(_newUser.Role) && _overview.Count == 0)
            {
                <p class="hint">Aucun site provisionné — voir la section « Sites ».</p>
            }
        </div>
    </div>
    <button class="btn-primary" @onclick="CreateUserAsync" disabled="@_busy">Créer le compte</button>
    @if (_userMsg is not null) { <p class="@(_userOk ? "info" : "error")">@_userMsg</p> }
</section>

<section class="card">
    <h2>Comptes</h2>
    @if (_users.Count == 0)
    {
        <div class="empty">@EmptyIcon()<p>Aucun compte pour le moment.</p></div>
    }
    else
    {
        <div class="toolbar">
            <input class="search" placeholder="Rechercher un email, un nom, un site…"
                   @bind="_userSearch" @bind:event="oninput" @bind:after="() => _usersPage = 1" />
            <div class="filters">
                @foreach (var f in RoleFilters)
                {
                    <button class="filter @(_roleFilter == f.Key ? "on" : "")"
                            @onclick="() => { _roleFilter = f.Key; _usersPage = 1; }">
                        @f.Label <span class="count">@RoleCount(f.Key)</span>
                    </button>
                }
            </div>
        </div>
        <div class="filters" style="margin:.5rem 0 .9rem">
            <button class="filter @(_statusFilter == "all" ? "on" : "")" @onclick='() => SetStatusFilter("all")'>Tous statuts <span class="count">@_users.Count</span></button>
            <button class="filter @(_statusFilter == "active" ? "on" : "")" @onclick='() => SetStatusFilter("active")'>Actifs <span class="count">@_users.Count(u => !u.IsDeactivated)</span></button>
            <button class="filter @(_statusFilter == "inactive" ? "on" : "")" @onclick='() => SetStatusFilter("inactive")'>Désactivés <span class="count">@_users.Count(u => u.IsDeactivated)</span></button>
        </div>

        var urows = FilteredUsers;
        if (urows.Count == 0)
        {
            <div class="empty">
                @EmptyIcon()<p>Aucun compte ne correspond à la recherche.</p>
                <button class="btn-ghost" @onclick="ResetUserFilters">Réinitialiser</button>
            </div>
        }
        else
        {
            var pageCount = (int)Math.Ceiling(urows.Count / (double)_usersPageSize);
            if (_usersPage > pageCount) { _usersPage = pageCount; }
            var pageRows = urows.Skip((_usersPage - 1) * _usersPageSize).Take(_usersPageSize).ToList();
            <div class="table-wrap">
            <table class="visits">
                <thead><tr>
                    <SortableTh Column="email" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Email</SortableTh>
                    <SortableTh Column="nom" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Nom</SortableTh>
                    <th>Rôles</th>
                    <SortableTh Column="site" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Site</SortableTh>
                    <th>2FA</th>
                    <SortableTh Column="statut" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Statut</SortableTh>
                    <th></th>
                </tr></thead>
                <tbody>
                    @foreach (var u in pageRows)
                    {
                        <tr>
                            <td>@Highlight(u.Email)</td>
                            <td class="muted">@Highlight(u.DisplayName)</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge badge-onsite" style="margin-right:.25rem">@r</span>
                                }
                            </td>
                            <td>@Highlight(u.SiteId ?? "—")</td>
                            <td>@(u.TwoFactorEnabled ? "✅" : "—")</td>
                            <td>@(u.IsDeactivated ? "Désactivé" : "Actif")</td>
                            <td style="white-space:nowrap">
                                @if (CanManage(u))
                                {
                                    <button class="btn-ghost" @onclick="() => _editing = u" disabled="@_busy">Gérer</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_usersPage" PageSize="_usersPageSize" TotalCount="urows.Count"
                        OnPageChanged="p => _usersPage = p" />
        }
    }
</section>

@if (_editing is not null)
{
    <AdminUserEditor User="_editing" Sites="_overview"
                      OnClose="() => _editing = null"
                      OnSaved="async () => { _editing = null; await RefreshAsync(); }" />
}

@code {
    private bool _busy;

    private sealed class NewUser
    {
        public string Email = "";
        public string DisplayName = "";
        public string Password = "";
        public string Role = "Hote";
        public string SiteId = "";
    }

    private readonly NewUser _newUser = new();
    private string? _userMsg; private bool _userOk;

    private IReadOnlyList<AdminUserDto> _users = Array.Empty<AdminUserDto>();
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();

    private string _userSearch = "";
    private string _roleFilter = "all";
    private string _statusFilter = "all";
    private string? _sortColumn;
    private bool _sortAscending = true;
    private int _usersPage = 1;
    private const int _usersPageSize = 20;

    private static readonly (string Key, string Label)[] RoleFilters =
    {
        ("all", "Tous"), ("Admin", "Admin"), ("Surete", "Sûreté"), ("Hote", "Hôte"),
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await Live.EnsureConnectedAsync();
        Live.EntityChanged += OnEntityChanged;
    }

    private async Task RefreshAsync()
    {
        try { _users = await Api.GetUsersAsync(); } catch { /* best-effort */ }
        // Un site désactivé (contrat non reconduit) ne doit plus être proposé
        // pour un NOUVEAU rattachement — celui-ci reste géré (édition, désactivation)
        // pour les comptes déjà existants dessus.
        try { _overview = (await Api.GetSiteOverviewAsync()).Where(s => s.IsActive).ToList(); } catch { /* best-effort */ }
    }

    private void OnEntityChanged(string kind)
    {
        if (kind != "accounts") return;
        _ = InvokeAsync(async () =>
        {
            try { _users = await Api.GetUsersAsync(); } catch { /* best-effort */ }
            StateHasChanged();
        });
    }

    public void Dispose() => Live.EntityChanged -= OnEntityChanged;

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _usersPage = 1;
    }

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _usersPage = 1;
    }

    private int RoleCount(string key) =>
        key == "all" ? _users.Count : _users.Count(u => u.Roles.Contains(key));

    private AdminUserDto? _editing;

    // Un Admin ordinaire peut désormais gérer n'importe quel compte visible
    // (Hôte/Sûreté/Admin — les SuperAdmin sont déjà invisibles pour lui, filtrés
    // côté serveur), sauf lui-même via cet écran : rôle/site/désactivation
    // restent hors de portée de l'auto-édition pour un Admin simple. Un
    // SuperAdmin, en revanche, peut se gérer lui-même : le serveur protège déjà
    // contre l'auto-verrouillage total (rétrogradation/désactivation du dernier
    // SuperAdmin actif refusées, voir AdminEndpoints.cs). Comparaison par email
    // (unique) et non par nom affiché, qui peut être partagé. Le contrôle
    // SuperAdmin ci-dessous est une barrière de dernier recours, cohérente avec
    // la règle serveur CanManageAccount.
    private bool CanManage(AdminUserDto u)
    {
        if (Auth.IsInRole(NovAccesRoles.SuperAdmin)) return true;
        if (string.Equals(u.Email, Auth.Email, StringComparison.OrdinalIgnoreCase)) return false;
        return !u.Roles.Contains(NovAccesRoles.SuperAdmin);
    }

    private void ResetUserFilters() { _userSearch = ""; _roleFilter = "all"; _statusFilter = "all"; _usersPage = 1; }

    private IReadOnlyList<AdminUserDto> FilteredUsers
    {
        get
        {
            IEnumerable<AdminUserDto> q = _users;

            if (_roleFilter != "all")
                q = q.Where(u => u.Roles.Contains(_roleFilter));

            if (_statusFilter != "all")
                q = q.Where(u => (_statusFilter == "inactive") == u.IsDeactivated);

            var s = _userSearch?.Trim();
            if (!string.IsNullOrEmpty(s))
                q = q.Where(u =>
                    (u.Email?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.DisplayName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.SiteId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));

            q = _sortColumn switch
            {
                "email" => _sortAscending ? q.OrderBy(u => u.Email) : q.OrderByDescending(u => u.Email),
                "nom" => _sortAscending ? q.OrderBy(u => u.DisplayName) : q.OrderByDescending(u => u.DisplayName),
                "site" => _sortAscending ? q.OrderBy(u => u.SiteId) : q.OrderByDescending(u => u.SiteId),
                "statut" => _sortAscending ? q.OrderBy(u => u.IsDeactivated) : q.OrderByDescending(u => u.IsDeactivated),
                _ => q.OrderBy(u => u.Email),
            };

            return q.ToList();
        }
    }

    private MarkupString Highlight(string? text)
    {
        var t = text ?? "";
        var s = _userSearch?.Trim();
        if (string.IsNullOrEmpty(s))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var idx = t.IndexOf(s, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var before = System.Net.WebUtility.HtmlEncode(t[..idx]);
        var match  = System.Net.WebUtility.HtmlEncode(t.Substring(idx, s.Length));
        var after  = Highlight(t[(idx + s.Length)..]).Value;
        return (MarkupString)$"{before}<mark>{match}</mark>{after}";
    }

    private static RenderFragment EmptyIcon() => builder =>
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor'
            stroke-width='1.6' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M21 21l-4.3-4.3'/></svg>");

    private static bool IsGlobalRole(string role) => role is NovAccesRoles.Admin or NovAccesRoles.SuperAdmin;

    private async Task CreateUserAsync()
    {
        _busy = true; _userMsg = null;
        try
        {
            var siteId = IsGlobalRole(_newUser.Role) ? null
                : string.IsNullOrWhiteSpace(_newUser.SiteId) ? null : SiteSlug.From(_newUser.SiteId);

            if (!IsGlobalRole(_newUser.Role) && string.IsNullOrEmpty(siteId))
            {
                _userOk = false; _userMsg = "Renseignez le site (obligatoire sauf pour un Admin/SuperAdmin).";
                return;
            }

            var (ok, error) = await Api.RegisterUserAsync(new RegisterUserRequestDto(
                _newUser.Email.Trim(), _newUser.Password, _newUser.DisplayName.Trim(), _newUser.Role, siteId));

            _userOk = ok;
            _userMsg = ok ? "Compte créé." : error;
            if (ok)
            {
                Toasts.Success($"Compte « {_newUser.Email.Trim()} » créé.");
                _newUser.Email = _newUser.DisplayName = _newUser.Password = _newUser.SiteId = "";
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Création refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }
}
