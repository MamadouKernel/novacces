@page "/admin/agents"
@layout AdminLayout
@implements IDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject ToastService Toasts
@inject AdminLiveUpdates Live

<PageTitle>SigasAcces — Administration · Agents</PageTitle>

<header class="portal-header">
    <div>
        <h1>Agents</h1>
        <p class="muted">Matricule + PIN pour l'identification de l'agent sur le terminal. Le PIN sert au « prendre le poste » et n'est jamais affiché après création.</p>
    </div>
</header>

<section class="card">
    <div class="field" style="max-width:22rem"><label>Site</label>
        <select @bind="_agentSite" @bind:after="RefreshAgentsAsync">
            <option value="">— choisir un site —</option>
            @foreach (var s in _overview)
            {
                <option value="@s.SiteId">@s.SiteId</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrEmpty(_agentSite))
    {
        <div class="row">
            <div class="field"><label>Matricule</label>
                <input @bind="_newAgent.Matricule" placeholder="ex. SG-0417" /></div>
            <div class="field"><label>Nom</label>
                <input @bind="_newAgent.DisplayName" placeholder="ex. A. Traoré" /></div>
            <div class="field"><label>Code PIN</label>
                <input type="password" inputmode="numeric" @bind="_newAgent.Pin" placeholder="4 à 8 chiffres" /></div>
        </div>
        <button class="btn-primary" @onclick="CreateAgentAsync" disabled="@_busy">Créer l'agent</button>
        @if (_agentMsg is not null) { <p class="@(_agentOk ? "info" : "error")">@_agentMsg</p> }

        <div class="field" style="max-width:22rem;margin-top:1rem"><label>Rechercher</label>
            <input @bind="_search" @bind:event="oninput" @bind:after="() => _agentsPage = 1" placeholder="Matricule ou nom…" /></div>
        <div class="filters" style="margin-bottom:.9rem">
            <button class="filter @(_statusFilter == "all" ? "on" : "")" @onclick='() => SetStatusFilter("all")'>Tous <span class="count">@_agents.Count</span></button>
            <button class="filter @(_statusFilter == "active" ? "on" : "")" @onclick='() => SetStatusFilter("active")'>Actifs <span class="count">@_agents.Count(a => a.IsActive)</span></button>
            <button class="filter @(_statusFilter == "inactive" ? "on" : "")" @onclick='() => SetStatusFilter("inactive")'>Désactivés <span class="count">@_agents.Count(a => !a.IsActive)</span></button>
            @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
            {
                <button class="filter @(_statusFilter == "archived" ? "on" : "")" @onclick='() => SetStatusFilter("archived")'>Archivés <span class="count">@_archivedAgents.Count</span></button>
            }
        </div>

        @if (_statusFilter == "archived")
        {
            <p class="hint">Agents supprimés : conservés en base pour la traçabilité, lecture seule — leur matricule est réutilisable pour un nouvel agent.</p>
            <div class="table-wrap">
            <table class="visits">
                <thead><tr><th>Matricule</th><th>Nom</th><th>Supprimé le</th><th>Par</th></tr></thead>
                <tbody>
                    @foreach (var a in PagedArchivedAgents)
                    {
                        <tr>
                            <td><strong>@a.Matricule</strong></td>
                            <td class="muted">@a.DisplayName</td>
                            <td>@a.DeletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="muted">@(a.DeletedBy ?? "—")</td>
                        </tr>
                    }
                    @if (FilteredArchivedAgents.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">Aucun agent archivé pour ce site.</td></tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_archivedPage" PageSize="_agentsPageSize" TotalCount="FilteredArchivedAgents.Count"
                        OnPageChanged="p => _archivedPage = p" />
        }
        else
        {
        <div class="table-wrap">
        <table class="visits">
            <thead><tr>
                <SortableTh Column="matricule" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Matricule</SortableTh>
                <SortableTh Column="nom" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Nom</SortableTh>
                <SortableTh Column="statut" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Statut</SortableTh>
                <th></th>
            </tr></thead>
            <tbody>
                @foreach (var a in PagedAgents)
                {
                    <tr>
                        <td><strong>@a.Matricule</strong></td>
                        <td class="muted">@a.DisplayName</td>
                        <td>@(a.IsActive ? "Actif" : "Désactivé")</td>
                        <td style="white-space:nowrap">
                            @if (a.IsActive)
                            {
                                <button class="btn-ghost" @onclick="() => StartReassign(a.Matricule, a.DisplayName)" disabled="@_busy">Réaffecter</button>
                                <button class="btn-danger" @onclick="() => DeactivateAgentAsync(a.Matricule)" disabled="@_busy">Désactiver</button>
                            }
                            else
                            {
                                <button class="btn-primary" @onclick="() => ReactivateAgentAsync(a.Matricule)" disabled="@_busy">Réactiver</button>
                                <button class="btn-danger" @onclick="() => DeleteAgentAsync(a.Matricule)" disabled="@_busy">Supprimer</button>
                            }
                        </td>
                    </tr>
                    @if (_reassignMatricule == a.Matricule)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="row" style="align-items:flex-end">
                                    <div class="field"><label>Réaffecter « @a.Matricule » vers</label>
                                        <select @bind="_reassignTargetSite">
                                            <option value="">— choisir un site —</option>
                                            @foreach (var s in _overview.Where(s => s.SiteId != _agentSite))
                                            {
                                                <option value="@s.SiteId">@s.SiteId</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field"><label>Nouveau PIN sur ce site</label>
                                        <input type="password" inputmode="numeric" @bind="_reassignPin" placeholder="4 à 8 chiffres" /></div>
                                    <button class="btn-primary" @onclick="ConfirmReassignAsync" disabled="@_busy">Confirmer</button>
                                    <button class="btn-ghost" @onclick="CancelReassign">Annuler</button>
                                </div>
                                <p class="hint">Opération atomique : désactive « @a.Matricule » sur « @_agentSite », puis le crée sur le site cible avec ce PIN.</p>
                                @if (_reassignMsg is not null) { <p class="error">@_reassignMsg</p> }
                            </td>
                        </tr>
                    }
                }
                @if (FilteredAgents.Count == 0)
                {
                    <tr><td colspan="4" class="muted">@(_agents.Count == 0 ? "Aucun agent pour ce site." : "Aucun agent ne correspond à ce filtre.")</td></tr>
                }
            </tbody>
        </table>
        </div>
        <Pagination Page="_agentsPage" PageSize="_agentsPageSize" TotalCount="FilteredAgents.Count"
                    OnPageChanged="p => _agentsPage = p" />
        }
    }
</section>

@code {
    private bool _busy;
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();

    private sealed class NewAgent { public string Matricule = ""; public string DisplayName = ""; public string Pin = ""; }
    private readonly NewAgent _newAgent = new();
    private string _agentSite = "";
    private IReadOnlyList<AgentSummaryDto> _agents = Array.Empty<AgentSummaryDto>();
    private IReadOnlyList<ArchivedAgentSummaryDto> _archivedAgents = Array.Empty<ArchivedAgentSummaryDto>();
    private string? _agentMsg; private bool _agentOk;
    private int _agentsPage = 1;
    private int _archivedPage = 1;
    private const int _agentsPageSize = 20;

    private string _search = "";
    private string _statusFilter = "all";
    private string? _sortColumn;
    private bool _sortAscending = true;

    private List<AgentSummaryDto> FilteredAgents =>
        _agents
            .Where(a => _statusFilter switch { "active" => a.IsActive, "inactive" => !a.IsActive, _ => true })
            .Where(a => string.IsNullOrWhiteSpace(_search)
                || a.Matricule.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || a.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IEnumerable<AgentSummaryDto> SortedAgents => _sortColumn switch
    {
        "matricule" => _sortAscending ? FilteredAgents.OrderBy(a => a.Matricule) : FilteredAgents.OrderByDescending(a => a.Matricule),
        "nom" => _sortAscending ? FilteredAgents.OrderBy(a => a.DisplayName) : FilteredAgents.OrderByDescending(a => a.DisplayName),
        "statut" => _sortAscending ? FilteredAgents.OrderBy(a => a.IsActive) : FilteredAgents.OrderByDescending(a => a.IsActive),
        _ => FilteredAgents
    };

    private IReadOnlyList<AgentSummaryDto> PagedAgents =>
        SortedAgents.Skip((_agentsPage - 1) * _agentsPageSize).Take(_agentsPageSize).ToList();

    private List<ArchivedAgentSummaryDto> FilteredArchivedAgents =>
        _archivedAgents
            .Where(a => string.IsNullOrWhiteSpace(_search)
                || a.Matricule.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || a.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IReadOnlyList<ArchivedAgentSummaryDto> PagedArchivedAgents =>
        FilteredArchivedAgents.Skip((_archivedPage - 1) * _agentsPageSize).Take(_agentsPageSize).ToList();

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _agentsPage = 1;
    }

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _agentsPage = 1;
        _archivedPage = 1;
    }

    private string? _reassignMatricule;
    private string _reassignDisplayName = "";
    private string _reassignTargetSite = "";
    private string _reassignPin = "";
    private string? _reassignMsg;

    protected override async Task OnInitializedAsync()
    {
        try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
        await Live.EnsureConnectedAsync();
        Live.EntityChanged += OnEntityChanged;
    }

    private async Task RefreshAgentsAsync()
    {
        _agents = Array.Empty<AgentSummaryDto>();
        _archivedAgents = Array.Empty<ArchivedAgentSummaryDto>();
        _agentsPage = 1;
        _archivedPage = 1;
        if (string.IsNullOrEmpty(_agentSite)) return;
        try
        {
            _agents = await Api.GetAgentsAsync(_agentSite);
            // L'archive est réservée au SuperAdmin côté API (403 sinon) — inutile
            // d'appeler l'endpoint pour un Admin ordinaire.
            if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                _archivedAgents = await Api.GetArchivedAgentsAsync(_agentSite);
        }
        catch { /* best-effort */ }
    }

    // Ne rappelle pas RefreshAgentsAsync (elle remet _agentsPage à 1) : une mise
    // à jour en direct ne doit pas faire perdre à l'opérateur la page qu'il
    // consulte.
    private void OnEntityChanged(string kind)
    {
        if (kind != "agents" || string.IsNullOrEmpty(_agentSite)) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                _agents = await Api.GetAgentsAsync(_agentSite);
                if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                    _archivedAgents = await Api.GetArchivedAgentsAsync(_agentSite);
            }
            catch { /* best-effort */ }
            StateHasChanged();
        });
    }

    public void Dispose() => Live.EntityChanged -= OnEntityChanged;

    private async Task CreateAgentAsync()
    {
        if (string.IsNullOrEmpty(_agentSite))
        {
            _agentOk = false; _agentMsg = "Choisissez un site.";
            return;
        }

        _busy = true; _agentMsg = null;
        try
        {
            var (ok, error) = await Api.CreateAgentAsync(
                _agentSite, _newAgent.Matricule.Trim(), _newAgent.DisplayName.Trim(), _newAgent.Pin.Trim());

            _agentOk = ok;
            _agentMsg = ok ? "Agent créé." : error;
            if (ok)
            {
                Toasts.Success($"Agent « {_newAgent.Matricule.Trim()} » créé.");
                _newAgent.Matricule = _newAgent.DisplayName = _newAgent.Pin = "";
                await RefreshAgentsAsync();
            }
            else { Toasts.Error(error ?? "Création refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private void StartReassign(string matricule, string displayName)
    {
        _reassignMatricule = matricule;
        _reassignDisplayName = displayName;
        _reassignTargetSite = "";
        _reassignPin = "";
        _reassignMsg = null;
    }

    private void CancelReassign() => _reassignMatricule = null;

    private async Task ConfirmReassignAsync()
    {
        if (_reassignMatricule is null) return;
        _reassignMsg = null;

        if (string.IsNullOrEmpty(_reassignTargetSite))
        { _reassignMsg = "Choisissez le site cible."; return; }
        if (string.IsNullOrWhiteSpace(_reassignPin) || _reassignPin.Length is < 4 or > 8 || !_reassignPin.All(char.IsDigit))
        { _reassignMsg = "PIN numérique de 4 à 8 chiffres requis."; return; }

        _busy = true;
        try
        {
            // Un seul appel : le serveur désactive la source avant de créer la
            // cible, avec compensation automatique si la création échoue —
            // jamais actif aux deux endroits à la fois.
            var (ok, error) = await Api.ReassignAgentAsync(
                _agentSite, _reassignMatricule, _reassignTargetSite, _reassignPin);
            if (!ok)
            {
                _reassignMsg = error ?? "Réaffectation refusée.";
                return;
            }

            Toasts.Success($"Agent « {_reassignMatricule} » réaffecté de « {_agentSite} » vers « {_reassignTargetSite} ».");
            _reassignMatricule = null;
            await RefreshAgentsAsync();
        }
        catch { _reassignMsg = "Service indisponible, réessayez."; }
        finally { _busy = false; }
    }

    private async Task DeactivateAgentAsync(string matricule)
    {
        if (string.IsNullOrEmpty(_agentSite)) return;
        _busy = true;
        try
        {
            var (ok, error) = await Api.DeactivateAgentAsync(_agentSite, matricule);
            if (ok)
            {
                Toasts.Success($"Agent « {matricule} » désactivé.");
                await RefreshAgentsAsync();
            }
            else { Toasts.Error(error ?? "Désactivation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task ReactivateAgentAsync(string matricule)
    {
        if (string.IsNullOrEmpty(_agentSite)) return;
        _busy = true;
        try
        {
            var (ok, error) = await Api.ReactivateAgentAsync(_agentSite, matricule);
            if (ok)
            {
                Toasts.Success($"Agent « {matricule} » réactivé.");
                await RefreshAgentsAsync();
            }
            else { Toasts.Error(error ?? "Réactivation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task DeleteAgentAsync(string matricule)
    {
        if (string.IsNullOrEmpty(_agentSite)) return;
        _busy = true;
        try
        {
            var (ok, error) = await Api.DeleteAgentAsync(_agentSite, matricule);
            if (ok)
            {
                Toasts.Success($"Agent « {matricule} » supprimé (archivé).");
                await RefreshAgentsAsync();
            }
            else { Toasts.Error(error ?? "Suppression refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }
}
