@page "/admin"
@layout AdminLayout
@implements IAsyncDisposable
@using NovAcces.Web.Components.Controls.Charts
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>SigasAcces — Administration · Dashboard</PageTitle>

<header class="portal-header">
    <div>
        <h1>Dashboard</h1>
        <p class="muted">
            Connecté : @Auth.DisplayName (@(IsSuperAdmin ? "SuperAdmin" : "Admin") Sigasécurité) ·
            <span class="dot @(_connected ? "dot-on" : "dot-off")"></span>
            @(_connected ? "Temps réel connecté" : "Hors ligne")
        </p>
    </div>
</header>

@* Bandeau de rôle — plus visible que le petit libellé de la barre de
   navigation : le SuperAdmin gère les comptes à privilèges de tous les
   Admin, l'Admin gère l'exploitation courante d'un ou plusieurs sites. La
   distinction doit sauter aux yeux, pas être devinée. *@
<div class="role-banner @(IsSuperAdmin ? "role-banner-super" : "role-banner-admin")">
    <span class="role-banner-icon">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            @if (IsSuperAdmin)
            {
                <path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 14.3 7.2 16.9l.9-5.4L4.2 7.7l5.4-.8z" />
            }
            else
            {
                <path d="M12 2l7 4v6c0 5-3.4 7.4-7 10-3.6-2.6-7-5-7-10V6z" />
            }
        </svg>
    </span>
    <div>
        <strong>@(IsSuperAdmin ? "Vue SuperAdmin" : "Vue Admin")</strong>
        <span class="role-banner-desc">
            @(IsSuperAdmin
                ? "Accès complet : supervision de tous les sites et gestion des comptes à privilèges (Admin/SuperAdmin)."
                : "Gestion opérationnelle des sites, des comptes Hôte/Sûreté et des terminaux.")
        </span>
    </div>
</div>

@if (_overview.Count > 0)
{
    <div class="tiles">
        <div class="tile"><span class="tile-n">@_overview.Count</span><span class="tile-l">Sites actifs</span></div>
        <div class="tile tile-in"><span class="tile-n">@_overview.Sum(s => s.OnSite)</span><span class="tile-l">Présents (tous sites)</span></div>
        <div class="tile"><span class="tile-n">@_overview.Sum(s => s.ScansToday)</span><span class="tile-l">Scans aujourd'hui</span></div>
        <div class="tile"><span class="tile-n">@_overview.Sum(s => s.TerminalsActive) / @_overview.Sum(s => s.TerminalsEnrolled)</span><span class="tile-l">Postes actifs</span></div>
        <div class="tile"><span class="tile-n">@_users.Count(u => !u.IsDeactivated)</span><span class="tile-l">Comptes actifs</span></div>
        <div class="tile @(_alerts.Count > 0 ? "tile-alert" : "")"><span class="tile-n">@_alerts.Count</span><span class="tile-l">Alertes</span></div>
    </div>
}

@if (_loaded && !SetupComplete)
{
    <section class="card" style="border-left:4px solid #f5a300;">
        <h2>Premiers pas (@SetupSteps.Count(s => s.Done)/@SetupSteps.Count)</h2>
        <ol style="margin:0;padding-left:0;line-height:1.9;color:#3c4854;list-style:none;">
            @foreach (var step in SetupSteps)
            {
                <li style="display:flex;align-items:center;gap:.5rem;@(step.Done ? "opacity:.55" : "")">
                    <span aria-hidden="true">@(step.Done ? "✅" : "⬜")</span>
                    <span style="@(step.Done ? "text-decoration:line-through" : "")"><strong>@step.Title</strong> — @step.Description</span>
                    @if (!step.Done)
                    {
                        <a href="@step.LinkHref" class="nav-links" style="display:inline;margin-left:.25rem">@step.LinkLabel →</a>
                    }
                </li>
            }
        </ol>
    </section>
}

@if (_alerts.Count > 0)
{
    <section class="card">
        <h2>Alertes (@_alerts.Count)</h2>
        <div class="overstay-banner">
            @foreach (var a in _alerts)
            {
                <div class="overstay-item @(a.Severity == "security" ? "v-security" : "")">
                    @WarnIcon() <strong>@a.Text</strong>
                    <a href="@a.LinkHref" class="nav-links" style="display:inline">@a.LinkLabel →</a>
                </div>
            }
        </div>
    </section>
}

<div class="cards">
    <section class="card">
        <h2>Vue consolidée multi-sites (@_overview.Count)</h2>
        @if (_overview.Count == 0)
        {
            <div class="empty">
                @EmptyIcon()<p>Aucun site provisionné pour l'instant.</p>
                <a href="/admin/sites" class="btn-ghost" style="max-width:14rem;margin-top:.5rem">Provisionner un site →</a>
            </div>
        }
        else
        {
            <div class="table-wrap">
            <table class="visits">
                <thead>
                    <tr>
                        <th>Site</th><th>Présents</th><th>Scans aujourd'hui</th>
                        <th title="Terminaux ayant scanné dans les 30 dernières minutes, sur le total enrôlé. Un poste « silencieux » peut être hors ligne, éteint, ou simplement sans visiteur — ce n'est pas un monitoring temps réel des postes.">Postes actifs</th>
                        <th title="Scans validés en mode dégradé aujourd'hui : signale une coupure réseau au poste, même si la connexion est revenue depuis.">Dégradés</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in PagedOverview)
                    {
                        <tr>
                            <td><strong>@s.SiteId</strong></td>
                            <td>@s.OnSite</td>
                            <td>@s.ScansToday</td>
                            <td class="@(s.TerminalsEnrolled > 0 && s.TerminalsActive == 0 ? "text-red-700" : "")">
                                @(s.TerminalsEnrolled == 0 ? "—" : $"{s.TerminalsActive} / {s.TerminalsEnrolled}")
                            </td>
                            <td>
                                @if (s.DegradedScansToday > 0)
                                {
                                    <span class="badge badge-degraded">@s.DegradedScansToday</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_overviewPage" PageSize="_overviewPageSize" TotalCount="_overview.Count"
                        OnPageChanged="p => _overviewPage = p" />
        }
    </section>

    <section class="card">
        <h2>Activité récente</h2>
        <div class="field" style="max-width:22rem"><label>Site</label>
            <select @bind="_activitySite" @bind:after="RefreshActivityAsync">
                <option value="">— choisir un site —</option>
                @foreach (var s in _overview)
                {
                    <option value="@s.SiteId">@s.SiteId</option>
                }
            </select>
        </div>
        @if (string.IsNullOrEmpty(_activitySite))
        {
            <p class="hint" style="margin-top:0">Choisissez un site pour voir ses dernières actions.</p>
        }
        else if (_recentActivity.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucune action récente sur ce site.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (var e in _recentActivity)
                {
                    <li class="tl-item">
                        <span class="tl-dot"></span>
                        <div class="tl-label">@e.Action</div>
                        <div class="tl-time">@e.Timestamp.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="tl-detail">@e.Detail</div>
                    </li>
                }
            </ol>
        }
        <p class="hint">Voir le <a href="/admin/audit">journal complet</a>.</p>
    </section>
</div>

@if (IsSuperAdmin)
{
    @* Contenu exclusif SuperAdmin — moindre privilège : un Admin gère son
       exploitation, seul le SuperAdmin a besoin de voir l'ensemble des
       comptes à privilèges (qui peut agir sur qui) pour les gouverner. *@
    <section class="card">
        <h2>Comptes à privilèges (@PrivilegedUsers.Count)</h2>
        <p class="hint" style="margin-top:0">Visible uniquement par le SuperAdmin — gestion des comptes Admin et SuperAdmin.</p>
        @if (PrivilegedUsers.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucun compte à privilèges.</p></div>
        }
        else
        {
            <div class="table-wrap">
            <table class="visits">
                <thead><tr><th>Compte</th><th>Rôle</th><th>Double authentification</th><th>Statut</th></tr></thead>
                <tbody>
                    @foreach (var u in PagedPrivilegedUsers)
                    {
                        <tr>
                            <td><strong>@u.DisplayName</strong><br /><span class="muted">@u.Email</span></td>
                            <td>@(u.Roles.Contains(NovAccesRoles.SuperAdmin) ? "SuperAdmin" : "Admin")</td>
                            <td>@(u.TwoFactorEnabled ? "✅ Activée" : "⬜ Non configurée")</td>
                            <td>@(u.IsDeactivated ? "Désactivé" : "Actif")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_privPage" PageSize="_privPageSize" TotalCount="PrivilegedUsers.Count"
                        OnPageChanged="p => _privPage = p" />
        }
    </section>
}

<section class="card">
    <h2>Analyse &amp; tendances</h2>

    <div class="chart-grid">
        @if (_overview.Count > 0 && _overview.Any(s => s.ScansToday > 0))
        {
            <div class="chart-card">
                <p class="eyebrow" style="margin-top:0">Affluence par site (scans aujourd'hui)</p>
                <BarChart Data="AttendanceBySite" HeightPx="140" />
            </div>
        }

        @if (_users.Count > 0)
        {
            <div class="chart-card chart-card-donut">
                <p class="eyebrow" style="margin-top:0">Répartition des comptes par rôle</p>
                <DonutChart Data="RoleDistribution" CenterValue="@_users.Count.ToString()" CenterLabel="comptes" />
            </div>
        }
    </div>

    <div class="filters" style="margin:1.4rem 0 .9rem">
        <button class="filter @(_trendDays == 7 ? "on" : "")" @onclick="() => SetTrendDaysAsync(7)">7 jours</button>
        <button class="filter @(_trendDays == 30 ? "on" : "")" @onclick="() => SetTrendDaysAsync(30)">30 jours</button>
    </div>

    @if (_trends is null || _trends.Daily.Count == 0 || _trends.Daily.Sum(d => d.ScansTotal) == 0)
    {
        <div class="empty">@EmptyIcon()<p>Pas encore assez de données sur cette période.</p></div>
    }
    else
    {
        <div class="chart-grid">
            <div class="chart-card">
                <p class="eyebrow" style="margin-top:0">Scans par jour</p>
                <BarChart Data="ScansPerDay" HeightPx="130" MaxLabels="10" />
            </div>

            <div class="chart-card">
                <p class="eyebrow" style="margin-top:0">Entrées / Sorties / Refus par jour</p>
                <StackedBarChart Labels="TrendDayLabels" Series="EntryExitDenialSeries" HeightPx="130" MaxLabels="10" ShowLegend="false" />
                <ul class="chartlegend">
                    <li><span class="swatch" style="background:#0f8a3d"></span>Entrées accordées</li>
                    <li><span class="swatch" style="background:#1b5e9e"></span>Sorties</li>
                    <li><span class="swatch" style="background:#f5a300"></span>Refus</li>
                </ul>
            </div>
        </div>

        @if (_trends.BySite.Any(s => s.ScansTotal > 0))
        {
            <div class="chart-grid" style="margin-top:1.4rem">
                <div class="chart-card chart-card-donut">
                    <p class="eyebrow" style="margin-top:0">Répartition par site (@_trendDays derniers jours)</p>
                    <DonutChart Data="SiteDistribution" ShowLegend="true" />
                </div>
            </div>
        }
    }
</section>

@code {
    private bool _loaded;
    private IReadOnlyList<AdminUserDto> _users = Array.Empty<AdminUserDto>();
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();
    private List<Alert> _alerts = new();

    private string _activitySite = "";
    private IReadOnlyList<AdminAuditDto> _recentActivity = Array.Empty<AdminAuditDto>();

    private int _trendDays = 7;
    private AdminTrendsDto? _trends;

    private int _overviewPage = 1;
    private const int _overviewPageSize = 20;
    private IReadOnlyList<AdminSiteOverviewDto> PagedOverview =>
        _overview.Skip((_overviewPage - 1) * _overviewPageSize).Take(_overviewPageSize).ToList();

    private int _privPage = 1;
    private const int _privPageSize = 20;
    private List<AdminUserDto> PrivilegedUsers =>
        _users.Where(u => u.Roles.Contains(NovAccesRoles.Admin) || u.Roles.Contains(NovAccesRoles.SuperAdmin))
              .OrderByDescending(u => u.Roles.Contains(NovAccesRoles.SuperAdmin))
              .ThenBy(u => u.DisplayName)
              .ToList();
    private IReadOnlyList<AdminUserDto> PagedPrivilegedUsers =>
        PrivilegedUsers.Skip((_privPage - 1) * _privPageSize).Take(_privPageSize).ToList();

    private HubConnection? _hub;
    private bool _connected;

    private sealed record Alert(string Severity, string Text, string LinkHref, string LinkLabel);
    private sealed record SetupStep(bool Done, string Title, string Description, string LinkHref, string LinkLabel);

    // SuperAdmin hérite toujours du rôle Admin (voir IdentityStartup) : testé
    // en premier, sinon un SuperAdmin s'afficherait comme simple Admin.
    private bool IsSuperAdmin => Auth.IsInRole(NovAccesRoles.SuperAdmin);

    // Checklist calculée à partir des données déjà chargées (aucun appel API
    // supplémentaire) : reste visible tant que l'installation n'est pas
    // complète, disparaît d'elle-même une fois les 4 étapes franchies.
    private bool SetupComplete => SetupSteps.All(s => s.Done);

    private List<SetupStep> SetupSteps => new()
    {
        new SetupStep(_overview.Count > 0,
            "Provisionner un site", "crée le schéma et le journal inaltérable du client",
            "/admin/sites", "Provisionner"),
        new SetupStep(_overview.Any(s => s.TerminalsEnrolled > 0),
            "Enrôler un terminal", "sans poste enrôlé, aucun contrôle d'accès physique n'est possible",
            "/admin/terminaux", "Enrôler"),
        new SetupStep(_users.Any(u => u.Roles.Contains(NovAccesRoles.Hote)),
            "Créer un compte Hôte", "pour que les visites puissent être invitées",
            "/admin/comptes", "Créer"),
        new SetupStep(_users.Any(u => u.Roles.Contains(NovAccesRoles.Surete)),
            "Créer un compte Sûreté", "pour que les accès puissent être supervisés",
            "/admin/comptes", "Créer"),
    };

    protected override async Task OnInitializedAsync()
    {
        try { _users = await Api.GetUsersAsync(); } catch { /* best-effort */ }
        try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
        try { _trends = await Api.GetTrendsAsync(_trendDays); } catch { /* best-effort */ }
        _alerts = BuildAlerts();
        _loaded = true;

        await ConnectHubAsync();
        await SubscribeToPushAsync();
    }

    // Abonnement WebPush (§7) : réveille l'onglet même FERMÉ pour l'alerte de
    // dépassement — complète ConnectHubAsync ci-dessous, qui ne couvre que
    // l'onglet ouvert (SignalR). Best-effort partout.
    private async Task SubscribeToPushAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("novaccesPush.requestPermission")) return;
            var vapidKey = await Api.GetVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(vapidKey)) return;
            await JS.InvokeVoidAsync("novaccesPush.subscribe", Config["Api:BaseUrl"], vapidKey, Auth.AccessToken);
        }
        catch { /* best-effort */ }
    }

    private async Task SetTrendDaysAsync(int days)
    {
        if (_trendDays == days) return;
        _trendDays = days;
        try { _trends = await Api.GetTrendsAsync(_trendDays); } catch { /* best-effort */ }
    }

    private async Task RefreshActivityAsync()
    {
        _recentActivity = Array.Empty<AdminAuditDto>();
        if (string.IsNullOrEmpty(_activitySite)) return;
        try { _recentActivity = await Api.GetAdminAuditAsync(_activitySite, 8); } catch { /* best-effort */ }
    }

    // Canal SignalR « tous sites » (voir ScanEventsHub.GlobalGroup) : un scan
    // n'importe où déclenche un rafraîchissement de la vue consolidée et des
    // alertes — pas un flux visiteur par visiteur (moindre privilège, voir
    // AdminScanActivityDto), juste « ça a bougé, remets les chiffres à jour ».
    private async Task ConnectHubAsync()
    {
        var apiBase = Config["Api:BaseUrl"]!;

        _hub = new HubConnectionBuilder()
            .WithUrl($"{apiBase}/hubs/scan?global=1", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(Auth.AccessToken);

                if (Env.IsDevelopment())
                {
                    options.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler h)
                            h.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        return handler;
                    };
                    options.WebSocketConfiguration = conf =>
                        conf.RemoteCertificateValidationCallback = (_, _, _, _) => true;
                }
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<AdminScanActivityDto>("AdminActivity", async _ =>
        {
            try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
            _alerts = BuildAlerts();
            await InvokeAsync(StateHasChanged);
        });

        // Signal anonymisé (voir AdminOverstayAlertDto) : pas de nom de
        // visiteur ici, juste "un dépassement est en cours sur tel site".
        _hub.On<AdminOverstayAlertDto>("AdminOverstayAlert", async alert =>
        {
            try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
            _alerts = BuildAlerts();
            try { await JS.InvokeVoidAsync("novaccesBeep", alert.Level); } catch { /* best-effort */ }
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += _ => { _connected = true; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _connected = true;
        }
        catch
        {
            _connected = false;
        }
    }

    // Alertes calculées à partir des données déjà chargées (aucun appel API
    // supplémentaire) : ce qui mérite une action, pas un simple chiffre.
    private List<Alert> BuildAlerts()
    {
        var alerts = new List<Alert>();

        foreach (var s in _overview.Where(s => s.TerminalsEnrolled > 0 && s.TerminalsActive == 0))
            alerts.Add(new Alert("security",
                $"« {s.SiteId} » : aucun poste actif malgré {s.TerminalsEnrolled} terminal(aux) enrôlé(s).",
                "/admin/terminaux", "Voir les terminaux"));

        foreach (var s in _overview.Where(s => s.TerminalsEnrolled == 0))
            alerts.Add(new Alert("warn",
                $"« {s.SiteId} » : aucun terminal enrôlé — le contrôle d'accès physique n'est pas encore opérationnel.",
                "/admin/terminaux", "Enrôler un terminal"));

        // Silence PARTIEL (au moins un poste répond encore) — distinct de la
        // règle ci-dessus qui couvre le cas total. Un poste éteint/hors-ligne
        // n'est pas forcément une panne, mais mérite d'être vérifié.
        foreach (var s in _overview.Where(s => s.TerminalsEnrolled > 0 && s.TerminalsActive > 0 && s.TerminalsActive < s.TerminalsEnrolled))
            alerts.Add(new Alert("warn",
                $"« {s.SiteId} » : {s.TerminalsEnrolled - s.TerminalsActive} poste(s) sur {s.TerminalsEnrolled} silencieux depuis plus de 30 min.",
                "/admin/terminaux", "Voir les terminaux"));

        foreach (var s in _overview.Where(s => s.DegradedScansToday > 0))
            alerts.Add(new Alert("warn",
                $"« {s.SiteId} » : {s.DegradedScansToday} scan(s) validé(s) en mode dégradé aujourd'hui.",
                "/admin/audit", "Voir le journal"));

        if (_trends is not null)
            foreach (var d in _trends.RepeatedDenials)
                alerts.Add(new Alert("security",
                    $"« {d.SiteId} » : « {d.VisitorName} » refusé {d.Count} fois sur les dernières 24h — QR copié ou personne écartée qui insiste ?",
                    "/admin/audit", "Voir le journal"));

        var pendingActivation = _users.Count(u =>
            !u.IsDeactivated && !u.TwoFactorEnabled
            && (u.Roles.Contains(NovAccesRoles.Admin) || u.Roles.Contains(NovAccesRoles.SuperAdmin) || u.Roles.Contains(NovAccesRoles.Surete)));
        if (pendingActivation > 0)
            alerts.Add(new Alert("security",
                $"{pendingActivation} compte(s) à privilèges jamais activé(s) (double authentification non configurée).",
                "/admin/comptes", "Voir les comptes"));

        return alerts;
    }

    // ---- Séries pour les graphiques SVG (BarChart / StackedBarChart / DonutChart) ----

    // Palette catégorielle (site, rôle) délibérément limitée aux teintes navy/ambre
    // de la marque, SANS reprendre --ok/--onsite/--amber utilisées ailleurs pour un
    // état précis (accordé/présent/refus, cf. EntryExitDenialSeries) — un site coloré
    // en vert « ok » ou bleu « présent » laisserait croire à un statut qui n'existe pas.
    private static readonly string[] SitePalette =
        { "#0e2a3a", "#f5a300", "#4f7d8d", "#7a5200", "#7ca1ae", "#ffcf6e", "#123649", "#c98200" };

    private List<ChartPoint> AttendanceBySite =>
        _overview.OrderByDescending(s => s.ScansToday)
            .Select(s => new ChartPoint(s.SiteId, s.ScansToday, Tooltip: $"{s.SiteId} : {s.ScansToday} scan(s), {s.OnSite} présent(s)"))
            .ToList();

    private List<ChartPoint> RoleDistribution
    {
        get
        {
            var superAdmins = _users.Count(u => u.Roles.Contains(NovAccesRoles.SuperAdmin));
            var admins = _users.Count(u => u.Roles.Contains(NovAccesRoles.Admin) && !u.Roles.Contains(NovAccesRoles.SuperAdmin));
            var surete = _users.Count(u => u.Roles.Contains(NovAccesRoles.Surete));
            var hotes = _users.Count(u => u.Roles.Contains(NovAccesRoles.Hote));

            // Dégradé de privilège au sein de chaque famille de teinte : navy pour
            // les rôles opérationnels (Hôte, clair → Sûreté, plus soutenu), ambre
            // pour les rôles d'administration (Admin, clair → SuperAdmin, soutenu).
            return new()
            {
                new("Hôtes", hotes, "#7ca1ae"),
                new("Sûreté", surete, "#123649"),
                new("Admin", admins, "#f5a300"),
                new("SuperAdmin", superAdmins, "#7a5200"),
            };
        }
    }

    private List<string> TrendDayLabels => _trends?.Daily.Select(d => d.Date.ToString("dd/MM")).ToList() ?? new();

    private List<ChartPoint> ScansPerDay =>
        _trends?.Daily.Select(d => new ChartPoint(d.Date.ToString("dd/MM"), d.ScansTotal,
            Tooltip: $"{d.Date:dd/MM} — {d.ScansTotal} scan(s)")).ToList() ?? new();

    private List<ChartSeries> EntryExitDenialSeries => new()
    {
        new("Entrées accordées", "#0f8a3d", _trends?.Daily.Select(d => (double)d.EntriesGranted).ToList() ?? new()),
        new("Sorties", "#1b5e9e", _trends?.Daily.Select(d => (double)d.Exits).ToList() ?? new()),
        new("Refus", "#f5a300", _trends?.Daily.Select(d => (double)d.Denied).ToList() ?? new()),
    };

    private List<ChartPoint> SiteDistribution =>
        _trends?.BySite.OrderByDescending(s => s.ScansTotal)
            .Select((s, i) => new ChartPoint(s.SiteId, s.ScansTotal, SitePalette[i % SitePalette.Length], $"{s.SiteId} : {s.ScansTotal} scan(s)"))
            .ToList() ?? new();

    private static RenderFragment WarnIcon() => builder =>
