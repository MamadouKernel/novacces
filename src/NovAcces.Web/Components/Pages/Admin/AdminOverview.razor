@page "/admin"
@layout AdminLayout
@implements IAsyncDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject IConfiguration Config
@inject IWebHostEnvironment Env

<PageTitle>NovAcces — Administration · Dashboard</PageTitle>

<header class="portal-header">
    <div>
        <h1>Dashboard</h1>
        <p class="muted">
            Connecté : @Auth.DisplayName (Admin Sigasécurité) ·
            <span class="dot @(_connected ? "dot-on" : "dot-off")"></span>
            @(_connected ? "Temps réel connecté" : "Hors ligne")
        </p>
    </div>
</header>

@if (_overview.Count > 0)
{
    <div class="tiles">
        <div class="tile"><span class="tile-n">@_overview.Count</span><span class="tile-l">Sites actifs</span></div>
        <div class="tile tile-in"><span class="tile-n">@_overview.Sum(s => s.OnSite)</span><span class="tile-l">Présents (tous sites)</span></div>
        <div class="tile"><span class="tile-n">@_overview.Sum(s => s.ScansToday)</span><span class="tile-l">Scans aujourd'hui</span></div>
        <div class="tile"><span class="tile-n">@_overview.Sum(s => s.TerminalsActive) / @_overview.Sum(s => s.TerminalsEnrolled)</span><span class="tile-l">Postes actifs</span></div>
        <div class="tile"><span class="tile-n">@_users.Count(u => !u.IsDeactivated)</span><span class="tile-l">Comptes actifs</span></div>
        <div class="tile @(_alerts.Count > 0 ? "tile-alert" : "")"><span class="tile-n">@_alerts.Count</span><span class="tile-l">Alertes</span></div>
    </div>
}

@if (_loaded && _overview.Count == 0 && _users.Count <= 1)
{
    <section class="card" style="border-left:4px solid #f5a300;">
        <h2>Bienvenue — démarrage en 2 étapes</h2>
        <ol style="margin:0;padding-left:1.2rem;line-height:1.9;color:#3c4854;">
            <li><strong>Provisionnez un site</strong> (section « Sites ») : tapez le nom du client, l'identifiant technique est généré tout seul.</li>
            <li><strong>Créez un compte Hôte et un compte Sûreté</strong> pour ce site (section « Comptes ») : ils pourront alors inviter des visiteurs et superviser les accès.</li>
        </ol>
    </section>
}

@if (_alerts.Count > 0)
{
    <section class="card">
        <h2>Alertes (@_alerts.Count)</h2>
        <div class="overstay-banner">
            @foreach (var a in _alerts)
            {
                <div class="overstay-item @(a.Severity == "security" ? "v-security" : "")">
                    @WarnIcon() <strong>@a.Text</strong>
                    <a href="@a.LinkHref" class="nav-links" style="display:inline">@a.LinkLabel →</a>
                </div>
            }
        </div>
    </section>
}

<div class="cards">
    <section class="card">
        <h2>Vue consolidée multi-sites (@_overview.Count)</h2>
        @if (_overview.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucun site provisionné pour l'instant.</p></div>
        }
        else
        {
            <div class="table-wrap">
            <table class="visits">
                <thead>
                    <tr>
                        <th>Site</th><th>Présents</th><th>Scans aujourd'hui</th>
                        <th title="Terminaux ayant scanné dans les 30 dernières minutes, sur le total enrôlé. Un poste « silencieux » peut être hors ligne, éteint, ou simplement sans visiteur — ce n'est pas un monitoring temps réel des postes.">Postes actifs</th>
                        <th title="Scans validés en mode dégradé aujourd'hui : signale une coupure réseau au poste, même si la connexion est revenue depuis.">Dégradés</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _overview)
                    {
                        <tr>
                            <td><strong>@s.SiteId</strong></td>
                            <td>@s.OnSite</td>
                            <td>@s.ScansToday</td>
                            <td class="@(s.TerminalsEnrolled > 0 && s.TerminalsActive == 0 ? "text-red-700" : "")">
                                @(s.TerminalsEnrolled == 0 ? "—" : $"{s.TerminalsActive} / {s.TerminalsEnrolled}")
                            </td>
                            <td>
                                @if (s.DegradedScansToday > 0)
                                {
                                    <span class="badge badge-degraded">@s.DegradedScansToday</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    <section class="card">
        <h2>Activité récente</h2>
        <div class="field" style="max-width:22rem"><label>Site</label>
            <select @bind="_activitySite" @bind:after="RefreshActivityAsync">
                <option value="">— choisir un site —</option>
                @foreach (var s in _overview)
                {
                    <option value="@s.SiteId">@s.SiteId</option>
                }
            </select>
        </div>
        @if (string.IsNullOrEmpty(_activitySite))
        {
            <p class="hint" style="margin-top:0">Choisissez un site pour voir ses dernières actions.</p>
        }
        else if (_recentActivity.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucune action récente sur ce site.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (var e in _recentActivity)
                {
                    <li class="tl-item">
                        <span class="tl-dot"></span>
                        <div class="tl-label">@e.Action</div>
                        <div class="tl-time">@e.Timestamp.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="tl-detail">@e.Detail</div>
                    </li>
                }
            </ol>
        }
        <p class="hint">Voir le <a href="/admin/audit">journal complet</a>.</p>
    </section>
</div>

@if (_overview.Count > 0 && _overview.Any(s => s.ScansToday > 0))
{
    var maxScans = _overview.Max(s => s.ScansToday);
    <section class="card">
        <h2>Affluence par site (scans aujourd'hui)</h2>
        <div class="chart">
            @foreach (var s in _overview.OrderByDescending(s => s.ScansToday))
            {
                <div class="chart-row">
                    <span class="chart-label">@s.SiteId</span>
                    <div class="chart-track">
                        <div class="chart-fill @(s.ScansToday == maxScans ? "peak" : "")"
                             style="width:@(maxScans > 0 ? (int)Math.Round(s.ScansToday * 100.0 / maxScans) : 0)%"></div>
                    </div>
                    <span class="chart-val">@s.ScansToday scans · @s.OnSite présents</span>
                </div>
            }
        </div>
    </section>
}

<section class="card">
    <h2>Tendance d'activité</h2>
    <div class="filters" style="margin-bottom:.9rem">
        <button class="filter @(_trendDays == 7 ? "on" : "")" @onclick="() => SetTrendDaysAsync(7)">7 jours</button>
        <button class="filter @(_trendDays == 30 ? "on" : "")" @onclick="() => SetTrendDaysAsync(30)">30 jours</button>
    </div>

    @if (_trends is null || _trends.Daily.Count == 0 || _trends.Daily.Sum(d => d.ScansTotal) == 0)
    {
        <div class="empty">@EmptyIcon()<p>Pas encore assez de données sur cette période.</p></div>
    }
    else
    {
        var maxScans2 = Math.Max(1, _trends.Daily.Max(d => d.ScansTotal));
        <p class="eyebrow" style="margin-top:0">Scans par jour</p>
        <div class="hchart">
            @foreach (var d in _trends.Daily)
            {
                <div class="hbar @(d.ScansTotal == maxScans2 ? "peak" : "")"
                     style="height:@(Math.Max(2, (int)Math.Round(d.ScansTotal * 100.0 / maxScans2)))%"
                     title="@d.Date.ToString("dd/MM") — @d.ScansTotal scan(s)"></div>
            }
        </div>
        <div class="hchart-axis">
            <span>@_trends.Daily.First().Date.ToString("dd/MM")</span>
            <span>@_trends.Daily.Last().Date.ToString("dd/MM")</span>
        </div>

        <p class="eyebrow" style="margin-top:1.6rem">Entrées / Sorties / Refus par jour</p>
        var maxStack = Math.Max(1, _trends.Daily.Max(d => d.EntriesGranted + d.Exits + d.Denied));
        <div class="stack-chart">
            @foreach (var d in _trends.Daily)
            {
                var total = d.EntriesGranted + d.Exits + d.Denied;
                <div class="stack-bar" style="height:@(Math.Max(2, (int)Math.Round(total * 100.0 / maxStack)))%"
                     title="@d.Date.ToString("dd/MM") — @d.EntriesGranted entrée(s), @d.Exits sortie(s), @d.Denied refus">
                    @if (total > 0)
                    {
                        <div class="stack-seg seg-denied" style="height:@(d.Denied * 100.0 / total)%"></div>
                        <div class="stack-seg seg-exit" style="height:@(d.Exits * 100.0 / total)%"></div>
                        <div class="stack-seg seg-entry" style="height:@(d.EntriesGranted * 100.0 / total)%"></div>
                    }
                </div>
            }
        </div>
        <div class="stack-legend">
            <span><span class="sw bg-ok"></span>Entrées accordées</span>
            <span><span class="sw bg-onsite"></span>Sorties</span>
            <span><span class="sw bg-amber-500"></span>Refus</span>
        </div>
    }

    @if (_trends is not null && _trends.BySite.Any(s => s.ScansTotal > 0))
    {
        var maxSite = _trends.BySite.Max(s => s.ScansTotal);
        <p class="eyebrow" style="margin-top:1.6rem">Répartition par site (@_trendDays derniers jours)</p>
        <div class="chart">
            @foreach (var s in _trends.BySite)
            {
                <div class="chart-row">
                    <span class="chart-label">@s.SiteId</span>
                    <div class="chart-track">
                        <div class="chart-fill @(s.ScansTotal == maxSite ? "peak" : "")"
                             style="width:@(maxSite > 0 ? (int)Math.Round(s.ScansTotal * 100.0 / maxSite) : 0)%"></div>
                    </div>
                    <span class="chart-val">@s.ScansTotal scan(s)</span>
                </div>
            }
        </div>
    }
</section>

@code {
    private bool _loaded;
    private IReadOnlyList<AdminUserDto> _users = Array.Empty<AdminUserDto>();
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();
    private List<Alert> _alerts = new();

    private string _activitySite = "";
    private IReadOnlyList<AdminAuditDto> _recentActivity = Array.Empty<AdminAuditDto>();

    private int _trendDays = 7;
    private AdminTrendsDto? _trends;

    private HubConnection? _hub;
    private bool _connected;

    private sealed record Alert(string Severity, string Text, string LinkHref, string LinkLabel);

    protected override async Task OnInitializedAsync()
    {
        try { _users = await Api.GetUsersAsync(); } catch { /* best-effort */ }
        try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
        try { _trends = await Api.GetTrendsAsync(_trendDays); } catch { /* best-effort */ }
        _alerts = BuildAlerts();
        _loaded = true;

        await ConnectHubAsync();
    }

    private async Task SetTrendDaysAsync(int days)
    {
        if (_trendDays == days) return;
        _trendDays = days;
        try { _trends = await Api.GetTrendsAsync(_trendDays); } catch { /* best-effort */ }
    }

    private async Task RefreshActivityAsync()
    {
        _recentActivity = Array.Empty<AdminAuditDto>();
        if (string.IsNullOrEmpty(_activitySite)) return;
        try { _recentActivity = await Api.GetAdminAuditAsync(_activitySite, 8); } catch { /* best-effort */ }
    }

    // Canal SignalR « tous sites » (voir ScanEventsHub.GlobalGroup) : un scan
    // n'importe où déclenche un rafraîchissement de la vue consolidée et des
    // alertes — pas un flux visiteur par visiteur (moindre privilège, voir
    // AdminScanActivityDto), juste « ça a bougé, remets les chiffres à jour ».
    private async Task ConnectHubAsync()
    {
        var apiBase = Config["Api:BaseUrl"]!;

        _hub = new HubConnectionBuilder()
            .WithUrl($"{apiBase}/hubs/scan?global=1", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(Auth.AccessToken);

                if (Env.IsDevelopment())
                {
                    options.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler h)
                            h.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        return handler;
                    };
                    options.WebSocketConfiguration = conf =>
                        conf.RemoteCertificateValidationCallback = (_, _, _, _) => true;
                }
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<AdminScanActivityDto>("AdminActivity", async _ =>
        {
            try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
            _alerts = BuildAlerts();
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += _ => { _connected = true; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _connected = true;
        }
        catch
        {
            _connected = false;
        }
    }

    // Alertes calculées à partir des données déjà chargées (aucun appel API
    // supplémentaire) : ce qui mérite une action, pas un simple chiffre.
    private List<Alert> BuildAlerts()
    {
        var alerts = new List<Alert>();

        foreach (var s in _overview.Where(s => s.TerminalsEnrolled > 0 && s.TerminalsActive == 0))
            alerts.Add(new Alert("security",
                $"« {s.SiteId} » : aucun poste actif malgré {s.TerminalsEnrolled} terminal(aux) enrôlé(s).",
                "/admin/terminaux", "Voir les terminaux"));

        foreach (var s in _overview.Where(s => s.TerminalsEnrolled == 0))
            alerts.Add(new Alert("warn",
                $"« {s.SiteId} » : aucun terminal enrôlé — le contrôle d'accès physique n'est pas encore opérationnel.",
                "/admin/terminaux", "Enrôler un terminal"));

        foreach (var s in _overview.Where(s => s.DegradedScansToday > 0))
            alerts.Add(new Alert("warn",
                $"« {s.SiteId} » : {s.DegradedScansToday} scan(s) validé(s) en mode dégradé aujourd'hui.",
                "/admin/audit", "Voir le journal"));

        var pendingActivation = _users.Count(u =>
            !u.IsDeactivated && !u.TwoFactorEnabled
            && (u.Roles.Contains(NovAccesRoles.Admin) || u.Roles.Contains(NovAccesRoles.SuperAdmin) || u.Roles.Contains(NovAccesRoles.Surete)));
        if (pendingActivation > 0)
            alerts.Add(new Alert("security",
                $"{pendingActivation} compte(s) à privilèges jamais activé(s) (double authentification non configurée).",
                "/admin/comptes", "Voir les comptes"));

        return alerts;
    }

    private static RenderFragment WarnIcon() => builder =>
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor'
            stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='display:inline;vertical-align:-2px;margin-right:.3rem'>
            <path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/>
            <line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>");

    private static RenderFragment EmptyIcon() => builder =>
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor'
            stroke-width='1.6' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M21 21l-4.3-4.3'/></svg>");

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
