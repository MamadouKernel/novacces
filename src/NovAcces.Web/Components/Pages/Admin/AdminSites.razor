@page "/admin/sites"
@layout AdminLayout
@implements IDisposable
@inject NovAccesApiClient Api
@inject ToastService Toasts
@inject AuthState Auth
@inject IJSRuntime JS
@inject AdminLiveUpdates Live

<PageTitle>SigasAcces — Administration · Sites</PageTitle>

<header class="portal-header">
    <div>
        <h1>Sites</h1>
        <p class="muted">Provisionnement des sites clients de Sigasécurité.</p>
    </div>
</header>

<section class="card">
    <h2>Provisionner un site</h2>
    <p class="muted">Crée le schéma, le modèle de données et le journal append-only.</p>
    <div class="field"><label>Nom du site</label>
        <input @bind="_siteInput" @bind:event="oninput"
               placeholder="ex. Côte d'Ivoire Terminal" /></div>
    @if (!string.IsNullOrWhiteSpace(_siteInput))
    {
        <p class="hint" style="margin-top:-.6rem">
            Identifiant technique : <code>@SiteSlugValue</code>
            <span class="muted"> — minuscules, sans espaces ni accents (a-z, 0-9, _).</span>
        </p>
    }
    else
    {
        <p class="hint" style="margin-top:-.6rem">
            Tapez le nom du client — l'identifiant technique est généré automatiquement.
        </p>
    }
    <button class="btn-primary" @onclick="ProvisionAsync"
            disabled="@(_busy || string.IsNullOrEmpty(SiteSlugValue))">
        @(string.IsNullOrEmpty(SiteSlugValue) ? "Provisionner" : $"Provisionner « {SiteSlugValue} »")
    </button>
    @if (_siteMsg is not null) { <p class="@(_siteOk ? "info" : "error")">@_siteMsg</p> }
</section>

<section class="card">
    <h2>Sites provisionnés (@_overview.Count)</h2>
    @if (_overview.Count == 0)
    {
        <div class="empty">@EmptyIcon()<p>Aucun site provisionné pour l'instant.</p></div>
    }
    else
    {
        <div class="field" style="max-width:22rem"><label>Rechercher</label>
            <input @bind="_search" @bind:event="oninput" @bind:after="() => _sitesPage = 1" placeholder="Identifiant de site…" /></div>
        <div class="filters" style="margin-bottom:.9rem">
            <button class="filter @(_statusFilter == "all" ? "on" : "")" @onclick='() => SetStatusFilter("all")'>Tous <span class="count">@_overview.Count</span></button>
            <button class="filter @(_statusFilter == "active" ? "on" : "")" @onclick='() => SetStatusFilter("active")'>Actifs <span class="count">@_overview.Count(s => s.IsActive)</span></button>
            <button class="filter @(_statusFilter == "inactive" ? "on" : "")" @onclick='() => SetStatusFilter("inactive")'>Désactivés <span class="count">@_overview.Count(s => !s.IsActive)</span></button>
        </div>
        @if (FilteredSites.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucun site ne correspond à ce filtre.</p></div>
        }
        else
        {
        <div class="table-wrap">
        <table class="visits">
            <thead><tr>
                <SortableTh Column="site" SortColumn="_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Site</SortableTh>
                <SortableTh Column="statut" SortColumn="_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Statut</SortableTh>
                <SortableTh Column="presents" SortColumn="_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Présents</SortableTh>
                <SortableTh Column="scans" SortColumn="_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Scans aujourd'hui</SortableTh>
                <th></th>
            </tr></thead>
            <tbody>
                @foreach (var s in PagedSites)
                {
                    <tr>
                        <td><strong>@s.SiteId</strong></td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge badge-onsite">Actif</span>
                            }
                            else
                            {
                                <span class="badge badge-revoked" title="@s.DeactivationReason">Désactivé</span>
                            }
                        </td>
                        <td>@s.OnSite</td>
                        <td>@s.ScansToday</td>
                        <td style="white-space:nowrap">
                            @if (_actingSiteId == s.SiteId)
                            {
                                @if (s.IsActive)
                                {
                                    <div class="field" style="margin:0"><label>Motif (5 à 500 caractères)</label>
                                        <input @bind="_deactivateReason" placeholder="ex. Contrat non reconduit" /></div>
                                    <button class="btn-danger" @onclick="() => DeactivateAsync(s.SiteId)" disabled="@_busy">Confirmer</button>
                                    <button class="btn-ghost" @onclick="() => _actingSiteId = null">Annuler</button>
                                }
                                else
                                {
                                    <button class="btn-primary" @onclick="() => ReactivateAsync(s.SiteId)" disabled="@_busy">Confirmer la réactivation</button>
                                    <button class="btn-ghost" @onclick="() => _actingSiteId = null">Annuler</button>
                                }
                            }
                            else if (s.IsActive)
                            {
                                <button class="btn-ghost" @onclick="() => StartDeactivate(s.SiteId)" disabled="@_busy">Désactiver</button>
                                <button class="btn-ghost" @onclick="() => ExportAsync(s.SiteId)" disabled="@_busy">Exporter</button>
                            }
                            else
                            {
                                @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
                                {
                                    <button class="btn-ghost" @onclick="() => _actingSiteId = s.SiteId" disabled="@_busy">Réactiver</button>
                                }
                                <button class="btn-ghost" @onclick="() => ExportAsync(s.SiteId)" disabled="@_busy">Exporter</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <Pagination Page="_sitesPage" PageSize="_sitesPageSize" TotalCount="FilteredSites.Count"
                    OnPageChanged="p => _sitesPage = p" />
        }
        <p class="hint">Détail par poste et affluence : voir « Dashboard ». La réactivation d'un site désactivé est réservée au SuperAdmin.</p>
    }
</section>

@code {
    private bool _busy;
    private string _siteInput = "";
    private string SiteSlugValue => SiteSlug.From(_siteInput);
    private string? _siteMsg; private bool _siteOk;
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();

    private string? _actingSiteId;
    private string _deactivateReason = "";
    private int _sitesPage = 1;
    private const int _sitesPageSize = 20;

    private string _search = "";
    private string _statusFilter = "all";
    private string? _sortColumn;
    private bool _sortAscending = true;

    private List<AdminSiteOverviewDto> FilteredSites =>
        _overview
            .Where(s => _statusFilter switch { "active" => s.IsActive, "inactive" => !s.IsActive, _ => true })
            .Where(s => string.IsNullOrWhiteSpace(_search) || s.SiteId.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private IEnumerable<AdminSiteOverviewDto> SortedSites => _sortColumn switch
    {
        "site" => _sortAscending ? FilteredSites.OrderBy(s => s.SiteId) : FilteredSites.OrderByDescending(s => s.SiteId),
        "statut" => _sortAscending ? FilteredSites.OrderBy(s => s.IsActive) : FilteredSites.OrderByDescending(s => s.IsActive),
        "presents" => _sortAscending ? FilteredSites.OrderBy(s => s.OnSite) : FilteredSites.OrderByDescending(s => s.OnSite),
        "scans" => _sortAscending ? FilteredSites.OrderBy(s => s.ScansToday) : FilteredSites.OrderByDescending(s => s.ScansToday),
        _ => FilteredSites
    };

    private IReadOnlyList<AdminSiteOverviewDto> PagedSites =>
        SortedSites.Skip((_sitesPage - 1) * _sitesPageSize).Take(_sitesPageSize).ToList();

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _sitesPage = 1;
    }

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _sitesPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await Live.EnsureConnectedAsync();
        Live.EntityChanged += OnEntityChanged;
    }

    private async Task RefreshAsync()
    {
        try { _overview = await Api.GetSiteOverviewAsync(); } catch { /* best-effort */ }
    }

    private void OnEntityChanged(string kind)
    {
        if (kind != "sites") return;
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
    }

    public void Dispose() => Live.EntityChanged -= OnEntityChanged;

    private static RenderFragment EmptyIcon() => builder =>
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor'
            stroke-width='1.6' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M21 21l-4.3-4.3'/></svg>");

    private async Task ProvisionAsync()
    {
        var slug = SiteSlugValue;
        if (string.IsNullOrEmpty(slug))
        {
            _siteOk = false; _siteMsg = "Saisissez un nom de site.";
            return;
        }

        _busy = true; _siteMsg = null;
        try
        {
            var (ok, error) = await Api.ProvisionSiteAsync(slug);
            _siteOk = ok;
            _siteMsg = ok ? $"Site « {slug} » provisionné." : error;
            if (ok)
            {
                Toasts.Success($"Site « {slug} » provisionné.");
                _siteInput = "";
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Provisionnement refusé."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private void StartDeactivate(string siteId)
    {
        _actingSiteId = siteId;
        _deactivateReason = "";
    }

    private async Task DeactivateAsync(string siteId)
    {
        var reason = _deactivateReason.Trim();
        if (reason.Length is < 5 or > 500)
        {
            Toasts.Error("Le motif doit faire entre 5 et 500 caractères.");
            return;
        }

        _busy = true;
        try
        {
            var (ok, error) = await Api.DeactivateSiteAsync(siteId, reason);
            if (ok)
            {
                Toasts.Success($"Site « {siteId} » désactivé.");
                _actingSiteId = null;
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Désactivation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task ExportAsync(string siteId)
    {
        _busy = true;
        try
        {
            var bytes = await Api.ExportSiteAsync(siteId);
            if (bytes is null)
            {
                Toasts.Error("Export refusé ou service indisponible.");
                return;
            }

            var filename = $"export-{siteId}-{DateTime.Now:yyyyMMdd-HHmm}.zip";
            await JS.InvokeVoidAsync("novaccesDownloadBase64", filename, Convert.ToBase64String(bytes), "application/zip");
            Toasts.Success($"Export de « {siteId} » téléchargé.");
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task ReactivateAsync(string siteId)
    {
        _busy = true;
        try
        {
            var (ok, error) = await Api.ReactivateSiteAsync(siteId);
            if (ok)
            {
                Toasts.Success($"Site « {siteId} » réactivé.");
                _actingSiteId = null;
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Réactivation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }
}
