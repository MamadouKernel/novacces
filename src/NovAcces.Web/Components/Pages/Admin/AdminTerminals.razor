@page "/admin/terminaux"
@layout AdminLayout
@implements IDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject ToastService Toasts
@inject AdminLiveUpdates Live

<PageTitle>SigasAcces — Administration · Terminaux</PageTitle>

<header class="portal-header">
    <div>
        <h1>Terminaux</h1>
        <p class="muted">Chaque terminal est activé avec un QR temporaire à usage unique. La clé API est remise automatiquement au téléphone et n'est jamais affichée dans cette console.</p>
    </div>
</header>

<section class="card">
    @if (_lastEnrollmentTicket is not null)
    {
        <div class="field" style="background:#fff8e6;border:1px solid var(--brand-amber, #F5A300);border-radius:8px;padding:1rem;margin-bottom:1rem;text-align:center;">
            <p style="margin:0 0 .4rem;font-weight:600;">QR d'enrôlement — « @_lastEnrollmentTicket.Label »</p>
            <img class="qr" style="width:220px;height:220px;margin:.7rem auto;background:#fff;padding:.5rem;" src="@QrImage.ToDataUri(_lastEnrollmentTicket.QrPayload)" alt="QR d'enrôlement du terminal" />
            <p class="hint" style="margin:.5rem 0 0;">Scannez ce QR depuis l'application mobile. Il expire le @_lastEnrollmentTicket.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy à HH:mm:ss") et ne peut être utilisé qu'une seule fois.</p>
            <p class="hint" style="margin:.5rem 0 0;">Code de secours : <code>@_lastEnrollmentTicket.Ticket</code></p>
            <button class="btn-ghost" style="margin-top:.7rem" @onclick="() => _lastEnrollmentTicket = null">Fermer</button>
        </div>
    }

    <div class="row">
        <div class="field"><label>Libellé</label>
            <input @bind="_newTerminal.Label" placeholder="ex. Poste Entrée A" /></div>
    </div>
    <div class="field">
        <label>@(_multiSite ? "Sites autorisés" : "Site")</label>
        @if (_overview.Count == 0)
        {
            <p class="hint">Aucun site provisionné — voir la section « Sites ».</p>
        }
        else if (!_multiSite)
        {
            <select @bind="_singleSiteId" @bind:after="SyncSingleSite">
                <option value="">— choisir un site —</option>
                @foreach (var s in _overview)
                {
                    <option value="@s.SiteId">@s.SiteId</option>
                }
            </select>
            <p class="hint">Poste de contrôle fixe : ce terminal ne servira que ce site, sans sélecteur côté agent.</p>
        }
        else
        {
            <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.3rem;">
                @foreach (var s in _overview)
                {
                    <label style="display:flex;align-items:center;gap:.35rem;font-weight:400;">
                        <input type="checkbox" checked="@_newTerminal.SiteIds.Contains(s.SiteId)"
                               @onchange="e => ToggleTerminalSite(s.SiteId, e.Value is bool b && b)" />
                        @s.SiteId
                    </label>
                }
            </div>
            <p class="hint">Terminal itinérant : l'agent choisit le site à la prise de poste.</p>
        }
        <label style="display:flex;align-items:center;gap:.4rem;margin-top:.6rem;font-weight:400;font-size:0.82rem;" class="muted">
            <input type="checkbox" checked="@_multiSite" @onchange="e => ToggleMultiSite(e.Value is bool b && b)" />
            Terminal itinérant — dessert plusieurs sites (cas rare : superviseur mobile, poste de secours)
        </label>
    </div>
    <button class="btn-primary" @onclick="CreateTerminalAsync" disabled="@_busy">Enrôler le terminal</button>
    @if (_terminalMsg is not null) { <p class="@(_terminalOk ? "info" : "error")">@_terminalMsg</p> }

    <div class="field" style="max-width:22rem;margin-top:1rem"><label>Rechercher</label>
        <input @bind="_search" @bind:event="oninput" @bind:after="() => _terminalsPage = 1" placeholder="Libellé ou site…" /></div>
    <div class="filters" style="margin-bottom:.9rem">
        <button class="filter @(_statusFilter == "all" ? "on" : "")" @onclick='() => SetStatusFilter("all")'>Tous <span class="count">@_terminals.Count</span></button>
        <button class="filter @(_statusFilter == "active" ? "on" : "")" @onclick='() => SetStatusFilter("active")'>Actifs <span class="count">@_terminals.Count(t => StatusKey(t) == "active")</span></button>
        <button class="filter @(_statusFilter == "pending" ? "on" : "")" @onclick='() => SetStatusFilter("pending")'>En attente <span class="count">@_terminals.Count(t => StatusKey(t) == "pending")</span></button>
        <button class="filter @(_statusFilter == "expired_ticket" ? "on" : "")" @onclick='() => SetStatusFilter("expired_ticket")'>Ticket expiré <span class="count">@_terminals.Count(t => StatusKey(t) == "expired_ticket")</span></button>
        <button class="filter @(_statusFilter == "revoked" ? "on" : "")" @onclick='() => SetStatusFilter("revoked")'>Révoqués <span class="count">@_terminals.Count(t => StatusKey(t) == "revoked")</span></button>
        @if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
        {
            <button class="filter @(_statusFilter == "archived" ? "on" : "")" @onclick='() => SetStatusFilter("archived")'>Archivés <span class="count">@_archivedTerminals.Count</span></button>
        }
    </div>

    @if (_statusFilter == "archived")
    {
        <p class="hint">Terminaux supprimés : conservés en base pour la traçabilité, lecture seule — l'appareil physique est réenrôlable comme un nouveau terminal.</p>
        <div class="table-wrap">
        <table class="visits">
            <thead><tr><th>Libellé</th><th>Sites</th><th>Supprimé le</th><th>Par</th></tr></thead>
            <tbody>
                @foreach (var t in PagedArchivedTerminals)
                {
                    <tr>
                        <td><strong>@t.Label</strong></td>
                        <td class="muted">@string.Join(", ", t.SiteIds)</td>
                        <td>@t.DeletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="muted">@(t.DeletedBy ?? "—")</td>
                    </tr>
                }
                @if (FilteredArchivedTerminals.Count == 0)
                {
                    <tr><td colspan="4" class="muted">Aucun terminal archivé.</td></tr>
                }
            </tbody>
        </table>
        </div>
        <Pagination Page="_archivedPage" PageSize="_terminalsPageSize" TotalCount="FilteredArchivedTerminals.Count"
                    OnPageChanged="p => _archivedPage = p" />
    }
    else
    {
    <div class="table-wrap">
    <table class="visits">
        <thead><tr>
            <SortableTh Column="libelle" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Libellé</SortableTh>
            <th>Sites</th>
            <SortableTh Column="statut" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Statut</SortableTh>
            <SortableTh Column="cree" SortColumn="@_sortColumn" SortAscending="_sortAscending" OnSort="SortBy">Créé le</SortableTh>
            <th></th>
        </tr></thead>
        <tbody>
            @foreach (var t in PagedTerminals)
            {
                <tr>
                    <td><strong>@t.Label</strong></td>
                    <td class="muted">@string.Join(", ", t.SiteIds)</td>
                    <td><span class="badge @StatusBadgeClass(t)">@StatusLabel(t)</span></td>
                    <td class="muted">@t.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (t.IsActive)
                        {
                            <button class="btn-danger" @onclick="() => RevokeTerminalAsync(t.Id)" disabled="@_busy">Révoquer</button>
                            <button class="btn-ghost" @onclick="() => CreateEnrollmentTicketForTerminalAsync(t.Id)" disabled="@_busy">
                                @(StatusKey(t) == "expired_ticket" ? "Régénérer le QR" : "Nouveau QR")
                            </button>
                        }
                        else
                        {
                            <button class="btn-danger" @onclick="() => DeleteTerminalAsync(t.Id)" disabled="@_busy">Supprimer</button>
                        }
                    </td>
                </tr>
            }
            @if (FilteredTerminals.Count == 0)
            {
                <tr><td colspan="5" class="muted">@(_terminals.Count == 0 ? "Aucun terminal enrôlé." : "Aucun terminal ne correspond à ce filtre.")</td></tr>
            }
        </tbody>
    </table>
    </div>
    <Pagination Page="_terminalsPage" PageSize="_terminalsPageSize" TotalCount="FilteredTerminals.Count"
                OnPageChanged="p => _terminalsPage = p" />
    }
</section>

@code {
    private bool _busy;
    private IReadOnlyList<AdminSiteOverviewDto> _overview = Array.Empty<AdminSiteOverviewDto>();
    private int _terminalsPage = 1;
    private const int _terminalsPageSize = 20;

    private string _search = "";
    private string _statusFilter = "all";
    private string? _sortColumn;
    private bool _sortAscending = true;

    // "expired_ticket" distingue un terminal encore en attente MAIS dont le
    // dernier QR d'enrôlement a expiré sans avoir été scanné — auparavant
    // indiscernable de "pending" (bug du 05/08/2026 : le statut restait
    // "En attente" indéfiniment, sans aucun moyen de voir qu'il fallait
    // régénérer un QR).
    private static string StatusKey(TerminalSummaryDto t)
    {
        if (!t.IsActive) return "revoked";
        if (t.IsEnrolled) return "active";
        if (t.PendingTicketExpiresAt is { } expires && expires <= DateTimeOffset.UtcNow) return "expired_ticket";
        return "pending";
    }

    private static string StatusLabel(TerminalSummaryDto t) => StatusKey(t) switch
    {
        "active" => "Actif",
        "expired_ticket" => "Ticket expiré",
        "revoked" => "Révoqué",
        _ => "En attente",
    };

    private static string StatusBadgeClass(TerminalSummaryDto t) => StatusKey(t) switch
    {
        "active" => "badge-valid",
        "expired_ticket" => "badge-expired",
        "revoked" => "badge-revoked",
        _ => "badge-pending",
    };

    private List<TerminalSummaryDto> FilteredTerminals =>
        _terminals
            .Where(t => _statusFilter == "all" || StatusKey(t) == _statusFilter)
            .Where(t => string.IsNullOrWhiteSpace(_search)
                || t.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || t.SiteIds.Any(s => s.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    private IEnumerable<TerminalSummaryDto> SortedTerminals => _sortColumn switch
    {
        "libelle" => _sortAscending ? FilteredTerminals.OrderBy(t => t.Label) : FilteredTerminals.OrderByDescending(t => t.Label),
        "statut" => _sortAscending ? FilteredTerminals.OrderBy(t => StatusKey(t)) : FilteredTerminals.OrderByDescending(t => StatusKey(t)),
        "cree" => _sortAscending ? FilteredTerminals.OrderBy(t => t.CreatedAt) : FilteredTerminals.OrderByDescending(t => t.CreatedAt),
        _ => FilteredTerminals
    };

    private IReadOnlyList<TerminalSummaryDto> PagedTerminals =>
        SortedTerminals.Skip((_terminalsPage - 1) * _terminalsPageSize).Take(_terminalsPageSize).ToList();

    private List<ArchivedTerminalSummaryDto> FilteredArchivedTerminals =>
        _archivedTerminals
            .Where(t => string.IsNullOrWhiteSpace(_search)
                || t.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || t.SiteIds.Any(s => s.Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    private IReadOnlyList<ArchivedTerminalSummaryDto> PagedArchivedTerminals =>
        FilteredArchivedTerminals.Skip((_archivedPage - 1) * _terminalsPageSize).Take(_terminalsPageSize).ToList();

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
        _terminalsPage = 1;
    }

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _terminalsPage = 1;
        _archivedPage = 1;
    }

    private sealed class NewTerminal { public string Label = ""; public HashSet<string> SiteIds = new(); }
    private readonly NewTerminal _newTerminal = new();
    private bool _multiSite;
    private string _singleSiteId = "";
    private IReadOnlyList<TerminalSummaryDto> _terminals = Array.Empty<TerminalSummaryDto>();
    private IReadOnlyList<ArchivedTerminalSummaryDto> _archivedTerminals = Array.Empty<ArchivedTerminalSummaryDto>();
    private int _archivedPage = 1;
    private string? _terminalMsg; private bool _terminalOk;
    private EnrollmentTicketResponseDto? _lastEnrollmentTicket;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await Live.EnsureConnectedAsync();
        Live.EntityChanged += OnEntityChanged;
    }

    private async Task RefreshAsync()
    {
        // Un site désactivé (contrat non reconduit) ne doit plus être proposé
        // pour l'enrôlement d'un NOUVEAU terminal.
        try { _overview = (await Api.GetSiteOverviewAsync()).Where(s => s.IsActive).ToList(); } catch { /* best-effort */ }
        try { _terminals = await Api.GetTerminalsAsync(); } catch { /* best-effort */ }
        // Réservé au SuperAdmin côté API (403 sinon) — inutile d'appeler
        // l'endpoint pour un Admin ordinaire.
        if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
        {
            try { _archivedTerminals = await Api.GetArchivedTerminalsAsync(); } catch { /* best-effort */ }
        }
    }

    private void OnEntityChanged(string kind)
    {
        if (kind != "terminals") return;
        _ = InvokeAsync(async () =>
        {
            try { _terminals = await Api.GetTerminalsAsync(); } catch { /* best-effort */ }
            if (Auth.IsInRole(NovAccesRoles.SuperAdmin))
            {
                try { _archivedTerminals = await Api.GetArchivedTerminalsAsync(); } catch { /* best-effort */ }
            }
            StateHasChanged();
        });
    }

    public void Dispose() => Live.EntityChanged -= OnEntityChanged;

    private void ToggleTerminalSite(string siteId, bool isChecked)
    {
        if (isChecked) _newTerminal.SiteIds.Add(siteId);
        else _newTerminal.SiteIds.Remove(siteId);
    }

    private void SyncSingleSite()
    {
        _newTerminal.SiteIds.Clear();
        if (!string.IsNullOrEmpty(_singleSiteId)) _newTerminal.SiteIds.Add(_singleSiteId);
    }

    // Basculer vers « site unique » alors que plusieurs étaient cochés ne doit
    // pas garder un état multi-sites caché : on ne conserve que le premier,
    // sans quoi désactiver la case laisserait un terminal enrôlé sur plusieurs
    // sites sans que l'écran ne le montre plus.
    private void ToggleMultiSite(bool value)
    {
        _multiSite = value;
        if (!_multiSite)
        {
            _singleSiteId = _newTerminal.SiteIds.FirstOrDefault() ?? "";
            _newTerminal.SiteIds.Clear();
            if (!string.IsNullOrEmpty(_singleSiteId)) _newTerminal.SiteIds.Add(_singleSiteId);
        }
    }

    private async Task CreateTerminalAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTerminal.Label))
        {
            _terminalOk = false; _terminalMsg = "Renseignez un libellé.";
            return;
        }
        if (_newTerminal.SiteIds.Count == 0)
        {
            _terminalOk = false; _terminalMsg = "Cochez au moins un site.";
            return;
        }

        _busy = true; _terminalMsg = null;
        try
        {
            var (ok, result, error) = await Api.CreateTerminalAsync(
                _newTerminal.Label.Trim(), _newTerminal.SiteIds.ToList());

            _terminalOk = ok;
            _terminalMsg = ok ? null : error;
            if (ok && result is not null)
            {
                var ticket = await Api.CreateEnrollmentTicketAsync(result.Id);
                if (!ticket.Success || ticket.Result is null)
                {
                    _terminalOk = false;
                    _terminalMsg = ticket.Error ?? "Impossible de générer le QR d'enrôlement.";
                    Toasts.Error(_terminalMsg);
                }
                else
                {
                    _lastEnrollmentTicket = ticket.Result;
                    Toasts.Success($"Terminal « {_newTerminal.Label.Trim()} » créé : scannez le QR pour l'activer.");
                    _terminalMsg = null;
                }
                _newTerminal.Label = "";
                _newTerminal.SiteIds.Clear();
                _singleSiteId = "";
                _multiSite = false;
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Enrôlement refusé."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task CreateEnrollmentTicketForTerminalAsync(Guid id)
    {
        _busy = true;
        try
        {
            var ticket = await Api.CreateEnrollmentTicketAsync(id);
            if (ticket.Success && ticket.Result is not null)
            {
                _lastEnrollmentTicket = ticket.Result;
                Toasts.Success("Nouveau QR temporaire généré.");
            }
            else
                Toasts.Error(ticket.Error ?? "Génération du QR refusée.");
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task RevokeTerminalAsync(Guid id)
    {
        _busy = true;
        try
        {
            var (ok, error) = await Api.RevokeTerminalAsync(id);
            if (ok)
            {
                Toasts.Success("Terminal révoqué.");
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Révocation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }

    private async Task DeleteTerminalAsync(Guid id)
    {
        _busy = true;
        try
        {
            var (ok, error) = await Api.DeleteTerminalAsync(id);
            if (ok)
            {
                Toasts.Success("Terminal supprimé (archivé).");
                await RefreshAsync();
            }
            else { Toasts.Error(error ?? "Suppression refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _busy = false; }
    }
}
