@page "/mot-de-passe-oublie"
@inject NovAccesApiClient Api

<PageTitle>SigasAcces — Mot de passe oublié</PageTitle>

<div class="grid min-h-screen place-items-center bg-paper p-6">
    <div class="w-full max-w-sm animate-fade-in-up">
        <div class="overflow-hidden rounded-lg border border-line bg-white shadow-card">
            <div class="h-1 bg-amber-500"></div>
            <div class="p-7 sm:p-8">
                <h2 class="font-display text-2xl font-semibold text-brand-700">Mot de passe oublié</h2>

                @if (_sent)
                {
                    <p class="mt-4 text-sm text-ink2">
                        Si un compte existe pour <strong>@_email</strong>, un lien de réinitialisation
                        vient de lui être envoyé par email. Vérifiez votre boîte de réception (et vos
                        courriers indésirables).
                    </p>
                }
                else
                {
                    <p class="mb-6 mt-1 text-sm text-muted">
                        Saisissez l'email de votre compte — vous recevrez un lien pour choisir un
                        nouveau mot de passe.
                    </p>

                    <div class="field">
                        <label>Email</label>
                        <input type="email" @bind="_email" @bind:event="oninput" autocomplete="username"
                               placeholder="prenom@site.local"
                               @onkeydown="@(e => { if (e.Key == "Enter") _ = SubmitAsync(); })" />
                    </div>

                    <button class="btn-primary mt-2" @onclick="SubmitAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">
                        @(_busy ? "Envoi…" : "Envoyer le lien")
                    </button>

                    @if (_error is not null)
                    {
                        <p class="error">@_error</p>
                    }
                }

                <a href="/login" class="mt-4 block text-center text-sm text-brand-700 hover:underline">
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            // Toujours le même comportement, que l'envoi ait réellement eu lieu
            // ou non côté serveur (anti-énumération) : on ne peut pas savoir ici
            // si l'email correspond à un compte existant.
            await Api.ForgotPasswordAsync(_email.Trim());
            _sent = true;
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }
}
