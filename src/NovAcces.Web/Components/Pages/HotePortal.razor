@page "/hote"
@implements IDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>SigasAcces — Portail hôte</PageTitle>

@if (!Auth.Initialized)
{
    <p class="muted" style="padding:2rem">Chargement…</p>
}
else if (Auth.IsInRole(NovAccesRoles.Hote))
{
<div class="portal">
    @* Organisation reprise de la maquette validée : la vue principale de
       l'hôte est la LISTE de ses demandes ; la création passe par une
       surcouche ouverte au bouton. Le formulaire en pleine page reléguait
       l'information utile (« où en sont mes visiteurs ? ») sous un long
       formulaire vide à chaque visite du portail. *@
    <header class="portal-header">
        <div>
            <div class="eyebrow">Site @((Auth.SiteId ?? "—").ToUpperInvariant())</div>
            <h1>Mes demandes de visite</h1>
            <p class="muted">Connecté : <strong>@Auth.DisplayName</strong> · Hôte</p>
            @if (Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Admin))
            {
                <div class="nav-links"><a href="/surete">→ Dashboard sûreté</a></div>
            }
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button class="btn-accent" @onclick="() => _showGroup = true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
                Inviter un groupe
            </button>
            <button class="btn-primary" style="max-width:230px" @onclick="OpenForm">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Nouvelle demande
            </button>
        </div>
    </header>

    @* Tuiles de la maquette : à venir / sur site / terminées. Toujours
       affichées, y compris à zéro — un portail vide doit se lire comme
       « aucune visite », pas comme un écran incomplet. *@
    <div class="tiles">
        <div class="tile"><span class="tile-n">@_myVisits.Count(v => v.Status == "Valid" && !v.IsOnSite)</span><span class="tile-l">À venir</span></div>
        <div class="tile tile-in"><span class="tile-n">@_myVisits.Count(v => v.IsOnSite)</span><span class="tile-l">Sur site</span></div>
        <div class="tile"><span class="tile-n">@_myVisits.Count(v => v.Status is "Revoked" or "Expired" or "Consumed" && !v.IsOnSite)</span><span class="tile-l">Terminées</span></div>
    </div>

    @if (NextUpcoming is { } next)
    {
        <p class="synthese">
            📅 Prochain rendez-vous : <strong>@next.VisitorName</strong>@(string.IsNullOrWhiteSpace(next.VisitorCompany) ? "" : $" ({next.VisitorCompany})")
            le @next.ScheduledAt!.Value.LocalDateTime.ToString("dd/MM 'à' HH:mm")
        </p>
    }

    @* Création d'une demande : en surcouche, comme dans la maquette. Le QR
       généré s'affiche dans la même surcouche, à côté du formulaire — l'hôte
       ne doit pas avoir à chercher où est passé le badge de son visiteur. *@
    @if (_showForm)
    {
    <div class="overlay" @onclick="CloseFormIfBackdrop">
    <div class="modal modal-wide" @onclick:stopPropagation="true">
        <div class="modal-h">
            <div>
                <h2>Nouvelle demande de visite</h2>
                <div class="sub">Le QR est envoyé automatiquement au visiteur par email.</div>
            </div>
            <button @onclick="CloseForm" aria-label="Fermer">✕</button>
        </div>
        <div class="modal-b">
    <div class="cards">
        <section class="card">
            <h2>Visiteur</h2>
            <div class="field"><label>Nom du visiteur</label>
                <input @bind="_form.VisitorName" @bind:after="PrefillFromKnown" list="knownVisitors" />
                <datalist id="knownVisitors">
                    @foreach (var kv in _knownVisitors) { <option value="@kv.Name" /> }
                </datalist>
            </div>
            <div class="field"><label>Société</label>
                <input @bind="_form.VisitorCompany" /></div>
            <div class="field"><label>Motif</label>
                <input @bind="_form.Motif" /></div>

            <div class="row">
                <div class="field"><label>Mode</label>
                    <select @bind="_form.Mode">
                        <option value="Unique">Passage unique (rendez-vous)</option>
                        <option value="ThirtyDays">Accès 30 jours ouvrés</option>
                    </select>
                </div>
                <div class="field"><label>Durée prévue (min)</label>
                    <input type="number" min="15" step="15" @bind="_form.PlannedDurationMinutes" /></div>
            </div>

            @if (_form.Mode == "Unique")
            {
                <div class="field"><label>Rendez-vous</label>
                    <input type="datetime-local" @bind="_scheduledAt"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <p class="hint">Le rendez-vous ne peut pas être dans le passé.</p>
                </div>
            }

            <div class="row">
                <div class="field"><label>Téléphone (optionnel)</label>
                    <input @bind="_form.VisitorPhone" placeholder="+225…" />
                    <p class="hint">Contact pour la sûreté — le QR n'est pas envoyé par ce canal.</p>
                </div>
                <div class="field"><label>Email</label>
                    <input type="email" @bind="_form.VisitorEmail" />
                    <p class="hint">Le QR d'accès est envoyé à cette adresse.</p>
                </div>
            </div>

            <button class="btn-primary" @onclick="CreateAsync" disabled="@_busy">
                @(_busy ? "Génération…" : "Générer le QR")
            </button>
            @if (_error is not null) { <p class="error">@_error</p> }
        </section>

        <section class="card qr-panel">
            <h2>QR généré</h2>
            @if (_result is null)
            {
                <p class="muted">Le QR signé du visiteur s'affichera ici après génération.</p>
            }
            else
            {
                <VisitBadge SiteId="@Auth.SiteId" VisitorName="@_lastVisitorName" VisitorCompany="@_lastVisitorCompany"
                            SignedQrPayload="@_result.SignedQrPayload" ExpiresAt="@_result.ExpiresAt" VisitId="@_result.VisitId" />
            }
        </section>
    </div>
        </div>
    </div>
    </div>
    }

    <section class="card">
        <h2>Mes demandes</h2>
        @if (_myVisits.Count == 0)
        {
            <div class="empty">
                @EmptyIcon()
                <p>Aucune demande pour le moment.</p>
                <button class="btn-primary" style="max-width:14rem;margin-top:.5rem" @onclick="OpenForm">Créer ma première demande →</button>
            </div>
        }
        else
        {
            <div class="toolbar">
                <input class="search" placeholder="Rechercher un visiteur, une société, un motif…"
                       @bind="_search" @bind:event="oninput" @bind:after="() => _visitsPage = 1" />
                <div class="filters">
                    @foreach (var f in StatusFilters)
                    {
                        <button class="filter @(_statusFilter == f.Key ? "on" : "")"
                                @onclick="() => { _statusFilter = f.Key; _visitsPage = 1; }">
                            @f.Label <span class="count">@CountFor(f.Key)</span>
                        </button>
                    }
                </div>
            </div>

            var allRows = FilteredVisits;
            if (allRows.Count == 0)
            {
                <div class="empty">
                    @EmptyIcon()
                    <p>Aucune demande ne correspond à la recherche.</p>
                    <button class="btn-ghost" @onclick="ResetFilters">Réinitialiser les filtres</button>
                </div>
            }
            else
            {
                var visitsPageCount = (int)Math.Ceiling(allRows.Count / (double)_visitsPageSize);
                if (_visitsPage > visitsPageCount) { _visitsPage = visitsPageCount; }
                var rows = allRows.Skip((_visitsPage - 1) * _visitsPageSize).Take(_visitsPageSize).ToList();
                <div class="table-wrap">
                <table class="visits">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@AriaSort("name")"><button type="button" class="sortable-th-btn" @onclick='() => SortBy("name")'>Visiteur@(Arrow("name"))</button></th>
                            <th>Société</th>
                            <th>Mode</th>
                            <th>Rendez-vous</th>
                            <th scope="col" aria-sort="@AriaSort("status")"><button type="button" class="sortable-th-btn" @onclick='() => SortBy("status")'>Statut@(Arrow("status"))</button></th>
                            <th scope="col" aria-sort="@AriaSort("created")"><button type="button" class="sortable-th-btn" @onclick='() => SortBy("created")'>Créée@(Arrow("created"))</button></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in rows)
                        {
                            <tr>
                                <td>@Highlight(v.VisitorName)</td>
                                <td class="muted">@Highlight(v.VisitorCompany)</td>
                                <td>@(v.Mode == "Unique" ? "Unique" : "30 jours")</td>
                                <td class="muted">@(v.Mode == "Unique" && v.ScheduledAt is { } rdv ? rdv.LocalDateTime.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                <td><span class="badge badge-@v.Status.ToLowerInvariant()">@StatusLabel(v)</span></td>
                                <td class="muted">@v.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm")</td>
                                <td>
                                    <div class="flex flex-wrap gap-1.5">
                                        <button class="btn-ghost" @onclick="() => _historyVisitId = v.VisitId">Historique</button>
                                        @if (v.Status == "Valid")
                                        {
                                            <button class="btn-ghost" @onclick="() => ViewQrAsync(v)" disabled="@(_viewingQrFor == v.VisitId)">
                                                @(_viewingQrFor == v.VisitId ? "Chargement…" : "Voir QR")
                                            </button>
                                            @if (!v.IsOnSite)
                                            {
                                                <button class="btn-ghost" @onclick="() => OpenEdit(v)">Modifier</button>
                                            }
                                            <button class="btn-danger" @onclick="() => _pendingRevoke = v" disabled="@_revoking">Révoquer</button>
                                        }
                                        else
                                        {
                                            <button class="btn-ghost" @onclick="() => ReInvite(v)">Ré-inviter</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <Pagination Page="_visitsPage" PageSize="_visitsPageSize" TotalCount="allRows.Count"
                            OnPageChanged="p => _visitsPage = p" />
            }
        }
    </section>

    @if (_showGroup)
    {
        <GroupInvite OnClose="() => _showGroup = false" OnCompleted="OnGroupCompleted" />
    }

    @* Réémission du QR d'une demande existante — visiteur ayant perdu son
       email. Même badge que la création, données différentes. *@
    @if (_viewedQr is { } qr)
    {
        <div class="overlay" @onclick="() => _viewedQr = null">
            <div class="modal" style="max-width:26rem" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <div><h2>QR de @_viewedQrVisitorName</h2></div>
                    <button @onclick="() => _viewedQr = null" aria-label="Fermer">✕</button>
                </div>
                <div class="modal-b">
                    <VisitBadge SiteId="@Auth.SiteId" VisitorName="@_viewedQrVisitorName" VisitorCompany="@_viewedQrCompany"
                                SignedQrPayload="@qr.SignedQrPayload" ExpiresAt="@qr.ExpiresAt" VisitId="@qr.VisitId" />
                </div>
            </div>
        </div>
    }

    @if (_pendingRevoke is not null)
    {
        <div class="overlay" @onclick="() => _pendingRevoke = null">
            <div class="modal" style="max-width:26rem" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <div><h2>Révoquer le QR ?</h2></div>
                </div>
                <div class="modal-b">
                    <p>Le QR de <strong>@_pendingRevoke.VisitorName</strong> sera invalidé immédiatement à l'entrée.</p>
                    <p class="hint">Une sortie éventuelle reste toujours possible — on ne bloque jamais physiquement une personne déjà sur site.</p>
                </div>
                <div class="modal-f">
                    <button class="btn-ghost" @onclick="() => _pendingRevoke = null">Annuler</button>
                    <button class="btn-danger" style="max-width:180px" @onclick="ConfirmRevokeAsync" disabled="@_revoking">
                        @(_revoking ? "Révocation…" : "Oui, révoquer")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_historyVisitId is { } hid)
    {
        <VisitHistory VisitId="hid" OnClose="() => _historyVisitId = null" />
    }

    @* Correction d'une erreur de saisie AVANT l'arrivée du visiteur — le QR déjà
       émis reste valable ; seul un changement d'email déclenche un renvoi. *@
    @if (_editing is not null)
    {
        <div class="overlay" @onclick="CloseEditIfBackdrop">
            <div class="modal" style="max-width:30rem" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <div>
                        <h2>Modifier « @_editing.VisitorName »</h2>
                        <div class="sub">Le QR déjà émis reste valable — seule une adresse email corrigée déclenche un nouvel envoi.</div>
                    </div>
                    <button @onclick="CloseEdit" aria-label="Fermer">✕</button>
                </div>
                <div class="modal-b">
                    <div class="field"><label>Nom du visiteur</label>
                        <input @bind="_editName" /></div>
                    <div class="field"><label>Société</label>
                        <input @bind="_editCompany" /></div>
                    <div class="field"><label>Motif</label>
                        <input @bind="_editMotif" /></div>
                    <div class="row">
                        <div class="field"><label>Téléphone (optionnel)</label>
                            <input @bind="_editPhone" placeholder="+225…" /></div>
                        <div class="field"><label>Email</label>
                            <input type="email" @bind="_editEmail" /></div>
                    </div>
                    @if (_editError is not null) { <p class="error">@_editError</p> }
                </div>
                <div class="modal-f">
                    <button class="btn-ghost" @onclick="CloseEdit">Annuler</button>
                    <button class="btn-primary" style="max-width:220px" @onclick="SaveEditAsync" disabled="@_editBusy">
                        @(_editBusy ? "Enregistrement…" : "Enregistrer")
                    </button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    private bool _showGroup;
    private bool _showForm;
    private HostVisitDto? _pendingRevoke;
    private Guid? _historyVisitId;

    private HostVisitDto? _editing;
    private string _editName = "";
    private string _editCompany = "";
    private string _editMotif = "";
    private string _editPhone = "";
    private string _editEmail = "";
    private bool _editBusy;
    private string? _editError;

    private void OpenEdit(HostVisitDto v)
    {
        _editing = v;
        _editName = v.VisitorName;
        _editCompany = v.VisitorCompany;
        _editMotif = v.Motif;
        _editPhone = v.VisitorPhone ?? "";
        _editEmail = v.VisitorEmail ?? "";
        _editError = null;
    }

    private void CloseEdit() { _editing = null; _editError = null; }
    private void CloseEditIfBackdrop() { if (!_editBusy) CloseEdit(); }

    private async Task SaveEditAsync()
    {
        if (_editing is null || _editBusy) return;
        _editError = null;

        var name = _editName.Trim();
        var company = _editCompany.Trim();
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(company))
        {
            _editError = "Nom du visiteur et société sont requis.";
            return;
        }

        var visitId = _editing.VisitId;
        _editBusy = true;
        try
        {
            var request = new UpdateVisitRequestDto(
                name, company, _editMotif.Trim(),
                string.IsNullOrWhiteSpace(_editPhone) ? null : _editPhone.Trim(),
                string.IsNullOrWhiteSpace(_editEmail) ? null : _editEmail.Trim());

            var (ok, error) = await Api.UpdateVisitAsync(visitId, request);
            if (ok)
            {
                await RefreshMyVisitsAsync();
                Toasts.Success($"Coordonnées de « {name} » mises à jour.");
                _editing = null;
            }
            else
            {
                _editError = error ?? "Modification refusée.";
            }
        }
        catch
        {
            _editError = "Service indisponible, réessayez.";
        }
        finally { _editBusy = false; }
    }

    private Guid? _viewingQrFor;
    private CreateVisitResponseDto? _viewedQr;
    private string _viewedQrVisitorName = "";
    private string _viewedQrCompany = "";

    private async Task ViewQrAsync(HostVisitDto v)
    {
        _viewingQrFor = v.VisitId;
        try
        {
            var outcome = await Api.ReissueVisitQrAsync(v.VisitId);
            if (!outcome.Success)
            {
                Toasts.Error(outcome.Error ?? "Impossible de récupérer ce QR.");
                // Le statut affiché peut être périmé (révoqué entre-temps
                // depuis un autre onglet, ou par la sûreté) : on rafraîchit
                // la liste pour que le bouton reflète l'état réel.
                await RefreshMyVisitsAsync();
                return;
            }

            _viewedQrVisitorName = v.VisitorName;
            _viewedQrCompany = v.VisitorCompany;
            _viewedQr = outcome.Data;
        }
        catch
        {
            // Panne réseau/API en amont de la réponse HTTP (ReissueVisitQrAsync
            // ne catch que les échecs déjà reçus) : ne JAMAIS laisser une
            // exception non rattrapée remonter jusqu'à Blazor, elle y est
            // fatale — elle déconnecterait tout le portail de l'hôte, pas
            // seulement cette action.
            Toasts.Error("Service indisponible, réessayez.");
        }
        finally
        {
            _viewingQrFor = null;
        }
    }

    private void OpenForm()
    {
        // Repart d'un formulaire vierge : rouvrir après une génération ne doit
        // pas réafficher le QR du visiteur précédent.
        _result = null;
        _error = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _result = null;
        _error = null;
    }

    /// <summary>
    /// Ferme au clic sur le fond, jamais sur le contenu. On ne ferme PAS tant
    /// qu'un QR vient d'être généré et n'a pas été imprimé : un clic à côté
    /// ferait perdre le badge de vue sans que l'hôte l'ait récupéré.
    /// </summary>
    private void CloseFormIfBackdrop()
    {
        if (_result is null) CloseForm();
    }

    private async Task OnGroupCompleted()
    {
        await RefreshMyVisitsAsync();
        StateHasChanged();
    }

    private async Task ConfirmRevokeAsync()
    {
        if (_pendingRevoke is null) return;
        var target = _pendingRevoke;
        var ok = await RevokeAsync(target.VisitId);
        _pendingRevoke = null;

        // La révocation est une action de sûreté (REQ-F-09) : annoncer un
        // succès qui n'a pas eu lieu laisserait croire à l'hôte qu'un QR
        // toujours actif est invalidé. Le résultat réel de l'appel doit
        // déterminer le message, jamais une supposition optimiste.
        if (ok)
            Toasts.Success($"QR de « {target.VisitorName} » révoqué.");
        else
            Toasts.Error($"La révocation de « {target.VisitorName} » a échoué — réessayez.");
    }

    private bool _loaded;

    private sealed class VisitForm
    {
        public string VisitorName = "";
        public string VisitorCompany = "";
        public string Motif = "";
        public string Mode = "Unique";
        public int PlannedDurationMinutes = 60;
        public string VisitorPhone = "";
        public string VisitorEmail = "";
    }

    private readonly VisitForm _form = new();
    private DateTime _scheduledAt = DateTime.Now;
    private CreateVisitResponseDto? _result;
    private string _lastVisitorName = "";
    private string _lastVisitorCompany = "";
    private IReadOnlyList<HostVisitDto> _myVisits = Array.Empty<HostVisitDto>();
    private IReadOnlyList<KnownVisitorDto> _knownVisitors = Array.Empty<KnownVisitorDto>();
    private bool _busy;
    private bool _revoking;
    private string? _error;

    // Prochain rendez-vous à venir (mode Unique, pas encore sur site) — pour
    // que la page réponde d'un coup d'œil à « qui attendre aujourd'hui ? ».
    private HostVisitDto? NextUpcoming =>
        _myVisits
            .Where(v => v.Status == "Valid" && !v.IsOnSite && v.Mode == "Unique" && v.ScheduledAt.HasValue)
            .OrderBy(v => v.ScheduledAt)
            .FirstOrDefault();

    // ── Liste intelligente « Mes demandes » : recherche + filtre + tri ──
    private string _search = "";
    private string _statusFilter = "all";
    private string _sortKey = "created";
    private bool _sortAsc;
    private int _visitsPage = 1;
    private const int _visitsPageSize = 20;

    private static readonly (string Key, string Label)[] StatusFilters =
    {
        ("all", "Toutes"), ("Valid", "Valides"),
        ("Revoked", "Révoquées"), ("Expired", "Expirées"),
    };

    private int CountFor(string key) =>
        key == "all" ? _myVisits.Count : _myVisits.Count(v => v.Status == key);

    private void ResetFilters() { _search = ""; _statusFilter = "all"; _visitsPage = 1; }

    private void SortBy(string key)
    {
        if (_sortKey == key) { _sortAsc = !_sortAsc; }
        else { _sortKey = key; _sortAsc = key == "name"; } // noms A→Z ; dates récentes d'abord
    }

    private MarkupString Arrow(string key) => _sortKey == key
        ? (MarkupString)$"<span class=\"arrow\" aria-hidden=\"true\">{(_sortAsc ? "▲" : "▼")}</span>"
        : default;

    // aria-sort sur le <th> : façon standard d'annoncer au lecteur d'écran
    // l'état de tri courant d'une colonne.
    private string AriaSort(string key) => _sortKey == key ? (_sortAsc ? "ascending" : "descending") : "none";

    private IReadOnlyList<HostVisitDto> FilteredVisits
    {
        get
        {
            IEnumerable<HostVisitDto> q = _myVisits;

            if (_statusFilter != "all")
                q = q.Where(v => v.Status == _statusFilter);

            var s = _search?.Trim();
            if (!string.IsNullOrEmpty(s))
                q = q.Where(v =>
                    (v.VisitorName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (v.VisitorCompany?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (v.Motif?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));

            q = _sortKey switch
            {
                "name"   => _sortAsc ? q.OrderBy(v => v.VisitorName) : q.OrderByDescending(v => v.VisitorName),
                "status" => _sortAsc ? q.OrderBy(v => v.Status)      : q.OrderByDescending(v => v.Status),
                _        => _sortAsc ? q.OrderBy(v => v.CreatedAt)   : q.OrderByDescending(v => v.CreatedAt),
            };

            return q.ToList();
        }
    }

    // Surligne la portion recherchée (données visiteur encodées → pas d'injection).
    private MarkupString Highlight(string? text)
    {
        var t = text ?? "";
        var s = _search?.Trim();
        if (string.IsNullOrEmpty(s))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var idx = t.IndexOf(s, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return (MarkupString)System.Net.WebUtility.HtmlEncode(t);

        var before = System.Net.WebUtility.HtmlEncode(t[..idx]);
        var match  = System.Net.WebUtility.HtmlEncode(t.Substring(idx, s.Length));
        var after  = Highlight(t[(idx + s.Length)..]).Value; // gère les occurrences suivantes
        return (MarkupString)$"{before}<mark>{match}</mark>{after}";
    }

    private static RenderFragment EmptyIcon() => builder =>
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor'
            stroke-width='1.6' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M21 21l-4.3-4.3'/></svg>");

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    // On décide APRÈS que la session ait été restaurée (Auth.Initialized) :
    // redirection si non autorisé, chargement des données sinon.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Auth.Initialized) return;

        if (!Auth.IsInRole(NovAccesRoles.Hote))
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!_loaded)
        {
            _loaded = true;
            await RefreshMyVisitsAsync();
            try { _knownVisitors = await Api.GetKnownVisitorsAsync(); } catch { /* best-effort */ }
            StateHasChanged();
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;

    private async Task RefreshMyVisitsAsync()
    {
        try { _myVisits = await Api.GetMyVisitsAsync(); } catch { /* best-effort */ }
    }

    // Pré-remplit entreprise/motif/durée quand le nom saisi correspond à un
    // visiteur déjà connu (§8 maquette).
    private void PrefillFromKnown()
    {
        var match = _knownVisitors.FirstOrDefault(
            k => string.Equals(k.Name, _form.VisitorName?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match is null) return;

        _form.VisitorCompany = match.Company;
        _form.Motif = match.Motif;
        if (match.PlannedDurationMinutes > 0) _form.PlannedDurationMinutes = match.PlannedDurationMinutes;
    }

    // Ré-invitation : pré-remplit le formulaire à partir d'une demande close
    // et ouvre la fenêtre — sans _showForm = true, les champs étaient bien
    // renseignés mais rien ne s'affichait à l'écran.
    private void ReInvite(HostVisitDto v)
    {
        _form.VisitorName = v.VisitorName;
        _form.VisitorCompany = v.VisitorCompany;
        _form.Motif = v.Motif;
        if (v.PlannedDurationMinutes > 0) _form.PlannedDurationMinutes = v.PlannedDurationMinutes;
        _result = null;
        _error = null;
        _showForm = true;
    }

    private async Task<bool> RevokeAsync(Guid visitId)
    {
        if (_revoking) return false;
        _revoking = true;
        try
        {
            var ok = await Api.RevokeVisitAsync(visitId);
            await RefreshMyVisitsAsync();
            return ok;
        }
        catch
        {
            // Panne réseau/API : ne jamais laisser l'exception atteindre
            // Blazor (fatale pour le circuit) ; ConfirmRevokeAsync affichera
            // l'échec au lieu d'un faux succès.
            return false;
        }
        finally { _revoking = false; }
    }

    private static string StatusLabel(HostVisitDto v) => v.Status switch
    {
        "Valid" => "Valide",
        "Revoked" => "Révoquée",
        "Expired" => "Expirée",
        _ => v.Status
    };

    private async Task CreateAsync()
    {
        if (_busy) return;
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.VisitorName) || string.IsNullOrWhiteSpace(_form.VisitorCompany))
        {
            _error = "Nom du visiteur et société sont requis.";
            Toasts.Error("Nom du visiteur et société sont requis.");
            return;
        }

        if (_form.Mode == "Unique")
        {
            if (_scheduledAt == default)
            {
                _error = "Indiquez la date et l'heure du rendez-vous.";
                Toasts.Error(_error);
                return;
            }
            if (_scheduledAt < DateTime.Now.AddMinutes(-1))
            {
                _error = "Le rendez-vous ne peut pas être dans le passé.";
                Toasts.Error(_error);
                return;
            }
        }

        _busy = true;
        try
        {
            DateTimeOffset? scheduled = _form.Mode == "Unique"
                ? new DateTimeOffset(_scheduledAt.ToUniversalTime(), TimeSpan.Zero)
                : null;

            var request = new CreateVisitRequestDto(
                _form.VisitorName.Trim(), _form.VisitorCompany.Trim(), _form.Motif.Trim(),
                _form.Mode, scheduled, _form.PlannedDurationMinutes,
                string.IsNullOrWhiteSpace(_form.VisitorPhone) ? null : _form.VisitorPhone.Trim(),
                string.IsNullOrWhiteSpace(_form.VisitorEmail) ? null : _form.VisitorEmail.Trim());

            _result = await Api.CreateVisitAsync(request);

            // Mémorise le visiteur pour le badge, PUIS vide le formulaire.
            _lastVisitorName = _form.VisitorName.Trim();
            _lastVisitorCompany = _form.VisitorCompany.Trim();

            await RefreshMyVisitsAsync();
            Toasts.Success($"QR généré pour « {_lastVisitorName} » — envoyé au visiteur.");

            _form.VisitorName = _form.VisitorCompany = _form.Motif = _form.VisitorPhone = _form.VisitorEmail = "";
            _form.Mode = "Unique";
            _form.PlannedDurationMinutes = 60;
            _scheduledAt = DateTime.Now;
        }
        catch
        {
            _error = "La génération a échoué (session expirée ou service indisponible).";
            Toasts.Error("La génération a échoué (session ou service indisponible).");
        }
        finally { _busy = false; }
    }

    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login");
    }
}
