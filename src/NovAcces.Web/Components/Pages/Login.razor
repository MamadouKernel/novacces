@page "/"
@page "/login"
@implements IDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>SigasAcces — Connexion</PageTitle>

<div class="min-h-screen grid lg:grid-cols-2">

    @* ---- Panneau de marque (identité produit) — visible dès lg ---- *@
    <aside class="relative hidden overflow-hidden border-t-[3px] border-amber-500 bg-gradient-to-br from-brand-700 via-brand-800 to-brand-950 p-10 text-white lg:flex lg:flex-col lg:justify-between xl:p-14">
        <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-amber-500/10 blur-2xl"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-white/5 blur-2xl"></div>

        <div class="relative flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-amber-500 text-brand-700 shadow-card">
                @BrandMark("h-6 w-6")
            </span>
            <span class="font-display text-2xl font-bold tracking-wide">SIGAS<span class="text-amber-500">ACCÈS</span></span>
        </div>

        <div class="relative max-w-md">
            <h1 class="text-4xl font-bold leading-[1.05] text-white xl:text-5xl">
                Le contrôle d'accès par QR&nbsp;Code, sécurisé.
            </h1>
            <p class="mt-4 text-brand-100/90">
                Gestion des visiteurs et contrôle des accès physiques sur sites sensibles —
                chaque scan ouvre une porte, sous la responsabilité de la sûreté.
            </p>

            <ul class="mt-8 space-y-3 text-sm text-brand-50">
                <li class="flex items-center gap-3">@Check() Fenêtre de validité calculée côté serveur</li>
                <li class="flex items-center gap-3">@Check() Anti-copie et anti-rejeu du QR</li>
                <li class="flex items-center gap-3">@Check() Journal des accès inaltérable</li>
                <li class="flex items-center gap-3">@Check() Supervision temps réel des postes</li>
            </ul>
        </div>

        <p class="relative font-mono text-[0.7rem] uppercase tracking-[0.12em] text-brand-200/80">
            Opéré par Sigasécurité · Agrément n° 344 MI
        </p>
    </aside>

    @* ---- Formulaire ---- *@
    <main class="flex items-center justify-center bg-paper p-6 sm:p-10">
        <div class="w-full max-w-sm animate-fade-in-up">

            @* En-tête de marque compact (mobile uniquement) *@
            <div class="mb-8 flex items-center gap-3 lg:hidden">
                <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-700 text-amber-500 shadow-card">
                    @BrandMark("h-6 w-6")
                </span>
                <div>
                    <div class="font-display text-xl font-bold tracking-wide text-brand-700">SIGAS<span class="text-amber-500">ACCÈS</span></div>
                    <div class="text-xs text-muted">Contrôle d'accès par QR Code</div>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg border border-line bg-white shadow-card">
                <div class="h-1 bg-amber-500"></div>
                <div class="p-7 sm:p-8">
                <h2 class="font-display text-2xl font-semibold text-brand-700">
                    @(_step switch
                    {
                        Step.TwoFactor => "Vérification en deux étapes",
                        Step.Enroll => "Sécurisation du compte",
                        Step.RecoveryCodes => "Codes de récupération",
                        _ => "Connexion au portail",
                    })
                </h2>
                <p class="mb-6 mt-1 text-sm text-muted">
                    @(_step switch
                    {
                        Step.TwoFactor => "Saisissez le code de votre application d'authentification.",
                        Step.Enroll => "Ce compte dispose de droits étendus : la double authentification est obligatoire avant la première connexion.",
                        Step.RecoveryCodes => "Conservez ces codes hors ligne. Ils ne seront plus jamais affichés.",
                        _ => "Accès réservé au personnel autorisé.",
                    })
                </p>

                @if (_step == Step.Enroll)
                {
                    <ol class="mb-5 space-y-2 text-sm text-ink2">
                        <li><strong>1.</strong> Scannez ce QR avec Google Authenticator, Microsoft Authenticator ou FreeOTP.</li>
                        <li><strong>2.</strong> Saisissez le code à 6 chiffres affiché par l'application.</li>
                    </ol>

                    @if (_setup is not null)
                    {
                        <div class="mb-4 flex justify-center rounded-lg border border-line bg-paper p-4">
                            <img src="@QrImage.ToDataUri(_setup.AuthenticatorUri)" alt="QR d'enrôlement de l'authentificateur"
                                 class="h-44 w-44" />
                        </div>
                        <p class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-amber-700">
                            Saisie manuelle si le scan échoue
                        </p>
                        <p class="mb-5 select-all break-all font-mono text-xs text-ink2">@_setup.SharedKey</p>
                    }

                    <div class="field">
                        <label>Code à 6 chiffres</label>
                        <input type="text" inputmode="numeric" class="tracking-[0.4em] text-center text-lg"
                               @bind="_code" @bind:event="oninput"
                               @onkeydown="@(e => { if (e.Key == "Enter") _ = SubmitEnrollmentAsync(); })" />
                    </div>
                    <button class="btn-primary mt-2" @onclick="SubmitEnrollmentAsync" disabled="@_busy">
                        @(_busy ? "Activation…" : "Activer et se connecter")
                    </button>
                }
                else if (_step == Step.RecoveryCodes)
                {
                    <div class="mb-5 grid grid-cols-2 gap-2 rounded-lg border border-line bg-paper p-4 font-mono text-sm">
                        @foreach (var recoveryCode in _recoveryCodes)
                        {
                            <span class="select-all">@recoveryCode</span>
                        }
                    </div>
                    <p class="mb-4 text-sm text-ink2">
                        Chacun de ces codes permet une connexion si vous perdez votre téléphone.
                        Notez-les avant de continuer.
                    </p>
                    <button class="btn-primary" @onclick="FinishEnrollmentAsync" disabled="@_busy">
                        @(_busy ? "Connexion…" : "J'ai noté ces codes, continuer")
                    </button>
                }
                else if (_step == Step.Password)
                {
                    <div class="field">
                        <label>Email</label>
                        <input type="email" @bind="_email" @bind:event="oninput" autocomplete="username"
                               placeholder="prenom@site.local" />
                    </div>

                    <PasswordBox @bind-Value="_password" Label="Mot de passe"
                                 Autocomplete="current-password" OnEnter="SubmitPasswordAsync" />

                    <button class="btn-primary mt-2" @onclick="SubmitPasswordAsync" disabled="@_busy">
                        @if (_busy) { <span>Connexion…</span> } else { <span>Se connecter</span> }
                    </button>
                    <a href="/mot-de-passe-oublie" class="mt-3 block text-center text-sm text-brand-700 hover:underline">
                        Mot de passe oublié ?
                    </a>
                }
                else
                {
                    <div class="field">
                        <label>Code à 6 chiffres</label>
                        <input type="text" inputmode="numeric" class="tracking-[0.4em] text-center text-lg"
                               @bind="_code" @bind:event="oninput"
                               @onkeydown="@(e => { if (e.Key == "Enter") _ = SubmitTwoFactorAsync(); })" />
                    </div>
                    <button class="btn-primary mt-2" @onclick="SubmitTwoFactorAsync" disabled="@_busy">
                        @(_busy ? "Vérification…" : "Valider")
                    </button>
                }

                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }
                </div>
            </div>

            <p class="mt-6 text-center font-mono text-[0.7rem] uppercase tracking-[0.1em] text-muted">
                © @DateTime.Now.Year SigasAcces — Sigasécurité
            </p>
        </div>
    </main>
</div>

@code {
    /// <summary>
    /// Étapes du parcours de connexion. « Enroll » et « RecoveryCodes » sont
    /// obligatoires à la PREMIÈRE connexion d'un compte à privilèges : l'API
    /// refuse de délivrer un jeton tant que le 2FA n'est pas actif.
    /// </summary>
    private enum Step { Password, TwoFactor, Enroll, RecoveryCodes }

    private string _email = "";
    private string _password = "";
    private string _code = "";
    private Step _step = Step.Password;
    private TwoFactorSetupDto? _setup;
    private IReadOnlyList<string> _recoveryCodes = Array.Empty<string>();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Auth.Initialized && Auth.IsAuthenticated)
            Nav.NavigateTo(LandingPage());
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;

    private async Task SubmitPasswordAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var outcome = await Api.LoginAsync(_email.Trim(), _password);
            if (outcome.Success) { Nav.NavigateTo(LandingPage()); return; }
            if (outcome.RequiresTwoFactor) { _step = Step.TwoFactor; return; }

            if (outcome.RequiresEnrollment)
            {
                // Compte à privilèges jamais enrôlé : on récupère la clé TOTP
                // (l'API la délivre sans ouvrir de session) et on bascule sur
                // l'écran d'enrôlement.
                _setup = await Api.BeginTwoFactorEnrollmentAsync(_email.Trim(), _password);
                if (_setup is null)
                {
                    _error = "Impossible de préparer la double authentification.";
                    return;
                }
                _step = Step.Enroll;
                return;
            }

            _error = outcome.Error;
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }

    private async Task SubmitEnrollmentAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var codes = await Api.CompleteTwoFactorEnrollmentAsync(_email.Trim(), _password, _code.Trim());
            if (codes is null)
            {
                _error = "Code invalide — vérifiez l'heure de votre téléphone et réessayez.";
                return;
            }

            _recoveryCodes = codes.RecoveryCodes;
            _code = "";
            _step = Step.RecoveryCodes;
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }

    /// <summary>
    /// Après affichage des codes de récupération, on repasse par la connexion
    /// normale : le 2FA étant désormais actif, l'API demandera un code TOTP.
    /// On ne délivre volontairement pas de jeton à l'enrôlement — c'est ce qui
    /// garantit qu'aucune session privilégiée n'existe avant que le second
    /// facteur ne soit réellement opérationnel.
    /// </summary>
    private async Task FinishEnrollmentAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var outcome = await Api.LoginAsync(_email.Trim(), _password);
            _step = outcome.RequiresTwoFactor ? Step.TwoFactor : Step.Password;
            if (!outcome.RequiresTwoFactor && !outcome.Success)
                _error = outcome.Error;
            if (outcome.Success) Nav.NavigateTo(LandingPage());
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }

    private async Task SubmitTwoFactorAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            var outcome = await Api.LoginTwoFactorAsync(_email.Trim(), _password, _code.Trim());
            if (outcome.Success) { Nav.NavigateTo(LandingPage()); return; }
            _error = outcome.Error ?? "Code invalide.";
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }

    // Redirection selon le rôle : Admin -> console ; Sûreté -> dashboard ; sinon -> portail hôte.
    private string LandingPage()
    {
        if (Auth.IsInRole(NovAccesRoles.Admin) && !Auth.IsInRole(NovAccesRoles.Hote)) return "/admin";
        if (Auth.IsInRole(NovAccesRoles.Surete) && !Auth.IsInRole(NovAccesRoles.Hote)) return "/surete";
        return "/hote";
    }

    // Marque de bouclier (logo NovAccès) en SVG inline monochrome (currentColor) :
    // le contraste navy/ambre vient du conteneur. Aucune dépendance.
    private static RenderFragment BrandMark(string cls) => builder =>
    {
        builder.AddMarkupContent(0, $@"<svg viewBox='0 0 24 24' class='{cls}' xmlns='http://www.w3.org/2000/svg'>
            <path d='M12 2.2 L20 5.2 V11 C20 16 16.4 19.5 12 21 C7.6 19.5 4 16 4 11 V5.2 Z'
                  fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'/>
            <path d='M8.4 12 L11 14.6 L15.6 9'
                  fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>");
    };

    private static RenderFragment Check() => builder =>
    {
        builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'
            class='h-5 w-5 shrink-0 text-amber-500' stroke-linecap='round' stroke-linejoin='round'>
            <path d='M20 6L9 17l-5-5'/></svg>");
    };
}
