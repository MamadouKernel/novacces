@page "/reinitialiser-mot-de-passe"
@inject NovAccesApiClient Api
@inject NavigationManager Nav

<PageTitle>SigasAcces — Réinitialiser le mot de passe</PageTitle>

<div class="grid min-h-screen place-items-center bg-paper p-6">
    <div class="w-full max-w-sm animate-fade-in-up">
        <div class="overflow-hidden rounded-lg border border-line bg-white shadow-card">
            <div class="h-1 bg-amber-500"></div>
            <div class="p-7 sm:p-8">
                <h2 class="font-display text-2xl font-semibold text-brand-700">Nouveau mot de passe</h2>

                @if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
                {
                    <p class="mt-4 text-sm text-ink2">
                        Ce lien est invalide ou incomplet. Redemandez un lien depuis la page
                        « mot de passe oublié ».
                    </p>
                }
                else if (_done)
                {
                    <p class="mt-4 text-sm text-ink2">
                        Votre mot de passe a été modifié. Vous pouvez maintenant vous connecter.
                    </p>
                }
                else
                {
                    <p class="mb-6 mt-1 text-sm text-muted">
                        Compte : <strong>@Email</strong>
                    </p>

                    <PasswordBox @bind-Value="_newPassword" Label="Nouveau mot de passe" Autocomplete="new-password" />
                    <p class="hint" style="margin-top:-.6rem">12 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</p>

                    <button class="btn-primary mt-2" @onclick="SubmitAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newPassword))">
                        @(_busy ? "Enregistrement…" : "Changer le mot de passe")
                    </button>

                    @if (_error is not null)
                    {
                        <p class="error">@_error</p>
                    }
                }

                <a href="/login" class="mt-4 block text-center text-sm text-brand-700 hover:underline">
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _newPassword = "";
    private bool _busy;
    private bool _done;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token)) return;
        _busy = true; _error = null;
        try
        {
            var (success, error) = await Api.ResetPasswordAsync(Email, Token, _newPassword);
            if (success) { _done = true; return; }
            _error = error ?? "Lien invalide ou expiré.";
        }
        catch { _error = "Impossible de joindre le service d'authentification."; }
        finally { _busy = false; }
    }
}
