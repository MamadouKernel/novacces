    private async Task RefreshPendingConfirmationsAsync()
    {
        try
        {
            var pending = await Api.GetPendingConfirmationRequestsAsync();
            _pendingConfirmations.Clear();
            _pendingConfirmations.AddRange(pending);
        }
        catch { /* best-effort */ }
    }

    private async Task ApproveConfirmationAsync(Guid id)
    {
        if (_confirmationBusy) return;
        _confirmationBusy = true;
        try
        {
            var (success, result, error) = await Api.ApproveConfirmationRequestAsync(id);
            if (success)
            {
                _pendingConfirmations.RemoveAll(r => r.Id == id);
                // Le succès HTTP ne garantit pas l'accès : ScanExecutionCore revérifie
                // tout au moment de l'approbation (exclusion, anti-doublon, fenêtre).
                if (result is { IsGranted: true })
                    Toasts.Success($"Accès confirmé pour « {result.VisitorName} ».");
                else
                    Toasts.Error($"Confirmation enregistrée, mais l'accès a été refusé ({result?.VerdictCode}) — voir le journal.");
                await RefreshOnSiteAsync();
            }
            else { Toasts.Error(error ?? "Confirmation refusée."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _confirmationBusy = false; }
    }

    private async Task DenyConfirmationAsync(Guid id)
    {
        if (_confirmationBusy) return;
        _confirmationBusy = true;
        try
        {
            var (success, error) = await Api.DenyConfirmationRequestAsync(id);
            if (success)
            {
                _pendingConfirmations.RemoveAll(r => r.Id == id);
                Toasts.Info("Demande refusée.");
            }
            else { Toasts.Error(error ?? "Le refus a échoué."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _confirmationBusy = false; }
    }

