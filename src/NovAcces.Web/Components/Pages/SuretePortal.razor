    // Abonnement WebPush (§7) : réveille l'onglet même FERMÉ pour l'alerte de
    // dépassement — complète ConnectHubAsync, qui ne couvre que l'onglet
    // ouvert (SignalR). Best-effort partout.
    private async Task SubscribeToPushAsync()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("novaccesPush.requestPermission")) return;
            var vapidKey = await Api.GetVapidPublicKeyAsync();
            if (string.IsNullOrWhiteSpace(vapidKey)) return;
            await JS.InvokeVoidAsync("novaccesPush.subscribe", Config["Api:BaseUrl"], vapidKey, Auth.AccessToken);
        }
        catch { /* best-effort */ }
    }

    private async Task ConnectHubAsync()
    {
        var apiBase = Config["Api:BaseUrl"]!;
        var site = Auth.SiteId ?? "";

        _hub = new HubConnectionBuilder()
            .WithUrl($"{apiBase}/hubs/scan?site={Uri.EscapeDataString(site)}", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(Auth.AccessToken);

                // Dev : l'API expose un certificat auto-signé — accepté UNIQUEMENT
                // en développement (connexion serveur-à-serveur).
                if (Env.IsDevelopment())
                {
                    options.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler h)
                            h.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        return handler;
                    };
                    options.WebSocketConfiguration = conf =>
                        conf.RemoteCertificateValidationCallback = (_, _, _, _) => true;
                }
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ScanEventDto>("ScanRecorded", async scan =>
        {
            _latestScanAt = scan.OccurredAt;
            _feed.Insert(0, scan);
            if (_feed.Count > 50) _feed.RemoveRange(50, _feed.Count - 50);
            await RefreshOnSiteAsync();          // un scan change souvent les présents
            await RefreshSummaryAsync();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<OverstayAlertDto>("OverstayAlert", async alert =>
        {
            _overstayAlerts.Insert(0, alert);
            if (_overstayAlerts.Count > 6) _overstayAlerts.RemoveRange(6, _overstayAlerts.Count - 6);
            await RefreshOnSiteAsync();          // met à jour les badges de dépassement
            try { await JS.InvokeVoidAsync("novaccesBeep", alert.Level); } catch { /* best-effort */ }
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<ConfirmationRequestedDto>("ConfirmationRequested", async requested =>
        {
            if (_pendingConfirmations.Any(r => r.Id == requested.RequestId)) return;
            _pendingConfirmations.Insert(0, new PendingConfirmationRequestDto(
                requested.RequestId, requested.VisitorName, requested.Direction, requested.CheckpointId,
                "", DateTimeOffset.UtcNow, requested.ExpiresAt));
            try { await JS.InvokeVoidAsync("novaccesBeep", 1); } catch { /* best-effort */ }
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<Guid>("ConfirmationResolved", async requestId =>
        {
            _pendingConfirmations.RemoveAll(r => r.Id == requestId);
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += _ => { _connected = true; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _connected = true;
        }
        catch
        {
            _connected = false;
        }
    }

    private async Task RefreshOnSiteAsync()
