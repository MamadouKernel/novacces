    private void CancelOverride()
    {
        _pendingOverride = null;
        _overrideJustification = "";
    }

    private async Task ConfirmExclusionOverrideAsync()
    {
        if (_pendingOverride is not { } v || _overriding || string.IsNullOrWhiteSpace(_overrideJustification)) return;
        _overriding = true;
        try
        {
            var (success, result, error) = await Api.OverrideExclusionAsync(v.VisitId, _overrideJustification.Trim());
            if (success)
            {
                CancelOverride();
                // Comme pour l'approbation de confirmation : le succès HTTP ne
                // garantit pas l'accès, ScanExecutionCore revérifie tout
                // (fenêtre, anti-rejeu) au moment même du contournement.
                if (result is { IsGranted: true })
                    Toasts.Success($"Entrée autorisée pour « {result.VisitorName} » malgré l'exclusion.");
                else
                    Toasts.Error($"Contournement enregistré, mais l'accès a été refusé ({result?.VerdictCode}) — voir le journal.");
                await ChangeVisitsPageAsync(_visitsPage);
                await RefreshOnSiteAsync();
            }
            else { Toasts.Error(error ?? "Le contournement a échoué."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _overriding = false; }
    }

    private async Task ConfirmManualCheckOutAsync()
    {
        if (_pendingCheckOut is not { } v || _checkingOut) return;
        _checkingOut = true;
        try
        {
            if (await Api.ManualCheckOutAsync(v.VisitId))
            {
                Toasts.Success($"Sortie de « {v.VisitorName} » enregistrée.");
                _pendingCheckOut = null;
                await RefreshOnSiteAsync();
                await RefreshSummaryAsync();
            }
            else
            {
                // 409 le plus probable : la sûreté a mis un temps à confirmer
                // pendant qu'un scan réel clôturait déjà le cycle au poste.
                Toasts.Error("Ce visiteur n'est plus présent — la liste a été actualisée.");
                _pendingCheckOut = null;
                await RefreshOnSiteAsync();
            }
        }
        catch
        {
            // Panne réseau/API : ne jamais laisser l'exception atteindre
            // Blazor — un poste de supervision qui se déconnecte au milieu
            // d'une action de sûreté est le pire moment pour perdre la vue.
            Toasts.Error("Service indisponible, réessayez.");
        }
        finally { _checkingOut = false; }
    }

    // Mode « salle de supervision » (control-room plein écran) + horloge.
    private bool _wallMode;
    private DateTime _clock = DateTime.Now;
    private System.Threading.Timer? _clockTimer;

    private void ToggleWall()
    {
        _wallMode = !_wallMode;
        if (_wallMode)
        {
            _clock = DateTime.Now;
            _clockTimer = new System.Threading.Timer(_ =>
            {
                _clock = DateTime.Now;
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
        else
        {
            _clockTimer?.Dispose();
            _clockTimer = null;
        }
    }

    // ── Listes intelligentes : filtre du flux + tri des présents ──
    private string _feedFilter = "all";

    private static readonly (string Key, string Label)[] FeedFilters =
    {
        ("all", "Tous"), ("granted", "Entrées"), ("exit", "Sorties"),
        ("denied", "Refus"), ("security", "Sécurité"),
    };

    private static bool FeedMatches(ScanEventDto e, string key) => key switch
    {
        "granted"  => e.IsGranted && !e.IsCheckOut,
        "exit"     => e.IsCheckOut,
        "security" => e.IsSecurityEvent,
        "denied"   => !e.IsGranted && !e.IsCheckOut && !e.IsSecurityEvent,
        _          => true,
    };

    private int FeedCount(string key) => _feed.Count(e => FeedMatches(e, key));

    private IReadOnlyList<ScanEventDto> FilteredFeed =>
        _feedFilter == "all" ? _feed : _feed.Where(e => FeedMatches(e, _feedFilter)).ToList();

    // Présents : les dépassements les plus critiques remontent en tête.
    private IReadOnlyList<OnSiteVisitorDto> OnSiteRanked =>
        _onSite.OrderByDescending(v => v.OverstayLevel)
               .ThenByDescending(v => v.OverstayMinutes)
               .ThenBy(v => v.VisitorName)
               .ToList();

