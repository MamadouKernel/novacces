@page "/surete"
@implements IAsyncDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>NovAcces — Dashboard sûreté</PageTitle>

@if (!Auth.Initialized)
{
    <p class="muted" style="padding:2rem">Chargement…</p>
}
else if (CanViewDashboard)
{
<div class="portal">
    <header class="portal-header">
        <div>
            <h1>Dashboard sûreté</h1>
            <p class="muted">
                Site : <strong>@(Auth.SiteId ?? "—")</strong> ·
                <span class="dot @(_connected ? "dot-on" : "dot-off")"></span>
                @(_connected ? "Temps réel connecté" : "Hors ligne")
            </p>
            @if (Auth.IsInRole(NovAccesRoles.Hote))
            {
                <div class="nav-links"><a href="/hote">→ Portail hôte</a></div>
            }
        </div>
        <button class="btn-ghost" @onclick="SignOut">Se déconnecter</button>
    </header>

    @if (_summary is not null)
    {
        <div class="tiles">
            <div class="tile"><span class="tile-n">@_summary.ScansToday</span><span class="tile-l">Scans aujourd'hui</span></div>
            <div class="tile"><span class="tile-n">@_summary.EntriesGranted</span><span class="tile-l">Entrées</span></div>
            <div class="tile"><span class="tile-n">@_summary.Exits</span><span class="tile-l">Sorties</span></div>
            <div class="tile tile-warn"><span class="tile-n">@_summary.Denied</span><span class="tile-l">Refus</span></div>
            <div class="tile tile-alert"><span class="tile-n">@_summary.SecurityEvents</span><span class="tile-l">Événements sécu.</span></div>
            <div class="tile"><span class="tile-n">@_summary.OnSite</span><span class="tile-l">Présents</span></div>
        </div>
    }

    <div class="toolbar">
        <button class="btn-ghost" @onclick="ExportCsvAsync">⬇ Exporter le journal (CSV)</button>
    </div>

    @if (_overstayAlerts.Count > 0)
    {
        <div class="overstay-banner">
            @foreach (var a in _overstayAlerts)
            {
                <div class="overstay-item @(a.IsSecurityEvent ? "v-security" : "v-denied")">
                    ⏱ <strong>@a.VisitorName</strong> — dépassement +@a.OverstayMinutes min (niveau @a.Level)@(a.IsSecurityEvent ? " · ⚠ vérification physique recommandée" : "")
                </div>
            }
        </div>
    }

    <div class="grid">
        <section class="card">
            <h2>Flux des scans (temps réel)</h2>
            @if (_feed.Count == 0)
            {
                <p class="muted">En attente de scans… Un passage à un poste s'affichera ici instantanément.</p>
            }
            else
            {
                <ul class="feed">
                    @foreach (var e in _feed)
                    {
                        <li class="feed-item @VerdictClass(e)">
                            <span class="feed-time">@e.OccurredAt.LocalDateTime.ToString("HH:mm:ss")</span>
                            <span class="feed-name">@e.VisitorName</span>
                            <span class="feed-verdict">@Humanize(e)</span>
                            <span class="feed-agent">@e.AgentId</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card">
            <h2>Présents sur site (@_onSite.Count)</h2>
            @if (_onSite.Count == 0)
            {
                <p class="muted">Aucun visiteur actuellement sur site.</p>
            }
            else
            {
                <ul class="onsite">
                    @foreach (var v in _onSite)
                    {
                        <li>
                            <strong>@v.VisitorName</strong>
                            <span class="muted"> — @v.VisitorCompany</span>
                            @if (v.CheckedInAt is not null)
                            {
                                <span class="muted"> · entré à @v.CheckedInAt.Value.LocalDateTime.ToString("HH:mm")</span>
                            }
                            @if (v.OverstayMinutes > 0)
                            {
                                <span class="badge @(v.OverstayLevel >= 3 ? "badge-revoked" : "badge-expired")">
                                    ⏱ dépassement +@v.OverstayMinutes min@(v.OverstayLevel > 0 ? $" (niv. {v.OverstayLevel})" : "")
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    @if (Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Admin))
    {
        <section class="card" style="margin-top:1.2rem;">
            <h2>Liste d'exclusion (@_exclusions.Count)</h2>
            <p class="muted">Ces personnes se voient refuser toute nouvelle demande. Le motif reste interne à la sûreté.</p>
            <div class="row">
                <div class="field"><label>Nom</label><input @bind="_exclName" /></div>
                <div class="field"><label>Motif (interne)</label><input @bind="_exclReason" /></div>
            </div>
            <button class="btn-primary" @onclick="AddExclusionAsync" disabled="@_exclBusy" style="max-width:220px;">Ajouter à l'exclusion</button>

            @if (_exclusions.Count > 0)
            {
                <table class="visits" style="margin-top:1rem;">
                    <thead><tr><th>Nom</th><th>Motif</th><th>Ajouté par</th><th>Le</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in _exclusions)
                        {
                            <tr>
                                <td>@e.DisplayName</td>
                                <td class="muted">@e.Reason</td>
                                <td class="muted">@e.AddedBy</td>
                                <td class="muted">@e.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm")</td>
                                <td><button class="btn-danger" @onclick="() => RemoveExclusionAsync(e.Id)" disabled="@_exclBusy">Retirer</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>
}

@code {
    private readonly List<ScanEventDto> _feed = new();
    private IReadOnlyList<OnSiteVisitorDto> _onSite = Array.Empty<OnSiteVisitorDto>();
    private DashboardSummaryDto? _summary;
    private readonly List<OverstayAlertDto> _overstayAlerts = new();
    private IReadOnlyList<ExclusionDto> _exclusions = Array.Empty<ExclusionDto>();
    private string _exclName = "";
    private string _exclReason = "";
    private bool _exclBusy;
    private HubConnection? _hub;
    private bool _connected;
    private bool _loaded;

    private bool CanViewDashboard =>
        Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Hote) || Auth.IsInRole(NovAccesRoles.Admin);

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Auth.Initialized) return;

        if (!CanViewDashboard)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!_loaded)
        {
            _loaded = true;

            // État initial : synthèse + présents + amorçage du flux avec le journal récent.
            await RefreshSummaryAsync();
            await RefreshOnSiteAsync();
            var journal = await Api.GetJournalAsync(20);
            foreach (var j in journal)
                _feed.Add(new ScanEventDto(Guid.Empty, j.VisitorName, VerdictFrom(j), j.WasGranted, j.WasCheckOut, j.IsSecurityEvent, j.AgentId, j.Timestamp));

            await ConnectHubAsync();
            if (Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Admin))
                await RefreshExclusionsAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshExclusionsAsync()
    {
        try { _exclusions = await Api.GetExclusionsAsync(); } catch { /* best-effort */ }
    }

    private async Task AddExclusionAsync()
    {
        if (_exclBusy || string.IsNullOrWhiteSpace(_exclName) || string.IsNullOrWhiteSpace(_exclReason)) return;
        _exclBusy = true;
        try
        {
            if (await Api.AddExclusionAsync(_exclName.Trim(), _exclReason.Trim()))
            {
                _exclName = _exclReason = "";
                await RefreshExclusionsAsync();
            }
        }
        finally { _exclBusy = false; }
    }

    private async Task RemoveExclusionAsync(Guid id)
    {
        if (_exclBusy) return;
        _exclBusy = true;
        try
        {
            await Api.RemoveExclusionAsync(id);
            await RefreshExclusionsAsync();
        }
        finally { _exclBusy = false; }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task ConnectHubAsync()
    {
        var apiBase = Config["Api:BaseUrl"]!;
        var site = Auth.SiteId ?? "";

        _hub = new HubConnectionBuilder()
            .WithUrl($"{apiBase}/hubs/scan?site={Uri.EscapeDataString(site)}", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(Auth.AccessToken);

                // Dev : l'API expose un certificat auto-signé — accepté UNIQUEMENT
                // en développement (connexion serveur-à-serveur).
                if (Env.IsDevelopment())
                {
                    options.HttpMessageHandlerFactory = handler =>
                    {
                        if (handler is HttpClientHandler h)
                            h.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
                        return handler;
                    };
                    options.WebSocketConfiguration = conf =>
                        conf.RemoteCertificateValidationCallback = (_, _, _, _) => true;
                }
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ScanEventDto>("ScanRecorded", async scan =>
        {
            _feed.Insert(0, scan);
            if (_feed.Count > 50) _feed.RemoveRange(50, _feed.Count - 50);
            await RefreshOnSiteAsync();          // un scan change souvent les présents
            await RefreshSummaryAsync();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<OverstayAlertDto>("OverstayAlert", async alert =>
        {
            _overstayAlerts.Insert(0, alert);
            if (_overstayAlerts.Count > 6) _overstayAlerts.RemoveRange(6, _overstayAlerts.Count - 6);
            await RefreshOnSiteAsync();          // met à jour les badges de dépassement
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += _ => { _connected = true; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hub.StartAsync();
            _connected = true;
        }
        catch
        {
            _connected = false;
        }
    }

    private async Task RefreshOnSiteAsync()
    {
        try { _onSite = await Api.GetOnSiteAsync(); } catch { /* best-effort */ }
    }

    private async Task RefreshSummaryAsync()
    {
        try { _summary = await Api.GetSummaryAsync(); } catch { /* best-effort */ }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var csv = await Api.GetJournalCsvAsync();
            await JS.InvokeVoidAsync("novaccesDownload", $"journal-{DateTime.Now:yyyyMMdd-HHmm}.csv", csv);
        }
        catch { /* best-effort */ }
    }

    private static string VerdictFrom(ScanJournalEntryDto j) =>
        j switch
        {
            { WasCheckOut: true } => "CHECKED_OUT",
            { WasGranted: true } => "GRANTED",
            { IsSecurityEvent: true } => "SECURITY",
            _ => "DENIED"
        };

    private static string Humanize(ScanEventDto e) =>
        e switch
        {
            { IsCheckOut: true } => "Sortie",
            { IsGranted: true } => "Entrée autorisée",
            { IsSecurityEvent: true } => "⚠ Événement de sécurité",
            _ => "Refusé"
        };

    private static string VerdictClass(ScanEventDto e) =>
        e.IsSecurityEvent ? "v-security" : e.IsGranted ? "v-granted" : "v-denied";

    private void SignOut()
    {
        Auth.SignOut();
        Nav.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        Auth.Changed -= OnAuthChanged;
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
