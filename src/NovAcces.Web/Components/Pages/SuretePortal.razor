@page "/surete"
@implements IAsyncDisposable
@inject NovAccesApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject ToastService Toasts

<PageTitle>SigasAcces — Dashboard sûreté</PageTitle>

@if (!Auth.Initialized)
{
    <p class="muted" style="padding:2rem">Chargement…</p>
}
else if (CanViewDashboard)
{
<div class="portal">
    <header class="portal-header">
        <div>
            <h1>Dashboard sûreté</h1>
            <p class="muted">
                Site : <strong>@(Auth.SiteId ?? "—")</strong> ·
                <span class="dot @(_connected ? "dot-on" : "dot-off")"></span>
                @(_connected ? "Temps réel connecté" : "Hors ligne")
            </p>
            <p class="hint">Supervision en direct des postes : chaque scan apparaît dans le flux. Filtrez par type, surveillez les présents et les dépassements. Recherchez dans le journal, exportez-le en CSV.</p>
            @* Un compte peut cumuler Sûreté et Hôte : dans ce cas seulement, on
               propose le raccourci vers son portail de demandes. *@
            @if (Auth.IsInRole(NovAccesRoles.Hote))
            {
                <div class="nav-links"><a href="/hote">→ Portail hôte</a></div>
            }
        </div>
        <div class="flex flex-wrap items-center gap-2" style="align-self:start">
            <button class="btn-ghost" @onclick="ToggleDarkMode" title="Basculer le thème clair / sombre (mode nuit poste de garde)">
                @if (_darkMode)
                {
                    <span>☀️ Mode jour</span>
                }
                else
                {
                    <span>🌙 Mode nuit</span>
                }
            </button>
            <button class="btn-primary" style="max-width:230px" @onclick="ToggleWall">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                Mode supervision
            </button>
        </div>
    </header>

    @if (_wallMode)
    {
        <div class="wall">
            <div class="wall-top">
                <span class="wall-brand">SIGAS<span>ACCÈS</span></span>
                <span class="wall-title">Salle de supervision — @(Auth.SiteId ?? "—")</span>
                <span class="wall-status"><span class="dot @(_connected ? "dot-on" : "dot-off")"></span> @(_connected ? "temps réel" : "hors ligne")</span>
                <span class="wall-clock">@_clock.ToString("HH:mm:ss")</span>
                <button class="wall-exit" @onclick="ToggleWall">✕ Quitter</button>
            </div>

            @if (_summary is not null)
            {
                <div class="wall-kpis">
                    <div class="wk"><span class="wk-n">@_summary.ScansToday</span><span class="wk-l">Scans</span></div>
                    <div class="wk"><span class="wk-n">@_summary.EntriesGranted</span><span class="wk-l">Entrées</span></div>
                    <div class="wk"><span class="wk-n">@_summary.Exits</span><span class="wk-l">Sorties</span></div>
                    <div class="wk warn"><span class="wk-n">@_summary.Denied</span><span class="wk-l">Refus</span></div>
                    <div class="wk alert"><span class="wk-n">@_summary.SecurityEvents</span><span class="wk-l">Sécurité</span></div>
                    <div class="wk in"><span class="wk-n">@_summary.OnSite</span><span class="wk-l">Présents</span></div>
                </div>
            }

            <div class="wall-body">
                <div class="wall-panel">
                    <h3>Flux temps réel</h3>
                    <ul class="wall-feed">
                        @foreach (var e in _feed.Take(12))
                        {
                            <li class="feed-item @VerdictClass(e)">
                                <span class="feed-time">@e.OccurredAt.LocalDateTime.ToString("HH:mm:ss")</span>
                                <span class="feed-name">@e.VisitorName</span>
                                <span class="feed-verdict">@Humanize(e)</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="wall-panel">
                    @if (_summary?.HourlyScans is { Count: 24 } hrs && hrs.Sum() > 0)
                    {
                        var maxH = hrs.Max();
                        var nowH = DateTime.Now.Hour;
                        <h3>Affluence par heure</h3>
                        <div class="hchart" style="height:7rem;margin-bottom:1.2rem">
                            @for (var h = 0; h < 24; h++)
                            {
                                var v = hrs[h];
                                <div class="hbar @(v == maxH && v > 0 ? "peak" : "") @(h == nowH ? "now" : "")"
                                     style="height:@(maxH > 0 ? Math.Max(2, (int)Math.Round(v * 100.0 / maxH)) : 0)%"></div>
                            }
                        </div>
                    }
                    <h3>Présents (@_onSite.Count)</h3>
                    <ul class="wall-onsite">
                        @foreach (var v in OnSiteRanked.Take(8))
                        {
                            <li>
                                <strong>@v.VisitorName</strong>
                                @if (v.OverstayMinutes > 0)
                                {
                                    <span class="badge @(v.OverstayLevel >= 3 ? "badge-revoked" : "badge-pending")">+@v.OverstayMinutes min</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    @if (_summary is not null)
    {
        <div class="tiles">
            <div class="tile"><span class="tile-n">@_summary.ScansToday</span><span class="tile-l">Scans aujourd'hui</span></div>
            <div class="tile"><span class="tile-n">@_summary.EntriesGranted</span><span class="tile-l">Entrées</span></div>
            <div class="tile"><span class="tile-n">@_summary.Exits</span><span class="tile-l">Sorties</span></div>
            <div class="tile tile-warn"><span class="tile-n">@_summary.Denied</span><span class="tile-l">Refus</span></div>
            <div class="tile tile-alert"><span class="tile-n">@_summary.SecurityEvents</span><span class="tile-l">Événements sécu.</span></div>
            <div class="tile"><span class="tile-n">@_summary.OnSite</span><span class="tile-l">Présents</span></div>
        </div>
        <p class="synthese">
            Taux de refus : <strong>@_summary.RefusalAppreciation</strong>@(_summary.PeakHour is int h ? $" · pic d'affluence vers {h}h" : "")
            — @_summary.Recommendation
        </p>

        @if (_summary.HourlyScans is { Count: 24 } hours && hours.Sum() > 0)
        {
            var maxH = hours.Max();
            var nowH = DateTime.Now.Hour;
            <section class="card" style="margin-bottom:1rem;">
                <h2>Affluence par heure (aujourd'hui)</h2>
                <div class="hchart">
                    @for (var hr = 0; hr < 24; hr++)
                    {
                        var val = hours[hr];
                        var peak = val == maxH && val > 0;
                        <div class="hbar @(peak ? "peak" : "") @(hr == nowH ? "now" : "")"
                             style="height:@(maxH > 0 ? Math.Max(2, (int)Math.Round(val * 100.0 / maxH)) : 0)%"
                             title="@hr h — @val scan(s)"></div>
                    }
                </div>
                <div class="hchart-axis"><span>0 h</span><span>6 h</span><span>12 h</span><span>18 h</span><span>23 h</span></div>
            </section>
        }
    }

    <div class="toolbar">
        <input class="search" placeholder="Rechercher dans le journal (nom, agent, détail)…"
               @bind="_searchTerm" @bind:event="oninput"
               @onkeydown="@(e => { if (e.Key == "Enter") _ = SearchJournalAsync(); })" />
        <button class="btn-ghost" @onclick="SearchJournalAsync">Rechercher</button>
        @if (_searchResults is not null)
        {
            <button class="btn-ghost" @onclick="ClearSearch">Effacer</button>
        }
        <button class="btn-ghost" @onclick="ExportCsvAsync">⬇ Exporter le journal (CSV)</button>
    </div>

    @if (_searchResults is not null)
    {
        <section class="card" style="margin-bottom:1rem;">
            <h2>Résultats de recherche</h2>
            <div class="table-wrap table-cards">
            <table class="visits">
                <thead><tr><th>Heure</th><th>Visiteur</th><th>Agent</th><th>Accès</th><th>Créé par</th><th>Détail</th></tr></thead>
                <tbody>
                    @foreach (var r in _searchResults)
                    {
                        <tr class="@(r.IsSecurityEvent ? "row-security" : "")">
                            <td class="muted" data-label="Heure">@r.Timestamp.LocalDateTime.ToString("dd/MM HH:mm:ss")</td>
                            <td data-label="Visiteur">@r.VisitorName</td>
                            <td class="muted" data-label="Agent">@r.AgentId</td>
                            <td class="muted" data-label="Accès">@AuthMethodLabel(r.AuthMethod)</td>
                            <td class="muted" data-label="Créé par">@(r.CreatedByDisplayName ?? "—")</td>
                            <td class="muted" data-label="Détail" style="white-space:normal">@r.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_searchPage" PageSize="_searchPageSize" TotalCount="_searchTotal"
                        OnPageChanged="ChangeSearchPageAsync" />
        </section>
    }

    <section class="card" style="margin-bottom:1rem;">
        <h2>Toutes les demandes du site (@_visitsTotal)</h2>
        <p class="hint">Chaque demande créée sur le site, quel que soit son statut — y compris celles jamais scannées — avec l'hôte qui l'a invitée.</p>
        <div class="toolbar">
            <input class="search" placeholder="Rechercher (visiteur, société, motif)…"
                   @bind="_visitsSearchTerm" @bind:event="oninput"
                   @onkeydown="@(e => { if (e.Key == "Enter") _ = SearchVisitsAsync(); })" />
            <button class="btn-ghost" @onclick="SearchVisitsAsync">Rechercher</button>
            @if (!string.IsNullOrWhiteSpace(_visitsSearchTerm))
            {
                <button class="btn-ghost" @onclick="ClearVisitsSearchAsync">Effacer</button>
            }
        </div>

        @if (_visits.Count == 0)
        {
            <div class="empty">@EmptyIcon()<p>Aucune demande ne correspond.</p></div>
        }
        else
        {
            <div class="table-wrap table-cards">
            <table class="visits">
                <thead><tr><th>Visiteur</th><th>Société</th><th>Motif</th><th>Mode</th><th>Rendez-vous</th><th>Statut</th><th>Créé par</th><th>Créé le</th><th>Entrée</th><th>Sortie</th><th>Exclusion</th></tr></thead>
                <tbody>
                    @foreach (var v in _visits)
                    {
                        <tr class="@(v.MatchesExclusionList ? "row-security" : "")">
                            <td data-label="Visiteur">
                                <button class="btn-ghost" style="padding:0;font:inherit;text-decoration:underline;" @onclick="() => _historyVisitId = v.VisitId">@v.VisitorName</button>
                            </td>
                            <td class="muted" data-label="Société">@v.VisitorCompany</td>
                            <td class="muted" data-label="Motif" style="white-space:normal">@v.Motif</td>
                            <td class="muted" data-label="Mode">@(v.Mode == "Unique" ? "Passage unique" : "30 jours")</td>
                            <td class="muted" data-label="Rendez-vous">
                                @(v.ScheduledAt is { } sch ? sch.LocalDateTime.ToString("dd/MM/yyyy HH:mm") : "—")
                                @if (v.Mode == "Unique")
                                {
                                    <div style="font-size:.75rem;">durée prévue @v.PlannedDurationMinutes min</div>
                                }
                            </td>
                            <td data-label="Statut"><span class="badge @VisitStatusBadgeClass(v.Status)">@VisitStatusLabel(v.Status)</span></td>
                            <td data-label="Créé par">
                                @v.CreatedByDisplayName
                                @if (!string.IsNullOrWhiteSpace(v.CreatedByEmail))
                                {
                                    <div class="muted" style="font-size:.75rem;">@v.CreatedByEmail</div>
                                }
                            </td>
                            <td class="muted" data-label="Créé le">@v.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="muted" data-label="Entrée">@(v.CheckedInAt is { } ci ? ci.LocalDateTime.ToString("dd/MM HH:mm") : "—")</td>
                            <td class="muted" data-label="Sortie">@(v.CheckedOutAt is { } co ? co.LocalDateTime.ToString("dd/MM HH:mm") : "—")</td>
                            <td data-label="Exclusion">
                                @if (v.MatchesExclusionList)
                                {
                                    <span class="badge badge-revoked" title="Le nom de ce visiteur correspond à la liste d'exclusion du site — un scan serait refusé.">⚠ Exclu</span>
                                    @if (!v.IsOnSite)
                                    {
                                        <button class="btn-ghost" style="padding:.15rem .5rem;font-size:.72rem;display:block;margin-top:.25rem;white-space:nowrap;"
                                                @onclick="() => _pendingOverride = v">Autoriser quand même</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <Pagination Page="_visitsPage" PageSize="_visitsPageSize" TotalCount="_visitsTotal"
                        OnPageChanged="ChangeVisitsPageAsync" />
        }
    </section>

    @if (_overstayAlerts.Count > 0)
    {
        <div class="overstay-banner">
            @foreach (var a in _overstayAlerts)
            {
                <div class="overstay-item @(a.IsSecurityEvent ? "v-security" : "v-denied")">
                    ⏱ <strong>@a.VisitorName</strong> — dépassement +@a.OverstayMinutes min (niveau @a.Level)@(a.IsSecurityEvent ? " · ⚠ vérification physique recommandée" : "")
                </div>
            }
        </div>
    }

    @if (_pendingConfirmations.Count > 0)
    {
        <section class="card" style="margin-bottom:1rem;border-color:var(--brand-amber, #F5A300);">
            <h2>Demandes de confirmation en attente (@_pendingConfirmations.Count)</h2>
            <p class="hint">Un agent a désigné un visiteur attendu sans QR ni code de secours — sans réponse de votre part sous 15 minutes, la demande expire et équivaut à un refus.</p>
            <ul class="onsite">
                @foreach (var r in _pendingConfirmations)
                {
                    <li class="flex flex-wrap items-center gap-x-1.5">
                        <strong>@r.VisitorName</strong>
                        <span class="muted"> — @(r.Direction == "Entry" ? "entrée" : "sortie")@(string.IsNullOrWhiteSpace(r.CheckpointId) ? "" : $" · poste {r.CheckpointId}")</span>
                        <span class="muted"> · agent @r.AgentId</span>
                        <span class="muted"> · expire à @r.ExpiresAt.LocalDateTime.ToString("HH:mm:ss")</span>
                        <div class="flex gap-1.5" style="margin-left:auto">
                            <button class="btn-danger" style="padding:.15rem .6rem;font-size:.75rem" disabled="@_confirmationBusy"
                                    @onclick="() => DenyConfirmationAsync(r.Id)">Refuser</button>
                            <button class="btn-primary" style="padding:.15rem .6rem;font-size:.75rem;max-width:8rem" disabled="@_confirmationBusy"
                                    @onclick="() => ApproveConfirmationAsync(r.Id)">Confirmer</button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }

    <div class="cards">
        <section class="card">
            <h2>Flux des scans (temps réel)</h2>
            @if (_feed.Count == 0)
            {
                <div class="empty">
                    @EmptyIcon()
                    <p>En attente de scans…</p>
                    <p class="hint">Un passage à un poste s'affichera ici instantanément.</p>
                </div>
            }
            else
            {
                <div class="filters" style="margin-bottom:.75rem;">
                    @foreach (var f in FeedFilters)
                    {
                        <button class="filter @(_feedFilter == f.Key ? "on" : "")"
                                @onclick="() => _feedFilter = f.Key">
                            @f.Label <span class="count">@FeedCount(f.Key)</span>
                        </button>
                    }
                </div>

                var feedRows = FilteredFeed;
                if (feedRows.Count == 0)
                {
                    <div class="empty">@EmptyIcon()<p>Aucun scan de ce type pour l'instant.</p></div>
                }
                else
                {
                    <ul class="feed">
                        @foreach (var e in feedRows)
                        {
                            <li class="feed-item @VerdictClass(e) @(e.OccurredAt == _latestScanAt ? "feed-item-new" : "")">
                                <span class="feed-time">@e.OccurredAt.LocalDateTime.ToString("HH:mm:ss")</span>
                                <span class="feed-name">@e.VisitorName</span>
                                <span class="feed-verdict">@Humanize(e)</span>
                                <span class="feed-agent">@e.AgentId</span>
                            </li>
                        }
                    </ul>
                }
            }
        </section>

        <section class="card">
            <h2>Présents sur site (@_onSite.Count)</h2>
            @if (_onSite.Count == 0)
            {
                <div class="empty">@EmptyIcon()<p>Aucun visiteur actuellement sur site.</p></div>
            }
            else
            {
                <ul class="onsite">
                    @foreach (var v in OnSiteRanked)
                    {
                        <li class="flex flex-wrap items-center gap-x-1.5">
                            <strong>@v.VisitorName</strong>
                            <span class="muted"> — @v.VisitorCompany</span>
                            @if (v.CheckedInAt is not null)
                            {
                                <span class="muted"> · entré à @v.CheckedInAt.Value.LocalDateTime.ToString("HH:mm")</span>
                            }
                            @if (v.OverstayMinutes > 0)
                            {
                                <span class="badge @(v.OverstayLevel >= 3 ? "badge-revoked" : "badge-expired")">
                                    ⏱ dépassement +@v.OverstayMinutes min@(v.OverstayLevel > 0 ? $" (niv. {v.OverstayLevel})" : "")
                                </span>
                            }
                            else if (IsApproachingOverstay(v))
                            {
                                <span class="badge badge-pending" title="Durée prévue atteinte dans @MinutesUntilOverstay(v) min">
                                    ⏳ bientôt en dépassement (@MinutesUntilOverstay(v) min)
                                </span>
                            }
                            <div class="flex gap-1.5" style="margin-left:auto">
                                <button class="btn-ghost" style="padding:.15rem .5rem;font-size:.75rem"
                                        @onclick="() => _historyVisitId = v.VisitId">Historique</button>
                                @* §7 : le visiteur a pu repartir sans scanner (téléphone
                                   déchargé, autre accès) — sans cette action, il reste
                                   « présent » et en dépassement indéfiniment. *@
                                <button class="btn-ghost" style="padding:.15rem .5rem;font-size:.75rem"
                                        @onclick="() => _pendingCheckOut = v">Sortie manuelle</button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    @if (Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Admin))
    {
        <section class="card" style="margin-top:1.2rem;">
            <h2>Liste d'exclusion (@_exclusions.Count)</h2>
            <p class="muted">Ces personnes se voient refuser toute nouvelle demande. Le motif reste interne à la sûreté.</p>
            <p class="hint">
                L'email est optionnel : sans lui, l'exclusion vise tout le monde portant ce nom (filet large). Si vous
                le connaissez, il précise l'exclusion pour ne viser QUE cette personne — utile en cas d'homonyme.
            </p>
            <div class="row">
                <div class="field"><label>Nom</label><input @bind="_exclName" /></div>
                <div class="field"><label>Email (optionnel, précise l'exclusion)</label><input @bind="_exclEmail" placeholder="ex. jean.dupont@exemple.com" /></div>
                <div class="field"><label>Motif (interne)</label><input @bind="_exclReason" /></div>
            </div>
            <button class="btn-primary" @onclick="AddExclusionAsync" disabled="@_exclBusy" style="max-width:220px;">Ajouter à l'exclusion</button>

            @if (_exclusions.Count > 0)
            {
                <div class="table-wrap table-cards" style="margin-top:1rem;">
                <table class="visits">
                    <thead><tr><th>Nom</th><th>Email</th><th>Motif</th><th>Ajouté par</th><th>Le</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in PagedExclusions)
                        {
                            <tr>
                                <td data-label="Nom">@e.DisplayName</td>
                                <td class="muted" data-label="Email">
                                    @if (string.IsNullOrWhiteSpace(e.Email))
                                    {
                                        <span title="Aucun email : vise tout le monde portant ce nom.">— (filet large)</span>
                                    }
                                    else
                                    {
                                        @e.Email
                                    }
                                </td>
                                <td class="muted" data-label="Motif">@e.Reason</td>
                                <td class="muted" data-label="Ajouté par">@e.AddedBy</td>
                                <td class="muted" data-label="Le">@e.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm")</td>
                                <td data-label="Action"><button class="btn-danger" @onclick="() => RemoveExclusionAsync(e.Id)" disabled="@_exclBusy">Retirer</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <Pagination Page="_exclusionsPage" PageSize="_exclusionsPageSize" TotalCount="_exclusions.Count"
                            OnPageChanged="p => _exclusionsPage = p" />
            }
        </section>
    }

    @if (_historyVisitId is { } hid)
    {
        <VisitHistory VisitId="hid" OnClose="() => _historyVisitId = null" />
    }

    @if (_pendingCheckOut is { } pco)
    {
        <div class="overlay" @onclick="() => _pendingCheckOut = null">
            <div class="modal" style="max-width:26rem" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <div><h2>Enregistrer la sortie ?</h2></div>
                </div>
                <div class="modal-b">
                    <p><strong>@pco.VisitorName</strong> sera marqué sorti sans avoir scanné au poste.</p>
                    <p class="hint">À utiliser uniquement si vous avez constaté son départ (téléphone déchargé, autre accès, oubli). L'action est journalisée et tracée à votre compte.</p>
                </div>
                <div class="modal-f">
                    <button class="btn-ghost" @onclick="() => _pendingCheckOut = null">Annuler</button>
                    <button class="btn-primary" style="max-width:200px" @onclick="ConfirmManualCheckOutAsync" disabled="@_checkingOut">
                        @(_checkingOut ? "Enregistrement…" : "Oui, il est sorti")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_pendingOverride is { } po)
    {
        <div class="overlay" @onclick="CancelOverride">
            <div class="modal" style="max-width:28rem" @onclick:stopPropagation="true">
                <div class="modal-h">
                    <div><h2>Autoriser malgré l'exclusion ?</h2></div>
                </div>
                <div class="modal-b">
                    <p><strong>@po.VisitorName</strong> correspond à un nom de la liste d'exclusion du site.</p>
                    <p class="hint">
                        À utiliser uniquement après vérification d'identité (pièce d'identité) confirmant qu'il ne
                        s'agit PAS de la personne réellement exclue — cas d'un homonyme. L'action est journalisée et
                        tracée à votre compte, et reste soumise aux autres règles (fenêtre de validité, anti-rejeu).
                    </p>
                    <div class="field">
                        <label>Justification (obligatoire)</label>
                        <input @bind="_overrideJustification" @bind:event="oninput"
                               placeholder="ex. pièce d'identité vérifiée, homonyme confirmé" />
                    </div>
                </div>
                <div class="modal-f">
                    <button class="btn-ghost" @onclick="CancelOverride">Annuler</button>
                    <button class="btn-primary" style="max-width:220px" @onclick="ConfirmExclusionOverrideAsync"
                            disabled="@(_overriding || string.IsNullOrWhiteSpace(_overrideJustification))">
                        @(_overriding ? "Traitement…" : "Oui, autoriser l'entrée")
                    </button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    private readonly List<ScanEventDto> _feed = new();
    private IReadOnlyList<OnSiteVisitorDto> _onSite = Array.Empty<OnSiteVisitorDto>();
    private DashboardSummaryDto? _summary;
