    // Le dashboard expose le journal de TOUS les visiteurs du site : réservé à
    // la Sûreté et l'Admin, comme la policy SecurityJournal côté API. Le rôle
    // Hôte en est exclu (moindre privilège §8.5) — il dispose de son propre
    // portail, limité à ses demandes. Délégué à NovAccesAuthorizationMatrix
    // (Shared) pour rester au même endroit que le reste de la matrice de
    // rôles plutôt que redéfini ici (audit du 05/08/2026, finding F3).
    private bool CanViewDashboard => NovAccesAuthorizationMatrix.CanViewSecurityJournal(Auth.Roles);

    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Auth.Initialized) return;

        if (!CanViewDashboard)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!_loaded)
        {
            _loaded = true;

            // État initial : synthèse + présents + amorçage du flux avec le journal récent.
            // Chaque appel est best-effort (comme RefreshSummaryAsync/RefreshOnSiteAsync) :
            // une panne ponctuelle de l'API ne doit JAMAIS faire tomber tout le circuit
            // Blazor. Une exception non rattrapée ici est fatale — elle déconnecte le
            // poste de supervision entier, précisément le moment où la sûreté en a le
            // plus besoin, pour un simple aléa réseau qui se serait résolu tout seul.
            await RefreshSummaryAsync();
            await RefreshOnSiteAsync();
            await SeedFeedFromJournalAsync();
            await RefreshPendingConfirmationsAsync();
            await ChangeVisitsPageAsync(1);

            await ConnectHubAsync();
            await SubscribeToPushAsync();
            if (Auth.IsInRole(NovAccesRoles.Surete) || Auth.IsInRole(NovAccesRoles.Admin))
                await RefreshExclusionsAsync();
            StateHasChanged();
        }
    }

    private async Task SeedFeedFromJournalAsync()
    {
        try
        {
            var journal = await Api.GetJournalAsync(20);
            foreach (var j in journal)
                _feed.Add(new ScanEventDto(Guid.Empty, j.VisitorName, VerdictFrom(j), j.WasGranted, j.WasCheckOut, j.IsSecurityEvent, j.AgentId, j.Timestamp));
        }
        catch
        {
            // Best-effort : le flux démarre vide, le temps réel (ConnectHubAsync,
            // appelé juste après) continuera de l'alimenter normalement.
        }
    }

    private async Task RefreshExclusionsAsync()
    {
        try { _exclusions = await Api.GetExclusionsAsync(); } catch { /* best-effort */ }
    }

    private async Task AddExclusionAsync()
    {
        if (_exclBusy || string.IsNullOrWhiteSpace(_exclName) || string.IsNullOrWhiteSpace(_exclReason)) return;
        _exclBusy = true;
        try
        {
            var email = string.IsNullOrWhiteSpace(_exclEmail) ? null : _exclEmail.Trim();
            if (await Api.AddExclusionAsync(_exclName.Trim(), _exclReason.Trim(), email))
            {
                Toasts.Success($"« {_exclName.Trim()} » ajouté à la liste d'exclusion.");
                _exclName = _exclEmail = _exclReason = "";
                await RefreshExclusionsAsync();
            }
            else { Toasts.Error("Ajout à l'exclusion refusé."); }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _exclBusy = false; }
    }

    private async Task RemoveExclusionAsync(Guid id)
    {
        if (_exclBusy) return;
        _exclBusy = true;
        try
        {
            // Le résultat DOIT déterminer le message : lever une exclusion est
            // une décision de sûreté (moindre privilège, §8.5) — annoncer un
            // retrait qui n'a pas eu lieu laisserait croire qu'une personne
            // écartée peut de nouveau être invitée.
            if (await Api.RemoveExclusionAsync(id))
            {
                Toasts.Info("Personne retirée de la liste d'exclusion.");
                await RefreshExclusionsAsync();
            }
            else
            {
                Toasts.Error("Le retrait a échoué — réessayez.");
            }
        }
        catch { Toasts.Error("Service indisponible, réessayez."); }
        finally { _exclBusy = false; }
    }

